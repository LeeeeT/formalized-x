def cmm.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, -M: String, +X: String, +E: String, -q: String, +ns: String, +v: String, -q1: String, +x: String, -q2: String,
  +es: {String.append(M, String.append(X, E)) == s : String}, +es2: {String.append(q, String.append(ns, v)) == M : String}, +es3: {String.append(q1, String.append(x, q2)) == q : String},
  +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}, +hns: {tokb(':', ns) == True{} : Bool},
  +r1: Raw, +u1: String, +e1: {pvc(MV{}, skip_ws(v)) == Some{PR{r1, u1}} : Maybe<&2, PR>}, +w1: {wsall(u1) == True{} : Bool},
  +rO: Raw, +uO: String, +eO: {pvc(MO{}, skip_ws(String.append(X, E))) == Some{PR{rO, uO}} : Maybe<&2, PR>}, +wO: {wsall(uO) == True{} : Bool}) -> CR(CMM{}, s):
  %es : CR(CMM{}, _)
  %es2 : CR(CMM{}, String.append(_, String.append(X, E)))
  %es3 : CR(CMM{}, String.append(String.append(_, String.append(ns, v)), String.append(X, E)))
  %Equal.sym(String, q1, SCon{'"', SNil{}}, eq1) : CR(CMM{}, String.append(String.append(String.append(_, String.append(x, q2)), String.append(ns, v)), String.append(X, E)))
  %Equal.sym(String, q2, SCon{'"', SNil{}}, eq2) : CR(CMM{}, SCon{'"', String.append(String.append(String.append(x, _), String.append(ns, v)), String.append(X, E))})
  %Equal.sym(String, String.append(String.append(String.append(x, SCon{'"', SNil{}}), String.append(ns, v)), String.append(X, E)), String.append(x, SCon{'"', String.append(ns, String.append(v, String.append(X, E)))}), memAssoc.go(x, ns, v, String.append(X, E))) : CR(CMM{}, SCon{'"', _})
  (ocons1(x, r1, rO), uO, cmm.eq(gl, hg, x, ns, v, String.append(X, E), hx, hns, r1, u1, e1, w1, rO, uO, eO, wO), wO)

def cmm.d2(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, -M: String, +X: String, +E: String, -q: String, +ns: String, +v: String, -q1: String, +x: String, -q2: String,
  +es: {String.append(M, String.append(X, E)) == s : String}, +es2: {String.append(q, String.append(ns, v)) == M : String}, +es3: {String.append(q1, String.append(x, q2)) == q : String},
  +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}, +hns: {tokb(':', ns) == True{} : Bool},
  +r1: Raw, +u1: String, +e1: {pvc(MV{}, skip_ws(v)) == Some{PR{r1, u1}} : Maybe<&2, PR>}, +w1: {wsall(u1) == True{} : Bool}, IHO: CRO(String.append(X, E))) -> CR(CMM{}, s):
  (rO, uO, eO, wO) = IHO
  cmm.go(gl, hg, s, M, X, E, q, ns, v, q1, x, q2, es, es2, es3, eq1, eq2, hx, hns, r1, u1, e1, w1, rO, uO, eO, wO)

def cmm.d1(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, -M: String, +X: String, +E: String, -q: String, +ns: String, +v: String, -q1: String, +x: String, -q2: String,
  +es: {String.append(M, String.append(X, E)) == s : String}, +es2: {String.append(q, String.append(ns, v)) == M : String}, +es3: {String.append(q1, String.append(x, q2)) == q : String},
  +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}, +hns: {tokb(':', ns) == True{} : Bool},
  IHV: CR(CV{}, v), IHO: CRO(String.append(X, E))) -> CR(CMM{}, s):
  (r1, u1, e1, w1) = IHV
  cmm.d2(gl, hg, s, M, X, E, q, ns, v, q1, x, q2, es, es2, es3, eq1, eq2, hx, hns, r1, u1, e1, w1, IHO)

# A member and what follows it, given its value and the rest.
def cmm(+gl: GL, +hg: {gl == GRAMMAR : GL}, +d1: Nat, +m: Nat, +s: String, h: CH(gl, hg, CMM{}, 1n+d1, m, s), ihV: @y: String -> CH(gl, hg, CV{}, d1, 0n, y) -> CR(CV{}, y),
  ihO: @z: String -> {ABNF.check.era(ABNF.limit(1n+d1, toList(gl)), ABNF.seq([ABNF.rep.exactly(m, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object")]), z) == True{} : Bool} -> CRO(z)) -> CR(CMM{}, s):
  seqE3(CR(CMM{}, s), ABNF.limit(1n+d1, toList(gl)), ABNF.ref("member"), ABNF.rep.exactly(m, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object"), s, h, +M => +X => +E => +es => +hM => +hX => +hE =>
    seqE3(CR(CMM{}, s), ABNF.limit(d1, toList(gl)), ABNF.ref("string"), ABNF.ref("name-separator"), ABNF.ref("value"), M, tt.sym(ABNF.check.era(ABNF.limit(1n+d1, toList(gl)), ABNF.ref("member"), M), ABNF.check.era(ABNF.limit(d1, toList(gl)), ABNF.seq([ABNF.ref("string"), ABNF.ref("name-separator"), ABNF.ref("value")]), M), refL(gl, hg, d1, "member", ABNF.seq([ABNF.ref("string"), ABNF.ref("name-separator"), ABNF.ref("value")]), M, {==}), hM), +q => +ns => +v => +es2 => +hq => +hns => +hv =>
      seqE3(CR(CMM{}, s), ABNF.full(toList(gl)), ABNF.ref("quotation-mark"), ABNF.rep.any(ABNF.ref("char")), ABNF.ref("quotation-mark"), q, MBe(gl, hg, "string", ABNF.seq([ABNF.ref("quotation-mark"), ABNF.rep.any(ABNF.ref("char")), ABNF.ref("quotation-mark")]), q, {==}, toBK(gl, hg, d1, ABNF.ref("string"), q, hq)), +q1 => +x => +q2 => +es3 => +h1 => +h2 => +h3 =>
        cmm.d1(gl, hg, s, M, X, E, q, ns, v, q1, x, q2, es, es2, es3, charIs(ABNF.full(toList(gl)), '"', q1, MBe(gl, hg, "quotation-mark", ABNF.char('"'), q1, {==}, h1)), charIs(ABNF.full(toList(gl)), '"', q2, MBe(gl, hg, "quotation-mark", ABNF.char('"'), q2, {==}, h3)), h2,
          tokE(gl, hg, "name-separator", ':', ns, {==}, {==}, toBK(gl, hg, d1, ABNF.ref("name-separator"), ns, hns)),
          ihV(v, hv), ihO(String.append(X, E), seqI2(ABNF.limit(1n+d1, toList(gl)), ABNF.rep.exactly(m, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object"), X, E, hX, hE))))))

def moZ.eq(+E: String, +hE: {tokb('}', E) == True{} : Bool}) -> {pvc(MO{}, skip_ws(E)) == Some{PR{RObj{[]}, str_tl(skip_ws(E))}} : Maybe<&2, PR>}:
  %Equal.sym(String, skip_ws(E), SCon{'}', str_tl(skip_ws(E))}, tokU0('}', E, hE)) : {pv(1n+String.length(_), MO{}, _) == Some{PR{RObj{[]}, str_tl(skip_ws(E))}} : Maybe<&2, PR>}
  {==}

def moZ.go(-s: String, -a: String, +E: String, +es: {String.append(a, E) == s : String}, +ha: {a == SNil{} : String}, +hE: {tokb('}', E) == True{} : Bool}) -> CRO(s):
  %es : CRO(_)
  %Equal.sym(String, a, SNil{}, ha) : CRO(String.append(_, E))
  (RObj{[]}, str_tl(skip_ws(E)), moZ.eq(E, hE), tokW('}', E, hE))

# The end of an object.
def moZ(+gl: GL, +hg: {gl == GRAMMAR : GL}, +d: Nat, +s: String, h: {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.seq([ABNF.rep.exactly(0n, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object")]), s) == True{} : Bool}) -> CRO(s):
  seqE2(CRO(s), ABNF.limit(d, toList(gl)), ABNF.rep.exactly(0n, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object"), s, h, +a => +E => +es => +ha => +hE =>
    moZ.go(s, a, E, es, emptyE(ABNF.limit(d, toList(gl)), a, exZe(ABNF.limit(d, toList(gl)), ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")]), a, ha)), tokE(gl, hg, "end-object", '}', E, {==}, {==}, toBK(gl, hg, d, ABNF.ref("end-object"), E, hE))))

def moS.eq(+gl: GL, +hg: {gl == GRAMMAR : GL}, +vs: String, +mem: String, +X2: String, +E: String, +hvs: {tokb(',', vs) == True{} : Bool},
  -r: Raw, +u: String, +eM: {pvc(MM{}, skip_ws(String.append(mem, String.append(X2, E)))) == Some{PR{r, u}} : Maybe<&2, PR>}, +w: {wsall(u) == True{} : Bool})
