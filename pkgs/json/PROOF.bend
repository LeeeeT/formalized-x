def eMM.v2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +g: Nat, +t0: String, +q: SP, +eq1: {String.append(spa(q), SCon{'"', spt(q)}) == t0 : String}, +hk: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), spa(q)) == True{} : Bool}, +x: Char, +w: String, +eu: {skip_ws(spt(q)) == SCon{x, w} : String}, +hx: {Char.is_eq(':', x) == True{} : Bool},
  +p1: PR, +e1: {pv(g, MV{}, skip_ws(w)) == Some{p1} : Maybe<&2, PR>}, E1: @t: String -> @f2: Nat -> {fol(String.append(prt(p1), t)) == True{} : Bool} -> {le(g, f2) == True{} : Bool} -> {pv(f2, MV{}, String.append(skip_ws(w), t)) == Some{PR{prr(p1), String.append(prt(p1), t)}} : Maybe<&2, PR>}, r2: Maybe<&2, PR>, +e2: {pv(g, MO{}, skip_ws(prt(p1))) == r2 : Maybe<&2, PR>}, E2: EXT(MO{}, r2, skip_ws(prt(p1)), g))
  -> EXT(MM{}, ocons(spa(q), prr(p1), r2), SCon{'"', t0}, 1n+g):
  match r2:
    case None{}:
      Unit{}
    case Some{+p2}:
      +t => f2 => +hf => +hl => eMM.fin(gl, hg, g, t0, q, eq1, hk, x, w, eu, hx, p1, e1, E1, p2, e2, E2, t, f2, hf, hl)

def eMM.v(+gl: GL, +hg: {gl == GRAMMAR : GL}, +g: Nat, +t0: String, +q: SP, +eq1: {String.append(spa(q), SCon{'"', spt(q)}) == t0 : String}, +hk: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), spa(q)) == True{} : Bool}, +x: Char, +w: String, +eu: {skip_ws(spt(q)) == SCon{x, w} : String}, +hx: {Char.is_eq(':', x) == True{} : Bool},
  r1: Maybe<&2, PR>, +e1: {pv(g, MV{}, skip_ws(w)) == r1 : Maybe<&2, PR>}, E1: EXT(MV{}, r1, skip_ws(w), g), xO: @w: String -> EXT(MO{}, pv(g, MO{}, w), w, g)) -> EXT(MM{}, Maybe.bind(&2, PR, PR, r1, +p => ocons(spa(q), prr(p), pv(g, MO{}, skip_ws(prt(p))))), SCon{'"', t0}, 1n+g):
