def ci0(+k: ABNF.Book, +lo: Char, +up: Char) -> {ABNF.check.era(k, ABNF.seq([ABNF.alt([ABNF.char(lo), ABNF.char(up)]), ABNF.empty]), SNil{}) == False{} : Bool}:
