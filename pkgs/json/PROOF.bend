  r2: Maybe<&2, PR>, ps2: PSR(gl, hg, ABNF.seq([ABNF.rep.any(ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("value")])), ABNF.ref("end-array")]), r2, skip_ws(prt(p1)))) -> PSR(gl, hg, ABNF.seq([ABNF.seq([ABNF.ref("value"), ABNF.rep.any(ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("value")]))]), ABNF.ref("end-array")]), acons(prr(p1), r2), v0):
