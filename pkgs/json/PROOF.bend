# Strings
# =======

def STR(st: SS) -> ABNF.Rule:
  match st:
    case SN{}:
      ABNF.rep.any(ABNF.ref("char"))
    case SE{}:
      ABNF.seq([ABNF.alt([ABNF.char('"'), ABNF.char('\\'), ABNF.char('/'), ABNF.char('b'), ABNF.char('f'), ABNF.char('n'), ABNF.char('r'), ABNF.char('t'), ABNF.seq([ABNF.char('u'), ABNF.rep.exactly(4n, ABNF.core.hexdig)])]), ABNF.rep.any(ABNF.ref("char"))])
    case SH{n}:
      ABNF.seq([ABNF.rep.exactly(1n+n, ABNF.core.hexdig), ABNF.rep.any(ABNF.ref("char"))])

# SNS(m, s, R): if the scan m of s succeeds, s is its text, a quote, and the rest.
def SNS(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, s: String, R: ABNF.Rule) -> Type:
  match m:
    case None{}:
      Unit
    case Some{p}:
      {String.append(spa(p), SCon{'"', spt(p)}) == s : String} & {ABNF.check.era(ABNF.full(toList(gl)), R, spa(p)) == True{} : Bool}

def SNSmap(+gl: GL, +hg: {gl == GRAMMAR : GL}, +c: Char, m: Maybe<&2, SP>, -t: String, -R2: ABNF.Rule, -R: ABNF.Rule, ns: SNS(gl, hg, m, t, R2), f: @a: String -> {ABNF.check.era(ABNF.full(toList(gl)), R2, a) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), R, SCon{c, a}) == True{} : Bool})
  -> SNS(gl, hg, prepM(c, m), SCon{c, t}, R):
  match m:
    case None{}:
      Unit{}
    case Some{SP{+part_a, +part_t}}:
      (e, h) = ns
      (cons_eq(c, String.append(spa(SP{part_a, part_t}), SCon{'"', spt(SP{part_a, part_t})}), t, e), chkTr(ABNF.full(toList(gl)), R, SCon{c, spa(SP{part_a, part_t})}, spa(SP{SCon{c, spa(SP{part_a, part_t})}, spt(SP{part_a, part_t})}), {==}, f(spa(SP{part_a, part_t}), h)))

