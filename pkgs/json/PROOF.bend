def nfrac2S(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, -s: String, ns: NS(gl, hg, m, s, ABNF.rep.at_least(1n, ABNF.core.digit))) -> NS(gl, hg, nfrac2(m), s, ABNF.seq([ABNF.rep.at_least(1n, ABNF.core.digit), ABNF.opt(ABNF.ref("exp"))])):
  match m:
    case None{}:
      Unit{}
