# What num_scan reads is a number.
def numS(+gl: GL, +hg: {gl == GRAMMAR : GL}, s: String) -> NS(gl, hg, num_scan(s), s, ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))])):
