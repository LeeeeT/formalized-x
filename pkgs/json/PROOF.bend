  %Equal.sym(String, i, SCon{'0', SNil{}}, ei) : {nint(String.append(_, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(_, String.append(f1, e1)), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nfrac(String.append(f1, String.append(e1, t))), Some{SP{String.append(f1, e1), t}}, nfracC(gl, hg, f1, e1, t, hf, he, ht)) : {prepM('0', _) == Some{SP{SCon{'0', String.append(f1, e1)}, t}} : Maybe<&2, SP>}
  {==}

def nintC.nz(+gl: GL, +hg: {gl == GRAMMAR : GL}, +c: Char, -x: String, +d: String, -i: String, +f1: String, +e1: String, +t: String, +e: {String.append(x, d) == i : String}, +ec: {SCon{c, SNil{}} == x : String}, +hc: {is19(c) == True{} : Bool},
  +hd: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.core.digit), d) == True{} : Bool}, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {nint(String.append(i, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(i, String.append(f1, e1)), t}} : Maybe<&2, SP>}:
  %e : {nint(String.append(_, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(_, String.append(f1, e1)), t}} : Maybe<&2, SP>}
  %ec : {nint(String.append(String.append(_, d), String.append(f1, String.append(e1, t)))) == Some{SP{String.append(String.append(_, d), String.append(f1, e1)), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nint(SCon{c, String.append(d, String.append(f1, String.append(e1, t)))}), sel(Maybe<&2, SP>, is19(c), u => prepM(c, nint2(digits(String.append(d, String.append(f1, String.append(e1, t)))))), u => None{}),
    selF(Maybe<&2, SP>, Char.is_eq('0', c), u => prepM(c, nfrac(String.append(d, String.append(f1, String.append(e1, t))))), u => sel(Maybe<&2, SP>, is19(c), u => prepM(c, nint2(digits(String.append(d, String.append(f1, String.append(e1, t)))))), u => None{}), contraEq('0', c, z => is19(z), hc, {==}))) : {_ == Some{SP{SCon{c, String.append(d, String.append(f1, e1))}, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, sel(Maybe<&2, SP>, is19(c), u => prepM(c, nint2(digits(String.append(d, String.append(f1, String.append(e1, t)))))), u => None{}), prepM(c, nint2(digits(String.append(d, String.append(f1, String.append(e1, t)))))),
    selT(Maybe<&2, SP>, is19(c), u => prepM(c, nint2(digits(String.append(d, String.append(f1, String.append(e1, t)))))), u => None{}, hc)) : {_ == Some{SP{SCon{c, String.append(d, String.append(f1, e1))}, t}} : Maybe<&2, SP>}
  %Equal.sym(SP, digits(String.append(d, String.append(f1, String.append(e1, t)))), SP{d, String.append(f1, String.append(e1, t))}, digC(gl, hg, d, String.append(f1, String.append(e1, t)), hd, ndF(gl, hg, f1, e1, t, hf, he, ht))) : {prepM(c, nint2(_)) == Some{SP{SCon{c, String.append(d, String.append(f1, e1))}, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nfrac(String.append(f1, String.append(e1, t))), Some{SP{String.append(f1, e1), t}}, nfracC(gl, hg, f1, e1, t, hf, he, ht)) : {prepM(c, appM(d, _)) == Some{SP{SCon{c, String.append(d, String.append(f1, e1))}, t}} : Maybe<&2, SP>}
  {==}

def nintC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +i: String, +f1: String, +e1: String, +t: String, +hi: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("int"), i) == True{} : Bool}, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {nint(String.append(i, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(i, String.append(f1, e1)), t}} : Maybe<&2, SP>}:
  either(&2, &2, {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("zero"), i) == True{} : Bool}, {ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i) == True{} : Bool}, {nint(String.append(i, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(i, String.append(f1, e1)), t}} : Maybe<&2, SP>},
    or_elim(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("zero"), i), ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i),
      tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("zero"), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i), Bool.or(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("zero"), i), ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i)), ABNF.alt.con(ABNF.full(toList(gl)), i, ABNF.ref("zero"), [ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), MBe(gl, hg, "int", ABNF.alt([ABNF.ref("zero"), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i, {==}, hi))),
    +hz => nintC.z(gl, hg, i, f1, e1, t, charIs(ABNF.full(toList(gl)), '0', i, MBe(gl, hg, "zero", ABNF.char('0'), i, {==}, hz)), hf, he, ht),
    +hn => seqE2({nint(String.append(i, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(i, String.append(f1, e1)), t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit), i,
      tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i), ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)]), i), altS(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)]), i), hn),
      +x => +d => +e => +hx => +hd =>
        one({nint(String.append(i, String.append(f1, String.append(e1, t)))) == Some{SP{String.append(i, String.append(f1, e1)), t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.range('1', '9'), x, MBe(gl, hg, "digit1-9", ABNF.range('1', '9'), x, {==}, hx), rg0(ABNF.full(toList(gl)), '1', '9'), z1 => z2 => z3 => rg2(ABNF.full(toList(gl)), '1', '9', z1, z2, z3), +c => +ec => +hc =>
          nintC.nz(gl, hg, c, x, d, i, f1, e1, t, e, ec, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.range('1', '9'), SCon{c, SNil{}}), inR('1', '9', c), rg1(ABNF.full(toList(gl)), '1', '9', c), hc), hd, hf, he, ht))))

def assoc4(+a: String, +b: String, +c: String, +d: String, +t: String) -> {String.append(String.append(a, String.append(b, String.append(c, d))), t) == String.append(a, String.append(b, String.append(c, String.append(d, t)))) : String}:
  Equal.trans(String, String.append(String.append(a, String.append(b, String.append(c, d))), t), String.append(a, String.append(String.append(b, String.append(c, d)), t)), String.append(a, String.append(b, String.append(c, String.append(d, t)))),
    app3(a, String.append(b, String.append(c, d)), t),
    app_congl(a, String.append(String.append(b, String.append(c, d)), t), String.append(b, String.append(c, String.append(d, t))),
      Equal.trans(String, String.append(String.append(b, String.append(c, d)), t), String.append(b, String.append(String.append(c, d), t)), String.append(b, String.append(c, String.append(d, t))),
        app3(b, String.append(c, d), t), app_congl(b, String.append(String.append(c, d), t), String.append(c, String.append(d, t)), app3(c, d, t)))))

def numNM(X: String, +h: {notminus(X) == True{} : Bool}) -> {num_scan(X) == nint(X) : Maybe<&2, SP>}:
  match X:
    case SNil{}:
      {==}
    case SCon{+c, +r}:
      selF(Maybe<&2, SP>, Char.is_eq('-', c), u => prepM(c, nint(r)), u => nint(SCon{c, r}), not_tf(Char.is_eq('-', c), h))

def intNM.z(-i: String, -R: String, +ei: {i == SCon{'0', SNil{}} : String}) -> {notminus(String.append(i, R)) == True{} : Bool}:
  %Equal.sym(String, i, SCon{'0', SNil{}}, ei) : {notminus(String.append(_, R)) == True{} : Bool}
  {==}

def intNM.nz(+c: Char, -x: String, -d: String, -i: String, -R: String, +e: {String.append(x, d) == i : String}, +ec: {SCon{c, SNil{}} == x : String}, +hc: {is19(c) == True{} : Bool}) -> {notminus(String.append(i, R)) == True{} : Bool}:
  %e : {notminus(String.append(_, R)) == True{} : Bool}
  %ec : {notminus(String.append(String.append(_, d), R)) == True{} : Bool}
  not_ft(Char.is_eq('-', c), contraEq('-', c, z => is19(z), hc, {==}))

# An int does not start with a minus.
def intNM(+gl: GL, +hg: {gl == GRAMMAR : GL}, +i: String, +R: String, +hi: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("int"), i) == True{} : Bool}) -> {notminus(String.append(i, R)) == True{} : Bool}:
  either(&2, &2, {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("zero"), i) == True{} : Bool}, {ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i) == True{} : Bool}, {notminus(String.append(i, R)) == True{} : Bool},
    or_elim(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("zero"), i), ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i),
      tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("zero"), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i), Bool.or(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("zero"), i), ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i)), ABNF.alt.con(ABNF.full(toList(gl)), i, ABNF.ref("zero"), [ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), MBe(gl, hg, "int", ABNF.alt([ABNF.ref("zero"), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i, {==}, hi))),
    +hz => intNM.z(i, R, charIs(ABNF.full(toList(gl)), '0', i, MBe(gl, hg, "zero", ABNF.char('0'), i, {==}, hz))),
    +hn => seqE2({notminus(String.append(i, R)) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit), i,
      tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)])]), i), ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)]), i), altS(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("digit1-9"), ABNF.rep.any(ABNF.core.digit)]), i), hn),
      +x => +d => +e => +hx => +hd =>
        one({notminus(String.append(i, R)) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.range('1', '9'), x, MBe(gl, hg, "digit1-9", ABNF.range('1', '9'), x, {==}, hx), rg0(ABNF.full(toList(gl)), '1', '9'), z1 => z2 => z3 => rg2(ABNF.full(toList(gl)), '1', '9', z1, z2, z3), +c => +ec => +hc =>
          intNM.nz(c, x, d, i, R, e, ec, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.range('1', '9'), SCon{c, SNil{}}), inR('1', '9', c), rg1(ABNF.full(toList(gl)), '1', '9', c), hc)))))

def numC.n(+gl: GL, +hg: {gl == GRAMMAR : GL}, -m1: String, +i: String, +f1: String, +e1: String, +t: String, +hn: {m1 == SNil{} : String}, +hi: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("int"), i) == True{} : Bool}, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {num_scan(String.append(m1, String.append(i, String.append(f1, String.append(e1, t))))) == Some{SP{String.append(m1, String.append(i, String.append(f1, e1))), t}} : Maybe<&2, SP>}:
  %Equal.sym(String, m1, SNil{}, hn) : {num_scan(String.append(_, String.append(i, String.append(f1, String.append(e1, t))))) == Some{SP{String.append(_, String.append(i, String.append(f1, e1))), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, num_scan(String.append(i, String.append(f1, String.append(e1, t)))), nint(String.append(i, String.append(f1, String.append(e1, t)))), numNM(String.append(i, String.append(f1, String.append(e1, t))), intNM(gl, hg, i, String.append(f1, String.append(e1, t)), hi))) : {_ == Some{SP{String.append(i, String.append(f1, e1)), t}} : Maybe<&2, SP>}
  nintC(gl, hg, i, f1, e1, t, hi, hf, he, ht)

def numC.m(+gl: GL, +hg: {gl == GRAMMAR : GL}, -m1: String, +i: String, +f1: String, +e1: String, +t: String, +em: {m1 == SCon{'-', SNil{}} : String}, +hi: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("int"), i) == True{} : Bool}, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {num_scan(String.append(m1, String.append(i, String.append(f1, String.append(e1, t))))) == Some{SP{String.append(m1, String.append(i, String.append(f1, e1))), t}} : Maybe<&2, SP>}:
  %Equal.sym(String, m1, SCon{'-', SNil{}}, em) : {num_scan(String.append(_, String.append(i, String.append(f1, String.append(e1, t))))) == Some{SP{String.append(_, String.append(i, String.append(f1, e1))), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nint(String.append(i, String.append(f1, String.append(e1, t)))), Some{SP{String.append(i, String.append(f1, e1)), t}}, nintC(gl, hg, i, f1, e1, t, hi, hf, he, ht)) : {prepM('-', _) == Some{SP{SCon{'-', String.append(i, String.append(f1, e1))}, t}} : Maybe<&2, SP>}
  {==}

def numC.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +m1: String, +i: String, +f1: String, +e1: String, -n: String, +t: String, +e: {String.append(m1, String.append(i, String.append(f1, e1))) == n : String},
  +hm: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("minus")), m1) == True{} : Bool}, +hi: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("int"), i) == True{} : Bool}, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {num_scan(String.append(n, t)) == Some{SP{n, t}} : Maybe<&2, SP>}:
  %e : {num_scan(String.append(_, t)) == Some{SP{_, t}} : Maybe<&2, SP>}
  %Equal.sym(String, String.append(String.append(m1, String.append(i, String.append(f1, e1))), t), String.append(m1, String.append(i, String.append(f1, String.append(e1, t)))), assoc4(m1, i, f1, e1, t)) : {num_scan(_) == Some{SP{String.append(m1, String.append(i, String.append(f1, e1))), t}} : Maybe<&2, SP>}
  optE({num_scan(String.append(m1, String.append(i, String.append(f1, String.append(e1, t))))) == Some{SP{String.append(m1, String.append(i, String.append(f1, e1))), t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.ref("minus"), m1, hm,
    +hn => numC.n(gl, hg, m1, i, f1, e1, t, hn, hi, hf, he, ht),
    +hs => numC.m(gl, hg, m1, i, f1, e1, t, charIs(ABNF.full(toList(gl)), '-', m1, MBe(gl, hg, "minus", ABNF.char('-'), m1, {==}, hs)), hi, hf, he, ht))

# A number followed by what may follow a value is read whole.
def numC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +n: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), n) == True{} : Bool}, +ht: {fol(t) == True{} : Bool}) -> {num_scan(String.append(n, t)) == Some{SP{n, t}} : Maybe<&2, SP>}:
  seqE4({num_scan(String.append(n, t)) == Some{SP{n, t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp")), n, h,
    +m1 => +i => +f1 => +e1 => +e => +hm => +hi => +hf => +he => numC.go(gl, hg, m1, i, f1, e1, n, t, e, hm, hi, hf, he, ht))

# Parser soundness
# ================

def TM(m: Md) -> ABNF.Rule:
  match m:
    case MV{}:
      ABNF.ref("value")
    case MA{}:
      ABNF.seq([ABNF.rep.any(ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("value")])), ABNF.ref("end-array")])
    case MM{}:
      ABNF.seq([ABNF.ref("member"), ABNF.rep.any(ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object")])
    case MO{}:
      ABNF.seq([ABNF.rep.any(ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object")])

# PSR(R, res, s): if res is a success, it read some y off s, y matches R, and what it built is valid.
def PSR(+gl: GL, +hg: {gl == GRAMMAR : GL}, R: ABNF.Rule, res: Maybe<&2, PR>, s: String) -> Type:
  match res:
    case None{}:
      Unit
    case Some{p}:
      &y: String -> {String.append(y, prt(p)) == s : String} & {ABNF.check.era(ABNF.full(toList(gl)), R, y) == True{} : Bool} & {wf(prr(p)) == True{} : Bool}

def val_false(+gl: GL, +hg: {gl == GRAMMAR : GL}, +y: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("false"), y) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("value"), y) == True{} : Bool}:
  MBi(gl, hg, "value", ABNF.alt([ABNF.ref("false"), ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")]), y, {==}, altL(ABNF.full(toList(gl)), ABNF.ref("false"), [ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, h))

def val_null(+gl: GL, +hg: {gl == GRAMMAR : GL}, +y: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("null"), y) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("value"), y) == True{} : Bool}:
  MBi(gl, hg, "value", ABNF.alt([ABNF.ref("false"), ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")]), y, {==}, altR(ABNF.full(toList(gl)), ABNF.ref("false"), [ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, altL(ABNF.full(toList(gl)), ABNF.ref("null"), [ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, h)))

def val_true(+gl: GL, +hg: {gl == GRAMMAR : GL}, +y: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("true"), y) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("value"), y) == True{} : Bool}:
  MBi(gl, hg, "value", ABNF.alt([ABNF.ref("false"), ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")]), y, {==}, altR(ABNF.full(toList(gl)), ABNF.ref("false"), [ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, altR(ABNF.full(toList(gl)), ABNF.ref("null"), [ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, altL(ABNF.full(toList(gl)), ABNF.ref("true"), [ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, h))))

def val_object(+gl: GL, +hg: {gl == GRAMMAR : GL}, +y: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("object"), y) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("value"), y) == True{} : Bool}:
  MBi(gl, hg, "value", ABNF.alt([ABNF.ref("false"), ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")]), y, {==}, altR(ABNF.full(toList(gl)), ABNF.ref("false"), [ABNF.ref("null"), ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, altR(ABNF.full(toList(gl)), ABNF.ref("null"), [ABNF.ref("true"), ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, altR(ABNF.full(toList(gl)), ABNF.ref("true"), [ABNF.ref("object"), ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, altL(ABNF.full(toList(gl)), ABNF.ref("object"), [ABNF.ref("array"), ABNF.ref("number"), ABNF.ref("string")], y, h)))))

