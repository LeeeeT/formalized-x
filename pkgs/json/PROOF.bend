        Equal.sym(Maybe<V>, F.RS(prepM(c, str_scan(t2, SN{})), acc, DU{SCon{x1, SCon{x2, SCon{x3, SNil{}}}}}, p, d), F.RS(str_scan(t2, SN{}), F.rev(SCon{x1, SCon{x2, SCon{x3, SCon{c, SNil{}}}}}, SCon{'u', SCon{'\\', F.emitA(p, acc)}}), DN{}, None{}, d),
