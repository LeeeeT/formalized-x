# =======
# Dumping
# =======

# A text is written between quotation marks, with its quotation marks,
# backslashes and control characters escaped.
def nth(s: String, m: Nat) -> Char:
  match s:
    case SNil{}:
      '0'
    case SCon{c, t}:
      match m:
        case 0n:
          c
        case 1n+p:
          nth(t, p)

def hd1(+n: Nat) -> Char:
  sel(Char, le(16n, n), u => '1', u => '0')

def hd2(+n: Nat) -> Char:
  sel(Char, le(16n, n), u => nth("0123456789abcdef", Nat.sub(n, 16n)), u => nth("0123456789abcdef", n))

# \u00XY for the control character with code n.
def ctlS(+n: Nat, E: String) -> String:
  SCon{'\\', SCon{'u', SCon{'0', SCon{'0', SCon{hd1(n), SCon{hd2(n), E}}}}}}

def enc1(+c: Char, b1: Bool, b2: Bool, b3: Bool, E: String) -> String:
  match b1:
    case True{}:
      SCon{'\\', SCon{'"', E}}
    case False{}:
      match b2:
        case True{}:
          SCon{'\\', SCon{'\\', E}}
        case False{}:
          match b3:
            case True{}:
              SCon{c, E}
            case False{}:
              ctlS(nv(c), E)

def encC(+c: Char, E: String) -> String:
  enc1(c, Char.is_eq('"', c), Char.is_eq('\\', c), isunesc(c), E)

# enc2(d, Q): the escaped characters of d, then Q.
def enc2(d: String, Q: String) -> String:
  match d:
    case SNil{}:
      Q
    case SCon{+c, t}:
      encC(c, enc2(t, Q))

def eqn_refl(a: Nat) -> {eqn(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      eqn_refl(p)

def natChar.e(+c: Char, +k: Nat, +en: {nv(c) == k : Nat}, +x: Char, +ex: {nv(x) == k : Nat}) -> {eqn(nv(x), nv(c)) == True{} : Bool}:
  %Equal.sym(Nat, nv(c), k, en) : {eqn(nv(x), _) == True{} : Bool}
  %Equal.sym(Nat, nv(x), k, ex) : {eqn(_, k) == True{} : Bool}
  eqn_refl(k)

def natChar(+c: Char, +k: Nat, +en: {nv(c) == k : Nat}, +x: Char, +ex: {nv(x) == k : Nat}) -> {x == c : Char}:
  char_eq(x, c, Equal.trans(Bool, Char.is_eq(x, c), eqn(nv(x), nv(c)), True{}, ch_eq(x, c), natChar.e(c, k, en, x, ex)))

def leFlip(a: Nat, b: Nat, +h: {le(1n+a, b) == False{} : Bool}) -> {le(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({le(1n+q, 0n) == True{} : Bool}, false_ne_true(Equal.sym(Bool, True{}, False{}, h)))
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      leFlip(p, q, h)

def leNe(a: Nat, b: Nat, +h1: {le(a, 1n+b) == True{} : Bool}, +h2: {eqn(1n+b, a) == False{} : Bool}) -> {le(a, b) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      match p:
        case 0n:
          match b:
            case 0n:
              Empty.absurd({le(1n, 0n) == True{} : Bool}, false_ne_true(Equal.sym(Bool, True{}, False{}, h2)))
            case 1n+q:
              {==}
        case 1n+pp:
          match b:
            case 0n:
              Empty.absurd({le(1n+1n+pp, 0n) == True{} : Bool}, false_ne_true(h1))
            case 1n+q:
              leNe(1n+pp, q, h1, h2)

def andF_l(a: Bool, -b: Bool, +h: {Bool.and(a, b) == False{} : Bool}, +hb: {b == True{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case False{}:
      {==}
    case True{}:
      tf({True{} == False{} : Bool}, b, hb, h)

def inRle(+lo: Char, +hi: Char, +c: Char, +h: {inR(lo, hi, c) == False{} : Bool}) -> {Bool.and(le(nv(lo), nv(c)), le(nv(c), nv(hi))) == False{} : Bool}:
  %ch_le(lo, c) : {Bool.and(_, le(nv(c), nv(hi))) == False{} : Bool}
  %ch_le(c, hi) : {Bool.and(U32.is_le(Char.to_u32(lo), Char.to_u32(c)), _) == False{} : Bool}
  h

# A Unicode character that needs escaping and isn't a quotation mark or a
# backslash is a control character.
def lenCtl(+c: Char, +e1: {Char.is_eq('"', c) == False{} : Bool}, +e2: {Char.is_eq('\\', c) == False{} : Bool}, +e3: {isunesc(c) == False{} : Bool}, +hu: {U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool})
  -> {le(nv(c), 31n) == True{} : Bool}:
  leFlip(31n, nv(c), andF_l(le(nv(Chr{32}), nv(c)), le(nv(c), nv(Chr{33})), inRle(Chr{32}, Chr{33}, c, or_false_l(inR(Chr{32}, Chr{33}, c), Bool.or(inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{})), e3)),
    leNe(nv(c), 33n, leFlip(34n, nv(c), andF_l(le(nv(Chr{35}), nv(c)), le(nv(c), nv(Chr{91})), inRle(Chr{35}, Chr{91}, c, or_false_l(inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{}), or_false_r(inR(Chr{32}, Chr{33}, c), Bool.or(inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{})), e3))),
      leNe(nv(c), 91n, leFlip(92n, nv(c), Equal.trans(Bool, le(nv(Chr{93}), nv(c)), U32.is_le(Char.to_u32(Chr{93}), Char.to_u32(c)), False{}, Equal.sym(Bool, U32.is_le(Char.to_u32(Chr{93}), Char.to_u32(c)), le(nv(Chr{93}), nv(c)), ch_le(Chr{93}, c)),
        andF_l(U32.is_le(Char.to_u32(Chr{93}), Char.to_u32(c)), U32.is_le(Char.to_u32(c), Char.to_u32(Chr{1114111})), or_false_l(inR(Chr{93}, Chr{1114111}, c), False{}, or_false_r(inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{}), or_false_r(inR(Chr{32}, Chr{33}, c), Bool.or(inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{})), e3))), hu))),
        Equal.trans(Bool, eqn(nv('\\'), nv(c)), Char.is_eq('\\', c), False{}, Equal.sym(Bool, Char.is_eq('\\', c), eqn(nv('\\'), nv(c)), ch_eq('\\', c)), e2)))),
      Equal.trans(Bool, eqn(nv('"'), nv(c)), Char.is_eq('"', c), False{}, Equal.sym(Bool, Char.is_eq('"', c), eqn(nv('"'), nv(c)), ch_eq('"', c)), e1))))

# The escape of a control character decodes to it.
def ctlDec(n: Nat, +hn: {le(n, 31n) == True{} : Bool}, +c: Char, +en: {nv(c) == n : Nat}, -E: String) -> {dec(ctlS(n, E), DN{}, None{}) == SCon{c, dec(E, DN{}, None{})} : String}:
  match n:
    case 0n:
      %natChar(c, 0n, en, Chr{0}, {==}) : {dec(ctlS(0n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
      {==}
    case 1n+n1:
      match n1:
        case 0n:
          %natChar(c, 1n, en, Chr{1}, {==}) : {dec(ctlS(1n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
          {==}
        case 1n+n2:
          match n2:
            case 0n:
              %natChar(c, 2n, en, Chr{2}, {==}) : {dec(ctlS(2n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
              {==}
            case 1n+n3:
              match n3:
                case 0n:
                  %natChar(c, 3n, en, Chr{3}, {==}) : {dec(ctlS(3n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                  {==}
                case 1n+n4:
                  match n4:
                    case 0n:
                      %natChar(c, 4n, en, Chr{4}, {==}) : {dec(ctlS(4n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                      {==}
                    case 1n+n5:
                      match n5:
                        case 0n:
                          %natChar(c, 5n, en, Chr{5}, {==}) : {dec(ctlS(5n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                          {==}
                        case 1n+n6:
                          match n6:
                            case 0n:
                              %natChar(c, 6n, en, Chr{6}, {==}) : {dec(ctlS(6n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                              {==}
                            case 1n+n7:
                              match n7:
                                case 0n:
                                  %natChar(c, 7n, en, Chr{7}, {==}) : {dec(ctlS(7n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                  {==}
                                case 1n+n8:
                                  match n8:
                                    case 0n:
                                      %natChar(c, 8n, en, Chr{8}, {==}) : {dec(ctlS(8n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                      {==}
                                    case 1n+n9:
                                      match n9:
                                        case 0n:
                                          %natChar(c, 9n, en, Chr{9}, {==}) : {dec(ctlS(9n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                          {==}
                                        case 1n+n10:
                                          match n10:
                                            case 0n:
                                              %natChar(c, 10n, en, Chr{10}, {==}) : {dec(ctlS(10n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                              {==}
                                            case 1n+n11:
                                              match n11:
                                                case 0n:
                                                  %natChar(c, 11n, en, Chr{11}, {==}) : {dec(ctlS(11n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                  {==}
                                                case 1n+n12:
                                                  match n12:
                                                    case 0n:
                                                      %natChar(c, 12n, en, Chr{12}, {==}) : {dec(ctlS(12n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                      {==}
                                                    case 1n+n13:
                                                      match n13:
                                                        case 0n:
                                                          %natChar(c, 13n, en, Chr{13}, {==}) : {dec(ctlS(13n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                          {==}
                                                        case 1n+n14:
                                                          match n14:
                                                            case 0n:
                                                              %natChar(c, 14n, en, Chr{14}, {==}) : {dec(ctlS(14n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                              {==}
                                                            case 1n+n15:
                                                              match n15:
                                                                case 0n:
                                                                  %natChar(c, 15n, en, Chr{15}, {==}) : {dec(ctlS(15n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                  {==}
                                                                case 1n+n16:
                                                                  match n16:
                                                                    case 0n:
                                                                      %natChar(c, 16n, en, Chr{16}, {==}) : {dec(ctlS(16n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                      {==}
                                                                    case 1n+n17:
                                                                      match n17:
                                                                        case 0n:
                                                                          %natChar(c, 17n, en, Chr{17}, {==}) : {dec(ctlS(17n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                          {==}
                                                                        case 1n+n18:
                                                                          match n18:
                                                                            case 0n:
                                                                              %natChar(c, 18n, en, Chr{18}, {==}) : {dec(ctlS(18n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                              {==}
                                                                            case 1n+n19:
                                                                              match n19:
                                                                                case 0n:
                                                                                  %natChar(c, 19n, en, Chr{19}, {==}) : {dec(ctlS(19n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                  {==}
                                                                                case 1n+n20:
                                                                                  match n20:
                                                                                    case 0n:
                                                                                      %natChar(c, 20n, en, Chr{20}, {==}) : {dec(ctlS(20n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                      {==}
                                                                                    case 1n+n21:
                                                                                      match n21:
                                                                                        case 0n:
                                                                                          %natChar(c, 21n, en, Chr{21}, {==}) : {dec(ctlS(21n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                          {==}
                                                                                        case 1n+n22:
                                                                                          match n22:
                                                                                            case 0n:
                                                                                              %natChar(c, 22n, en, Chr{22}, {==}) : {dec(ctlS(22n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                              {==}
                                                                                            case 1n+n23:
                                                                                              match n23:
                                                                                                case 0n:
                                                                                                  %natChar(c, 23n, en, Chr{23}, {==}) : {dec(ctlS(23n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                  {==}
                                                                                                case 1n+n24:
                                                                                                  match n24:
                                                                                                    case 0n:
                                                                                                      %natChar(c, 24n, en, Chr{24}, {==}) : {dec(ctlS(24n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                      {==}
                                                                                                    case 1n+n25:
                                                                                                      match n25:
                                                                                                        case 0n:
                                                                                                          %natChar(c, 25n, en, Chr{25}, {==}) : {dec(ctlS(25n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                          {==}
                                                                                                        case 1n+n26:
                                                                                                          match n26:
                                                                                                            case 0n:
                                                                                                              %natChar(c, 26n, en, Chr{26}, {==}) : {dec(ctlS(26n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                              {==}
                                                                                                            case 1n+n27:
                                                                                                              match n27:
                                                                                                                case 0n:
                                                                                                                  %natChar(c, 27n, en, Chr{27}, {==}) : {dec(ctlS(27n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                                  {==}
                                                                                                                case 1n+n28:
                                                                                                                  match n28:
                                                                                                                    case 0n:
                                                                                                                      %natChar(c, 28n, en, Chr{28}, {==}) : {dec(ctlS(28n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                                      {==}
                                                                                                                    case 1n+n29:
                                                                                                                      match n29:
                                                                                                                        case 0n:
                                                                                                                          %natChar(c, 29n, en, Chr{29}, {==}) : {dec(ctlS(29n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                                          {==}
                                                                                                                        case 1n+n30:
                                                                                                                          match n30:
                                                                                                                            case 0n:
                                                                                                                              %natChar(c, 30n, en, Chr{30}, {==}) : {dec(ctlS(30n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                                              {==}
                                                                                                                            case 1n+n31:
                                                                                                                              match n31:
                                                                                                                                case 0n:
                                                                                                                                  %natChar(c, 31n, en, Chr{31}, {==}) : {dec(ctlS(31n, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
                                                                                                                                  {==}
                                                                                                                                case 1n+n32:
                                                                                                                                  Empty.absurd({dec(ctlS(1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+n32, E), DN{}, None{}) == SCon{c, dec(E, DN{}, None{})} : String}, false_ne_true(hn))

def prepAll(a: String, m: Maybe<&2, SP>) -> Maybe<&2, SP>:
  match a:
    case SNil{}:
      m
    case SCon{+c, t}:
      prepM(c, prepAll(t, m))

# The escape of a control character scans as itself.
def ctlScan(n: Nat, +hn: {le(n, 31n) == True{} : Bool}, -E: String) -> {str_scan(ctlS(n, E), SN{}) == prepAll(ctlS(n, SNil{}), str_scan(E, SN{})) : Maybe<&2, SP>}:
  match n:
    case 0n:
      {==}
    case 1n+n1:
      match n1:
        case 0n:
          {==}
        case 1n+n2:
          match n2:
            case 0n:
              {==}
            case 1n+n3:
              match n3:
                case 0n:
                  {==}
                case 1n+n4:
                  match n4:
                    case 0n:
                      {==}
                    case 1n+n5:
                      match n5:
                        case 0n:
                          {==}
                        case 1n+n6:
                          match n6:
                            case 0n:
                              {==}
                            case 1n+n7:
                              match n7:
                                case 0n:
                                  {==}
                                case 1n+n8:
                                  match n8:
                                    case 0n:
                                      {==}
                                    case 1n+n9:
                                      match n9:
                                        case 0n:
                                          {==}
                                        case 1n+n10:
                                          match n10:
                                            case 0n:
                                              {==}
                                            case 1n+n11:
                                              match n11:
                                                case 0n:
                                                  {==}
                                                case 1n+n12:
                                                  match n12:
                                                    case 0n:
                                                      {==}
                                                    case 1n+n13:
                                                      match n13:
                                                        case 0n:
                                                          {==}
                                                        case 1n+n14:
                                                          match n14:
                                                            case 0n:
                                                              {==}
                                                            case 1n+n15:
                                                              match n15:
                                                                case 0n:
                                                                  {==}
                                                                case 1n+n16:
                                                                  match n16:
                                                                    case 0n:
                                                                      {==}
                                                                    case 1n+n17:
                                                                      match n17:
                                                                        case 0n:
                                                                          {==}
                                                                        case 1n+n18:
                                                                          match n18:
                                                                            case 0n:
                                                                              {==}
                                                                            case 1n+n19:
                                                                              match n19:
                                                                                case 0n:
                                                                                  {==}
                                                                                case 1n+n20:
                                                                                  match n20:
                                                                                    case 0n:
                                                                                      {==}
                                                                                    case 1n+n21:
                                                                                      match n21:
                                                                                        case 0n:
                                                                                          {==}
                                                                                        case 1n+n22:
                                                                                          match n22:
                                                                                            case 0n:
                                                                                              {==}
                                                                                            case 1n+n23:
                                                                                              match n23:
                                                                                                case 0n:
                                                                                                  {==}
                                                                                                case 1n+n24:
                                                                                                  match n24:
                                                                                                    case 0n:
                                                                                                      {==}
                                                                                                    case 1n+n25:
                                                                                                      match n25:
                                                                                                        case 0n:
                                                                                                          {==}
                                                                                                        case 1n+n26:
                                                                                                          match n26:
                                                                                                            case 0n:
                                                                                                              {==}
                                                                                                            case 1n+n27:
                                                                                                              match n27:
                                                                                                                case 0n:
                                                                                                                  {==}
                                                                                                                case 1n+n28:
                                                                                                                  match n28:
                                                                                                                    case 0n:
                                                                                                                      {==}
                                                                                                                    case 1n+n29:
                                                                                                                      match n29:
                                                                                                                        case 0n:
                                                                                                                          {==}
                                                                                                                        case 1n+n30:
                                                                                                                          match n30:
                                                                                                                            case 0n:
                                                                                                                              {==}
                                                                                                                            case 1n+n31:
                                                                                                                              match n31:
                                                                                                                                case 0n:
                                                                                                                                  {==}
                                                                                                                                case 1n+n32:
                                                                                                                                  Empty.absurd({str_scan(ctlS(1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+n32, E), SN{}) == prepAll(ctlS(1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+1n+n32, SNil{}), str_scan(E, SN{})) : Maybe<&2, SP>}, false_ne_true(hn))

def uniSplit.t(+c: Char, -t: String, +hc: {U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool}, +h: {F.uall(SCon{c, t}) == True{} : Bool}) -> {F.uall(t) == True{} : Bool}:
  %hc : {List.all.if(u => List.all(~&2, ~Char, ~(x => (Char.to_u32(x) <= 1114111 : U32)), String.to_list(t)), _) == True{} : Bool}
  h

def uniSplit.f(+c: Char, -t: String, +hc: {U32.is_le(Char.to_u32(c), 1114111) == False{} : Bool}, +h: {F.uall(SCon{c, t}) == True{} : Bool}) -> {False{} == True{} : Bool}:
  %hc : {List.all.if(u => List.all(~&2, ~Char, ~(x => (Char.to_u32(x) <= 1114111 : U32)), String.to_list(t)), _) == True{} : Bool}
  h

# One character of a Unicode text, and the rest.
def uniSplit(+c: Char, -t: String, +h: {F.uall(SCon{c, t}) == True{} : Bool}) -> {U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool} & {F.uall(t) == True{} : Bool}:
  bcase({U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool} & {F.uall(t) == True{} : Bool}, U32.is_le(Char.to_u32(c), 1114111),
    +hc => (hc, uniSplit.t(c, t, hc, h)),
    +hc => Empty.absurd({U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool} & {F.uall(t) == True{} : Bool}, false_ne_true(uniSplit.f(c, t, hc, h))))

# Decoding a character's escape gives the character.
def DCgo(+c: Char, b1: Bool, b2: Bool, b3: Bool, -E: String, +e1: {Char.is_eq('"', c) == b1 : Bool}, +e2: {Char.is_eq('\\', c) == b2 : Bool}, +e3: {isunesc(c) == b3 : Bool}, +hu: {U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool})
  -> {dec(enc1(c, b1, b2, b3, E), DN{}, None{}) == SCon{c, dec(E, DN{}, None{})} : String}:
  match b1:
    case True{}:
      %char_eq('"', c, e1) : {dec(enc1(c, True{}, b2, b3, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
      {==}
    case False{}:
      match b2:
        case True{}:
          %char_eq('\\', c, e2) : {dec(enc1(c, False{}, True{}, b3, E), DN{}, None{}) == SCon{_, dec(E, DN{}, None{})} : String}
          {==}
        case False{}:
          match b3:
            case True{}:
              dec_unesc(c, E, e3)
            case False{}:
              ctlDec(nv(c), lenCtl(c, e1, e2, e3, hu), c, {==}, E)

def decEnc(d: String, +h: {F.uall(d) == True{} : Bool}) -> {dec(enc2(d, SNil{}), DN{}, None{}) == d : String}:
  match d:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      Equal.trans(String, dec(encC(c, enc2(t, SNil{})), DN{}, None{}), SCon{c, dec(enc2(t, SNil{}), DN{}, None{})}, SCon{c, t},
        DCgo(c, Char.is_eq('"', c), Char.is_eq('\\', c), isunesc(c), enc2(t, SNil{}), {==}, {==}, {==}, first({U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool}, {F.uall(t) == True{} : Bool}, uniSplit(c, t, h))),
        cons_eq(c, dec(enc2(t, SNil{}), DN{}, None{}), t, decEnc(t, second({U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool}, {F.uall(t) == True{} : Bool}, uniSplit(c, t, h)))))

# Scanning a character's escape reads exactly it.
def SCgo(+c: Char, b1: Bool, b2: Bool, b3: Bool, -E: String, +e1: {Char.is_eq('"', c) == b1 : Bool}, +e2: {Char.is_eq('\\', c) == b2 : Bool}, +e3: {isunesc(c) == b3 : Bool}, +hu: {U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool})
  -> {str_scan(enc1(c, b1, b2, b3, E), SN{}) == prepAll(enc1(c, b1, b2, b3, SNil{}), str_scan(E, SN{})) : Maybe<&2, SP>}:
  match b1:
    case True{}:
      {==}
    case False{}:
      match b2:
        case True{}:
          {==}
        case False{}:
          match b3:
            case True{}:
              Equal.trans(Maybe<&2, SP>, str_scan(SCon{c, E}, SN{}), sel(Maybe<&2, SP>, Char.is_eq('\\', c), u => prepM(c, str_scan(E, SE{})), u => sel(Maybe<&2, SP>, isunesc(c), u => prepM(c, str_scan(E, SN{})), u => None{})), prepM(c, str_scan(E, SN{})),
                selF(Maybe<&2, SP>, Char.is_eq('"', c), u => Some{SP{SNil{}, E}}, u => sel(Maybe<&2, SP>, Char.is_eq('\\', c), u => prepM(c, str_scan(E, SE{})), u => sel(Maybe<&2, SP>, isunesc(c), u => prepM(c, str_scan(E, SN{})), u => None{})), e1),
                Equal.trans(Maybe<&2, SP>, sel(Maybe<&2, SP>, Char.is_eq('\\', c), u => prepM(c, str_scan(E, SE{})), u => sel(Maybe<&2, SP>, isunesc(c), u => prepM(c, str_scan(E, SN{})), u => None{})), sel(Maybe<&2, SP>, isunesc(c), u => prepM(c, str_scan(E, SN{})), u => None{}), prepM(c, str_scan(E, SN{})),
                  selF(Maybe<&2, SP>, Char.is_eq('\\', c), u => prepM(c, str_scan(E, SE{})), u => sel(Maybe<&2, SP>, isunesc(c), u => prepM(c, str_scan(E, SN{})), u => None{}), e2),
                  selT(Maybe<&2, SP>, isunesc(c), u => prepM(c, str_scan(E, SN{})), u => None{}, e3)))
            case False{}:
              ctlScan(nv(c), lenCtl(c, e1, e2, e3, hu), E)

def pmApp(+c: Char, -a: String, m: Maybe<&2, SP>) -> {prepM(c, appM(a, m)) == appM(SCon{c, a}, m) : Maybe<&2, SP>}:
  match m:
    case None{}:
      {==}
    case Some{p}:
      match p:
        case SP{b, u}:
          {==}

def prepAll.app(a: String, +m: Maybe<&2, SP>) -> {prepAll(a, m) == appM(a, m) : Maybe<&2, SP>}:
  match a:
    case SNil{}:
      match m:
        case None{}:
          {==}
        case Some{p}:
          match p:
            case SP{b, u}:
              {==}
    case SCon{+c, +t}:
      Equal.trans(Maybe<&2, SP>, prepM(c, prepAll(t, m)), prepM(c, appM(t, m)), appM(SCon{c, t}, m),
        Equal.cong(Maybe<&2, SP>, Maybe<&2, SP>, z => prepM(c, z), prepAll(t, m), appM(t, m), prepAll.app(t, m)), pmApp(c, t, m))

def encApp1(+c: Char, b1: Bool, b2: Bool, b3: Bool, -E: String) -> {String.append(enc1(c, b1, b2, b3, SNil{}), E) == enc1(c, b1, b2, b3, E) : String}:
  match b1:
    case True{}:
      {==}
    case False{}:
      match b2:
        case True{}:
          {==}
        case False{}:
          match b3:
            case True{}:
              {==}
            case False{}:
              {==}

def encApp(+c: Char, -E: String) -> {String.append(encC(c, SNil{}), E) == encC(c, E) : String}:
  encApp1(c, Char.is_eq('"', c), Char.is_eq('\\', c), isunesc(c), E)

def strScanEnc(d: String, +h: {F.uall(d) == True{} : Bool}) -> {str_scan(enc2(d, "\""), SN{}) == Some{SP{enc2(d, SNil{}), SNil{}}} : Maybe<&2, SP>}:
  match d:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      Equal.trans(Maybe<&2, SP>, str_scan(encC(c, enc2(t, "\"")), SN{}), prepAll(encC(c, SNil{}), str_scan(enc2(t, "\""), SN{})), Some{SP{encC(c, enc2(t, SNil{})), SNil{}}},
        SCgo(c, Char.is_eq('"', c), Char.is_eq('\\', c), isunesc(c), enc2(t, "\""), {==}, {==}, {==}, first({U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool}, {F.uall(t) == True{} : Bool}, uniSplit(c, t, h))),
        Equal.trans(Maybe<&2, SP>, prepAll(encC(c, SNil{}), str_scan(enc2(t, "\""), SN{})), prepAll(encC(c, SNil{}), Some{SP{enc2(t, SNil{}), SNil{}}}), Some{SP{encC(c, enc2(t, SNil{})), SNil{}}},
          Equal.cong(Maybe<&2, SP>, Maybe<&2, SP>, z => prepAll(encC(c, SNil{}), z), str_scan(enc2(t, "\""), SN{}), Some{SP{enc2(t, SNil{}), SNil{}}}, strScanEnc(t, second({U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool}, {F.uall(t) == True{} : Bool}, uniSplit(c, t, h)))),
          Equal.trans(Maybe<&2, SP>, prepAll(encC(c, SNil{}), Some{SP{enc2(t, SNil{}), SNil{}}}), Some{SP{String.append(encC(c, SNil{}), enc2(t, SNil{})), SNil{}}}, Some{SP{encC(c, enc2(t, SNil{})), SNil{}}},
            prepAll.app(encC(c, SNil{}), Some{SP{enc2(t, SNil{}), SNil{}}}),
            Equal.cong(String, Maybe<&2, SP>, z => Some{SP{z, SNil{}}}, String.append(encC(c, SNil{}), enc2(t, SNil{})), encC(c, enc2(t, SNil{})), encApp(c, enc2(t, SNil{}))))))

def enc2App(d: String, +Q: String) -> {String.append(enc2(d, SNil{}), Q) == enc2(d, Q) : String}:
  match d:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      Equal.trans(String, String.append(encC(c, enc2(t, SNil{})), Q), String.append(String.append(encC(c, SNil{}), enc2(t, SNil{})), Q), encC(c, enc2(t, Q)),
        app_congr(Q, encC(c, enc2(t, SNil{})), String.append(encC(c, SNil{}), enc2(t, SNil{})), Equal.sym(String, String.append(encC(c, SNil{}), enc2(t, SNil{})), encC(c, enc2(t, SNil{})), encApp(c, enc2(t, SNil{})))),
        Equal.trans(String, String.append(String.append(encC(c, SNil{}), enc2(t, SNil{})), Q), String.append(encC(c, SNil{}), String.append(enc2(t, SNil{}), Q)), encC(c, enc2(t, Q)),
          app_assoc(encC(c, SNil{}), enc2(t, SNil{}), Q),
          Equal.trans(String, String.append(encC(c, SNil{}), String.append(enc2(t, SNil{}), Q)), String.append(encC(c, SNil{}), enc2(t, Q)), encC(c, enc2(t, Q)),
            app_congl(encC(c, SNil{}), String.append(enc2(t, SNil{}), Q), enc2(t, Q), enc2App(t, Q)), encApp(c, enc2(t, Q)))))

def strokEnc(+d: String, +h: {F.uall(d) == True{} : Bool}) -> {strok(enc2(d, SNil{})) == True{} : Bool}:
  %Equal.sym(String, String.append(enc2(d, SNil{}), "\""), enc2(d, "\""), enc2App(d, "\"")) : {okend(str_scan(_, SN{})) == True{} : Bool}
  %Equal.sym(Maybe<&2, SP>, str_scan(enc2(d, "\""), SN{}), Some{SP{enc2(d, SNil{}), SNil{}}}, strScanEnc(d, h)) : {okend(_) == True{} : Bool}
  {==}

# The tree the parser builds for a value.
def FRT(m: VMode, v: V) -> Type:
  match m:
    case VRec{}:
      Raw
    case VAll{}:
      match v:
        case VNull{}:
          Unit
        case VBool{b}:
          Unit
        case VNum{n}:
          Unit
        case VStr{t}:
          Unit
        case VArr{a}:
          List<&2, Raw>
        case VObj{o}:
          List<&2, RMem>

def encT(k: TxtT) -> String:
  match k:
    case TMk{s, h}:
      enc2(s, SNil{})

def fr(v: V, m: VMode) -> FRT(m, v):
  match v:
    case VNull{}:
      match m:
        case VRec{}:
          RNull{}
        case VAll{}:
          Unit{}
    case VBool{b}:
      match m:
        case VRec{}:
          RBool{b}
        case VAll{}:
          Unit{}
    case VNum{n}:
      match n:
        case NMk{s, h}:
          match m:
            case VRec{}:
              RNum{s}
            case VAll{}:
              Unit{}
    case VStr{t}:
      match m:
        case VRec{}:
          RStr{encT(t)}
        case VAll{}:
          Unit{}
    case VArr{a}:
      match a:
        case []:
          match m:
            case VRec{}:
              RArr{[]}
            case VAll{}:
              []
        case h <> t:
          match m:
            case VRec{}:
              RArr{fr(h, VRec{}) <> fr(VArr{t}, VAll{})}
            case VAll{}:
              fr(h, VRec{}) <> fr(VArr{t}, VAll{})
    case VObj{o}:
      match o:
        case []:
          match m:
            case VRec{}:
              RObj{[]}
            case VAll{}:
              []
        case mm <> t:
          match mm:
            case (k, x):
              match m:
                case VRec{}:
                  RObj{RMem{encT(k), fr(x, VRec{})} <> fr(VObj{t}, VAll{})}
                case VAll{}:
                  RMem{encT(k), fr(x, VRec{})} <> fr(VObj{t}, VAll{})

def andE(-a: Bool, -b: Bool, +ea: {a == True{} : Bool}, +eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ea) : {Bool.and(_, b) == True{} : Bool}
  eb

# The tree for v is well formed, and stands for v.
def WR(v: V) -> Type:
  {wf(fr(v, VRec{})) == True{} : Bool} & {rvM(fr(v, VRec{})) == Some{v} : Maybe<V>}

def keyEq(+s: String, +h: {F.uall(s) == True{} : Bool}) -> {Laws.Text.make.try.era(Laws.decode.era(enc2(s, SNil{}))) == Some{TMk{s, h}} : Maybe<TxtT>}:
  Equal.trans(Maybe<TxtT>, Laws.Text.make.try.era(Laws.decode.era(enc2(s, SNil{}))), Laws.Text.make.try.era(s), Some{TMk{s, h}},
    Equal.cong(String, Maybe<TxtT>, z => Laws.Text.make.try.era(z), Laws.decode.era(enc2(s, SNil{})), s, decEnc(s, h)),
    Laws.Text.make.try.era.valid(s, TMk{s, h}, Laws.Text.make.try.valid(s, h)))

def wrNum(+s: String, +h: {Laws.Number.valid(s) == True{} : Bool}) -> WR(VNum{NMk{s, h}}):
  (numokOf(GRAMMAR, {==}, s, MBe(GRAMMAR, {==}, "number", ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), s, {==}, mt(GRAMMAR, {==}, "number", s, hyp("number", s, F.numA(s, h))))),
    Equal.cong(Maybe<NumT>, Maybe<V>, numV, Laws.Number.make.try.era(s), Some{NMk{s, h}}, Laws.Number.make.try.era.valid(s, NMk{s, h}, Laws.Number.make.try.valid(s, h))))

def wrStr(+s: String, +h: {F.uall(s) == True{} : Bool}) -> WR(VStr{TMk{s, h}}):
  (strokEnc(s, h), Equal.cong(Maybe<TxtT>, Maybe<V>, strV, Laws.Text.make.try.era(Laws.decode.era(enc2(s, SNil{}))), Some{TMk{s, h}}, keyEq(s, h)))

def wrArr1(-x: V, p: WR(x)) -> WR(VArr{[x]}):
  match p:
    case (a, e):
      (andE(wf(fr(x, VRec{})), True{}, a, {==}), consM.some(rvM(fr(x, VRec{})), x, Some{VArr{[]}}, e))

def wrArr.e(-x: V, -h2: V, -t2: List<V>, +e1: {rvM(fr(x, VRec{})) == Some{x} : Maybe<V>}, +e2: {rvM(fr(VArr{h2 <> t2}, VRec{})) == Some{VArr{h2 <> t2}} : Maybe<V>})
  -> {rvM(fr(VArr{x <> h2 <> t2}, VRec{})) == Some{VArr{x <> h2 <> t2}} : Maybe<V>}:
  %e2 : {consM(rvM(fr(x, VRec{})), rvM(fr(VArr{h2 <> t2}, VRec{}))) == consM(Some{x}, _) : Maybe<V>}
  %e1 : {consM(rvM(fr(x, VRec{})), rvM(fr(VArr{h2 <> t2}, VRec{}))) == consM(_, rvM(fr(VArr{h2 <> t2}, VRec{}))) : Maybe<V>}
  {==}

def wrArr(-x: V, -h2: V, -t2: List<V>, p: WR(x), q: WR(VArr{h2 <> t2})) -> WR(VArr{x <> h2 <> t2}):
  match p:
    case (a1, e1):
      match q:
        case (a2, e2):
          (andE(wf(fr(x, VRec{})), wf(fr(VArr{h2 <> t2}, VRec{})), a1, a2), wrArr.e(x, h2, t2, e1, e2))

def wrObj1(k: TxtT, -x: V, p: WR(x)) -> WR(VObj{[(k, x)]}):
  match k:
    case TMk{+s, +h}:
      match p:
        case (a, e):
          (andE(strok(enc2(s, SNil{})), Bool.and(wf(fr(x, VRec{})), True{}), strokEnc(s, h), andE(wf(fr(x, VRec{})), True{}, a, {==})),
            memM.some(Laws.Text.make.try.era(Laws.decode.era(enc2(s, SNil{}))), TMk{s, h}, rvM(fr(x, VRec{})), x, Some{VObj{[]}}, keyEq(s, h), e))

def wrObj(k: TxtT, -x: V, -k2: TxtT, -x2: V, -t2: List<(TxtT & V)>, p: WR(x), q: WR(VObj{(k2, x2) <> t2})) -> WR(VObj{(k, x) <> (k2, x2) <> t2}):
  match k:
    case TMk{+s, +h}:
      match p:
        case (a1, e1):
          match q:
            case (a2, e2):
              (andE(strok(enc2(s, SNil{})), Bool.and(wf(fr(x, VRec{})), wf(fr(VObj{(k2, x2) <> t2}, VRec{}))), strokEnc(s, h), andE(wf(fr(x, VRec{})), wf(fr(VObj{(k2, x2) <> t2}, VRec{})), a1, a2)),
                Equal.trans(Maybe<V>, memM(Laws.Text.make.try.era(Laws.decode.era(enc2(s, SNil{}))), rvM(fr(x, VRec{})), rvM(fr(VObj{(k2, x2) <> t2}, VRec{}))), memM(Some{TMk{s, h}}, Some{x}, rvM(fr(VObj{(k2, x2) <> t2}, VRec{}))), Some{VObj{(TMk{s, h}, x) <> (k2, x2) <> t2}},
                  memM.some(Laws.Text.make.try.era(Laws.decode.era(enc2(s, SNil{}))), TMk{s, h}, rvM(fr(x, VRec{})), x, rvM(fr(VObj{(k2, x2) <> t2}, VRec{})), keyEq(s, h), e1),
                  Equal.cong(Maybe<V>, Maybe<V>, z => memM(Some{TMk{s, h}}, Some{x}, z), rvM(fr(VObj{(k2, x2) <> t2}, VRec{})), Some{VObj{(k2, x2) <> t2}}, e2)))

def wr(v: V) -> WR(v):
  match v:
    case VNull{}:
      ({==}, {==})
    case VBool{b}:
      ({==}, {==})
    case VNum{n}:
      match n:
        case NMk{+s, +h}:
          wrNum(s, h)
    case VStr{t}:
      match t:
        case TMk{+s, +h}:
          wrStr(s, h)
    case VArr{a}:
      match a:
        case []:
          ({==}, {==})
        case x <> t:
          match t:
            case []:
              wrArr1(x, wr(x))
            case h2 <> t2:
              wrArr(x, h2, t2, wr(x), wr(VArr{h2 <> t2}))
    case VObj{o}:
      match o:
        case []:
          ({==}, {==})
        case mm <> t:
          match mm:
            case (k, x):
              match t:
                case []:
                  wrObj1(k, x, wr(x))
                case m2 <> t2:
                  match m2:
                    case (k2, x2):
                      wrObj(k, x, k2, x2, t2, wr(x), wr(VObj{(k2, x2) <> t2}))

# Two copies of v, each equal to v.
def DupE(v: V) -> Type:
  &a: V -> &b: V -> ({a == v : V} & {b == v : V})

def eqA(-h1: V, -h: V, -r1: V, -t: List<V>, +e1: {h1 == h : V}, +f1: {r1 == VArr{t} : V}) -> {consA(h1, r1) == VArr{h <> t} : V}:
  %Equal.sym(V, h1, h, e1) : {consA(_, r1) == VArr{h <> t} : V}
  %Equal.sym(V, r1, VArr{t}, f1) : {consA(h, _) == VArr{h <> t} : V}
  {==}

def dupArr(-h: V, -t: List<V>, ph: DupE(h), pt: DupE(VArr{t})) -> DupE(VArr{h <> t}):
  match ph:
    case (h1, h2, e1, e2):
      match pt:
        case (r1, r2, f1, f2):
          (consA(h1, r1), consA(h2, r2), eqA(h1, h, r1, t, e1, f1), eqA(h2, h, r2, t, e2, f2))

def eqO(-k: TxtT, -x1: V, -x: V, -r1: V, -t: List<(TxtT & V)>, +e1: {x1 == x : V}, +f1: {r1 == VObj{t} : V}) -> {consO((k, x1), r1) == VObj{(k, x) <> t} : V}:
  %Equal.sym(V, x1, x, e1) : {consO((k, _), r1) == VObj{(k, x) <> t} : V}
  %Equal.sym(V, r1, VObj{t}, f1) : {consO((k, x), _) == VObj{(k, x) <> t} : V}
  {==}

def dupObj(+s: String, +hs: {F.uall(s) == True{} : Bool}, -x: V, -t: List<(TxtT & V)>, px: DupE(x), pt: DupE(VObj{t})) -> DupE(VObj{(TMk{s, hs}, x) <> t}):
  match px:
    case (x1, x2, e1, e2):
      match pt:
        case (r1, r2, f1, f2):
          (consO((TMk{s, hs}, x1), r1), consO((TMk{s, hs}, x2), r2), eqO(TMk{s, hs}, x1, x, r1, t, e1, f1), eqO(TMk{s, hs}, x2, x, r2, t, e2, f2))

def dupE(v: V) -> DupE(v):
  match v:
    case VNull{}:
      (VNull{}, VNull{}, {==}, {==})
    case VBool{+b}:
      (VBool{b}, VBool{b}, {==}, {==})
    case VNum{n}:
      match n:
        case NMk{+s, +h}:
          (VNum{NMk{s, h}}, VNum{NMk{s, h}}, {==}, {==})
    case VStr{t}:
      match t:
        case TMk{+s, +h}:
          (VStr{TMk{s, h}}, VStr{TMk{s, h}}, {==}, {==})
    case VArr{a}:
      match a:
        case []:
          (VArr{[]}, VArr{[]}, {==}, {==})
        case h <> t:
          dupArr(h, t, dupE(h), dupE(VArr{t}))
    case VObj{o}:
      match o:
        case []:
          (VObj{[]}, VObj{[]}, {==}, {==})
        case m <> t:
          match m:
            case (k, x):
              match k:
                case TMk{+s, +hs}:
                  dupObj(s, hs, x, t, dupE(x), dupE(VObj{t}))

def Laws.dump.era(v):
  pr(fr(v, VRec{}), PTop{})

def dumpPair(p: V & V) -> V & String:
  match p:
    case (a, b):
      (a, Laws.dump.era(b))

def Laws.dump(v):
  dumpPair(dupV(v))

def Laws.dump.borrows(v, val, str, h):
  %h : {Pair.fst(V, String, _) == v : V}
  %Equal.sym(V & V, dupV(v), (v, v), dupV.ok(v)) : {Pair.fst(V, String, dumpPair(_)) == v : V}
  {==}

def Laws.dump.era.ok(v, val, str, h):
  %h : {Pair.snd(V, String, _) == Laws.dump.era(v) : String}
  %Equal.sym(V & V, dupV(v), (v, v), dupV.ok(v)) : {Pair.snd(V, String, dumpPair(_)) == Laws.dump.era(v) : String}
  {==}

def castWR(-a: V, -b: V, +e: {b == a : V}, w: WR(b)) -> WR(a):
  %e : WR(_)
  w

def dlFin(a: V, w: WR(a)) -> {R.le(Laws.dump.era(a)) == Some{a} : Maybe<V>}:
  match w:
    case (hw, hr):
      Equal.trans(Maybe<V>, R.le(Laws.dump.era(a)), lv(Some{J{fr(a, VRec{}), istrue(wf(fr(a, VRec{})), hw)}}), Some{a},
        Equal.cong(Maybe<Js>, Maybe<V>, lv, load.ref(oDump(J{fr(a, VRec{}), istrue(wf(fr(a, VRec{})), hw)})), Some{J{fr(a, VRec{}), istrue(wf(fr(a, VRec{})), hw)}}, load.ref.dump_ok(GRAMMAR, {==}, J{fr(a, VRec{}), istrue(wf(fr(a, VRec{})), hw)})), hr)

def dl.go(-v: V, p: DupE(v)) -> {R.le(Laws.dump.era(v)) == Some{v} : Maybe<V>}:
  match p:
    case (a, b, +ea, eb):
      %ea : {R.le(Laws.dump.era(_)) == Some{_} : Maybe<V>}
      dlFin(a, castWR(a, b, Equal.trans(V, b, v, a, eb, Equal.sym(V, a, v, ea)), wr(b)))

def R.dump.load(v: V) -> {R.le(Laws.dump.era(v)) == Some{v} : Maybe<V>}:
  dl.go(v, dupE(v))

# ======================
# Bounds on code points
# ======================
#
# A \\uXXXX escape stands for at most U+FFFF, and a surrogate pair for at most
# U+10FFFF. The proofs work on the bits of a U32: multiplying by 2^k writes
# the bits k places up, and adding or subtracting words whose bits don't
# overlap keeps them as they are.

def bdisc3(b: Bool) -> Type:
  match b:
    case False{}:
      Unit
    case True{}:
      Empty

def fnt(e: {False{} == True{} : Bool}) -> Empty:
  %e : bdisc3(_)
  Unit{}

# Bits of w from position j on are all False.
def hz(n: Nat, w: Word(n), j: Nat) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+p:
      match w:
        case WCon{x, t}:
          match j:
            case 0n:
              Bool.and(Bool.not(x), hz(p, t, 0n))
            case 1n+i:
              hz(p, t, i)

# Bits of w below position k are all False.
def lz(n: Nat, w: Word(n), k: Nat) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+p:
      match w:
        case WCon{x, t}:
          match k:
            case 0n:
              True{}
            case 1n+i:
              Bool.and(Bool.not(x), lz(p, t, i))

# Bits of w below position k are all True.
def lo1(n: Nat, w: Word(n), k: Nat) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+p:
      match w:
        case WCon{x, t}:
          match k:
            case 0n:
              True{}
            case 1n+i:
              Bool.and(x, lo1(p, t, i))

# The word with only bit j set.
def pw(n: Nat, j: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      match j:
        case 0n:
          WCon{True{}, Word.zero(p)}
        case 1n+i:
          WCon{False{}, pw(p, i)}

# w with bit j set to x.
def setb(n: Nat, w: Word(n), j: Nat, x: Bool) -> Word(n):
  match n:
    case 0n:
      w
    case 1n+p:
      match w:
        case WCon{y, t}:
          match j:
            case 0n:
              WCon{x, t}
            case 1n+i:
              WCon{y, setb(p, t, i, x)}

# acc with the m bits of a written from position j on.
def insAt(m: Nat, a: Word(m), +n: Nat, acc: Word(n), +j: Nat) -> Word(n):
  match m:
    case 0n:
      acc
    case 1n+mp:
      match a:
        case WCon{x, at}:
          insAt(mp, at, n, setb(n, acc, j, x), 1n+j)

# The bits of w2 below k, then those of w1.
def mix(n: Nat, w1: Word(n), w2: Word(n), k: Nat) -> Word(n):
  match n:
    case 0n:
      w1
    case 1n+p:
      match w1:
        case WCon{x, t1}:
          match w2:
            case WCon{y, t2}:
              match k:
                case 0n:
                  WCon{x, t1}
                case 1n+i:
                  WCon{y, mix(p, t1, t2, i)}

# The bits of w2 below k, then the sum of the rest.
def mixL(n: Nat, w1: Word(n), w2: Word(n), k: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      match w1:
        case WCon{x, t1}:
          match w2:
            case WCon{y, t2}:
              match k:
                case 0n:
                  Word.adc(1n+p, WCon{x, t1}, WCon{y, t2}, False{}, False{})
                case 1n+i:
                  WCon{y, mixL(p, t1, t2, i)}

# The bits of w below k, then the difference of the rest.
def mixS(n: Nat, w: Word(n), b: Word(n), k: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      match w:
        case WCon{x, t1}:
          match b:
            case WCon{y, t2}:
              match k:
                case 0n:
                  Word.adc(1n+p, WCon{x, t1}, WCon{y, t2}, True{}, True{})
                case 1n+i:
                  WCon{x, mixS(p, t1, t2, i)}

def cmpFrom(n: Nat, a: Word(n), b: Word(n), k: Nat) -> Cmp:
  match n:
    case 0n:
      EQ{}
    case 1n+p:
      match a:
        case WCon{x, at}:
          match b:
            case WCon{y, bt}:
              match k:
                case 0n:
                  Word.cmp(1n+p, WCon{x, at}, WCon{y, bt})
                case 1n+i:
                  cmpFrom(p, at, bt, i)

def SPZ(q: Nat) -> {Word.shl.put(q, False{}, Word.zero(q)) == Word.zero(q) : Word(q)}:
  match q:
    case 0n:
      {==}
    case 1n+r:
      Equal.cong(Word(r), Word(1n+r), z => WCon{False{}, z}, Word.shl.put(r, False{}, Word.zero(r)), Word.zero(r), SPZ(r))

def SP0(p: Nat) -> {Word.shl.put(p, True{}, Word.zero(p)) == pw(p, 0n) : Word(p)}:
  match p:
    case 0n:
      {==}
    case 1n+q:
      Equal.cong(Word(q), Word(1n+q), z => WCon{True{}, z}, Word.shl.put(q, False{}, Word.zero(q)), Word.zero(q), SPZ(q))

def SPP(p: Nat, i: Nat) -> {Word.shl.put(p, False{}, pw(p, i)) == pw(p, 1n+i) : Word(p)}:
  match p:
    case 0n:
      {==}
    case 1n+q:
      match i:
        case 0n:
          Equal.cong(Word(q), Word(1n+q), z => WCon{False{}, z}, Word.shl.put(q, True{}, Word.zero(q)), pw(q, 0n), SP0(q))
        case 1n+r:
          Equal.cong(Word(q), Word(1n+q), z => WCon{False{}, z}, Word.shl.put(q, False{}, pw(q, r)), pw(q, 1n+r), SPP(q, r))

def SHLPW(n: Nat, j: Nat) -> {Word.shl(n, pw(n, j)) == pw(n, 1n+j) : Word(n)}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match j:
        case 0n:
          Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, Word.shl.put(p, True{}, Word.zero(p)), pw(p, 0n), SP0(p))
        case 1n+i:
          Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, Word.shl.put(p, False{}, pw(p, i)), pw(p, 1n+i), SPP(p, i))

def SETB(n: Nat, w: Word(n), j: Nat, +h: {hz(n, w, j) == True{} : Bool}) -> {Word.adc(n, w, pw(n, j), False{}, False{}) == setb(n, w, j, True{}) : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{x, t}:
          match x:
            case True{}:
              match j:
                case 0n:
                  Empty.absurd({Word.adc(1n+p, WCon{True{}, t}, pw(1n+p, 0n), False{}, False{}) == setb(1n+p, WCon{True{}, t}, 0n, True{}) : Word(1n+p)}, fnt(h))
                case 1n+i:
                  Equal.cong(Word(p), Word(1n+p), z => WCon{True{}, z}, Word.adc(p, t, pw(p, i), False{}, False{}), setb(p, t, i, True{}), SETB(p, t, i, h))
            case False{}:
              match j:
                case 0n:
                  Equal.cong(Word(p), Word(1n+p), z => WCon{True{}, z}, Word.adc(p, t, Word.zero(p), False{}, False{}), t, add_zero_f(p, t))
                case 1n+i:
                  Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, Word.adc(p, t, pw(p, i), False{}, False{}), setb(p, t, i, True{}), SETB(p, t, i, h))

def SETF(n: Nat, w: Word(n), j: Nat, +h: {hz(n, w, j) == True{} : Bool}) -> {setb(n, w, j, False{}) == w : Word(n)}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{x, t}:
          match x:
            case True{}:
              match j:
                case 0n:
                  Empty.absurd({setb(1n+p, WCon{True{}, t}, 0n, False{}) == WCon{True{}, t} : Word(1n+p)}, fnt(h))
                case 1n+i:
                  Equal.cong(Word(p), Word(1n+p), z => WCon{True{}, z}, setb(p, t, i, False{}), t, SETF(p, t, i, h))
            case False{}:
              match j:
                case 0n:
                  {==}
                case 1n+i:
                  Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, setb(p, t, i, False{}), t, SETF(p, t, i, h))

def and_r2(a: Bool, -b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case False{}:
      Empty.absurd({b == True{} : Bool}, fnt(h))
    case True{}:
      h

def HZS(n: Nat, w: Word(n), j: Nat, -x: Bool, +h: {hz(n, w, j) == True{} : Bool}) -> {hz(n, setb(n, w, j, x), 1n+j) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{y, t}:
          match j:
            case 0n:
              and_r2(Bool.not(y), hz(p, t, 0n), h)
            case 1n+i:
              HZS(p, t, i, x, h)

def HZP(n: Nat, w: Word(n), j: Nat, +h: {hz(n, w, j) == True{} : Bool}) -> {hz(n, w, 1n+j) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{y, t}:
          match j:
            case 0n:
              and_r2(Bool.not(y), hz(p, t, 0n), h)
            case 1n+i:
              HZP(p, t, i, h)

# Multiplying by 2^j writes a's bits from position j on.
def MULGO(+n: Nat, m: Nat, a: Word(m), +acc: Word(n), +j: Nat, +h: {hz(n, acc, j) == True{} : Bool}) -> {Word.mul.go(n, m, a, pw(n, j), acc) == insAt(m, a, n, acc, j) : Word(n)}:
  match m:
    case 0n:
      {==}
    case 1n+mp:
      match a:
        case WCon{x, at}:
          match x:
            case False{}:
              Equal.trans(Word(n), Word.mul.go(n, mp, at, Word.shl(n, pw(n, j)), acc), Word.mul.go(n, mp, at, pw(n, 1n+j), acc), insAt(mp, at, n, setb(n, acc, j, False{}), 1n+j),
                Equal.cong(Word(n), Word(n), z => Word.mul.go(n, mp, at, z, acc), Word.shl(n, pw(n, j)), pw(n, 1n+j), SHLPW(n, j)),
                Equal.trans(Word(n), Word.mul.go(n, mp, at, pw(n, 1n+j), acc), insAt(mp, at, n, acc, 1n+j), insAt(mp, at, n, setb(n, acc, j, False{}), 1n+j),
                  MULGO(n, mp, at, acc, 1n+j, HZP(n, acc, j, h)),
                  Equal.cong(Word(n), Word(n), z => insAt(mp, at, n, z, 1n+j), acc, setb(n, acc, j, False{}), Equal.sym(Word(n), setb(n, acc, j, False{}), acc, SETF(n, acc, j, h)))))
            case True{}:
              Equal.trans(Word(n), Word.mul.go(n, mp, at, Word.shl(n, pw(n, j)), Word.adc(n, acc, pw(n, j), False{}, False{})), Word.mul.go(n, mp, at, pw(n, 1n+j), setb(n, acc, j, True{})), insAt(mp, at, n, setb(n, acc, j, True{}), 1n+j),
                Equal.trans(Word(n), Word.mul.go(n, mp, at, Word.shl(n, pw(n, j)), Word.adc(n, acc, pw(n, j), False{}, False{})), Word.mul.go(n, mp, at, pw(n, 1n+j), Word.adc(n, acc, pw(n, j), False{}, False{})), Word.mul.go(n, mp, at, pw(n, 1n+j), setb(n, acc, j, True{})),
                  Equal.cong(Word(n), Word(n), z => Word.mul.go(n, mp, at, z, Word.adc(n, acc, pw(n, j), False{}, False{})), Word.shl(n, pw(n, j)), pw(n, 1n+j), SHLPW(n, j)),
                  Equal.cong(Word(n), Word(n), z => Word.mul.go(n, mp, at, pw(n, 1n+j), z), Word.adc(n, acc, pw(n, j), False{}, False{}), setb(n, acc, j, True{}), SETB(n, acc, j, h))),
                MULGO(n, mp, at, setb(n, acc, j, True{}), 1n+j, HZS(n, acc, j, True{}, h)))

# Adding to a word whose low k bits are False keeps the other's low k bits.
def ADDLZ(n: Nat, w1: Word(n), w2: Word(n), k: Nat, +h: {lz(n, w1, k) == True{} : Bool}) -> {Word.adc(n, w1, w2, False{}, False{}) == mixL(n, w1, w2, k) : Word(n)}:
  match n:
    case 0n:
      match w1:
        case WNil{}:
          match w2:
            case WNil{}:
              {==}
    case 1n+p:
      match w1:
        case WCon{x, t1}:
          match x:
            case True{}:
              match w2:
                case WCon{y, t2}:
                  match k:
                    case 0n:
                      {==}
                    case 1n+i:
                      Empty.absurd({Word.adc(1n+p, WCon{True{}, t1}, WCon{y, t2}, False{}, False{}) == mixL(1n+p, WCon{True{}, t1}, WCon{y, t2}, 1n+i) : Word(1n+p)}, fnt(h))
            case False{}:
              match w2:
                case WCon{y, t2}:
                  match y:
                    case False{}:
                      match k:
                        case 0n:
                          {==}
                        case 1n+i:
                          Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, Word.adc(p, t1, t2, False{}, False{}), mixL(p, t1, t2, i), ADDLZ(p, t1, t2, i, h))
                    case True{}:
                      match k:
                        case 0n:
                          {==}
                        case 1n+i:
                          Equal.cong(Word(p), Word(1n+p), z => WCon{True{}, z}, Word.adc(p, t1, t2, False{}, False{}), mixL(p, t1, t2, i), ADDLZ(p, t1, t2, i, h))

def HZ0(n: Nat, w: Word(n), +h: {hz(n, w, 0n) == True{} : Bool}) -> {w == Word.zero(n) : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{x, t}:
          match x:
            case True{}:
              Empty.absurd({WCon{True{}, t} == Word.zero(1n+p) : Word(1n+p)}, fnt(h))
            case False{}:
              Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, t, Word.zero(p), HZ0(p, t, h))

def MLM0(n: Nat, w1: Word(n), -w2: Word(n), +e: {w2 == Word.zero(n) : Word(n)}) -> {Word.adc(n, w1, w2, False{}, False{}) == w1 : Word(n)}:
  %Equal.sym(Word(n), w2, Word.zero(n), e) : {Word.adc(n, w1, _, False{}, False{}) == w1 : Word(n)}
  add_zero_f(n, w1)

def MLM(n: Nat, w1: Word(n), w2: Word(n), k: Nat, +h: {hz(n, w2, k) == True{} : Bool}) -> {mixL(n, w1, w2, k) == mix(n, w1, w2, k) : Word(n)}:
  match n:
    case 0n:
      match w1:
        case WNil{}:
          {==}
    case 1n+ +p:
      match w1:
        case WCon{x, t1}:
          match w2:
            case WCon{y, t2}:
              match k:
                case 0n:
                  MLM0(1n+p, WCon{x, t1}, WCon{y, t2}, HZ0(1n+p, WCon{y, t2}, h))
                case 1n+i:
                  Equal.cong(Word(p), Word(1n+p), z => WCon{y, z}, mixL(p, t1, t2, i), mix(p, t1, t2, i), MLM(p, t1, t2, i, h))

# Adding words whose bits don't overlap at k.
def DISJK(+n: Nat, +w1: Word(n), +w2: Word(n), +k: Nat, +h1: {lz(n, w1, k) == True{} : Bool}, +h2: {hz(n, w2, k) == True{} : Bool}) -> {Word.adc(n, w1, w2, False{}, False{}) == mix(n, w1, w2, k) : Word(n)}:
  Equal.trans(Word(n), Word.adc(n, w1, w2, False{}, False{}), mixL(n, w1, w2, k), mix(n, w1, w2, k), ADDLZ(n, w1, w2, k, h1), MLM(n, w1, w2, k, h2))

# Subtracting a word whose low k bits are False keeps the low k bits.
def SUBLOW(n: Nat, w: Word(n), b: Word(n), k: Nat, +h: {lz(n, b, k) == True{} : Bool}) -> {Word.adc(n, w, b, True{}, True{}) == mixS(n, w, b, k) : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          match b:
            case WNil{}:
              {==}
    case 1n+p:
      match w:
        case WCon{x, t1}:
          match x:
            case False{}:
              match b:
                case WCon{y, t2}:
                  match y:
                    case True{}:
                      match k:
                        case 0n:
                          {==}
                        case 1n+i:
                          Empty.absurd({Word.adc(1n+p, WCon{False{}, t1}, WCon{True{}, t2}, True{}, True{}) == mixS(1n+p, WCon{False{}, t1}, WCon{True{}, t2}, 1n+i) : Word(1n+p)}, fnt(h))
                    case False{}:
                      match k:
                        case 0n:
                          {==}
                        case 1n+i:
                          Equal.cong(Word(p), Word(1n+p), z => WCon{False{}, z}, Word.adc(p, t1, t2, True{}, True{}), mixS(p, t1, t2, i), SUBLOW(p, t1, t2, i, h))
            case True{}:
              match b:
                case WCon{y, t2}:
                  match y:
                    case True{}:
                      match k:
                        case 0n:
                          {==}
                        case 1n+i:
                          Empty.absurd({Word.adc(1n+p, WCon{True{}, t1}, WCon{True{}, t2}, True{}, True{}) == mixS(1n+p, WCon{True{}, t1}, WCon{True{}, t2}, 1n+i) : Word(1n+p)}, fnt(h))
                    case False{}:
                      match k:
                        case 0n:
                          {==}
                        case 1n+i:
                          Equal.cong(Word(p), Word(1n+p), z => WCon{True{}, z}, Word.adc(p, t1, t2, True{}, True{}), mixS(p, t1, t2, i), SUBLOW(p, t1, t2, i, h))

def CLfin(x: Bool, t: Cmp, +h: {Cmp.is_le(t) == True{} : Bool}) -> {Cmp.is_le(Word.cmp.fin(x, True{}, t)) == True{} : Bool}:
  match x:
    case False{}:
      match t:
        case LT{}:
          {==}
        case EQ{}:
          {==}
        case GT{}:
          Empty.absurd({Cmp.is_le(Word.cmp.fin(False{}, True{}, GT{})) == True{} : Bool}, fnt(h))
    case True{}:
      match t:
        case LT{}:
          {==}
        case EQ{}:
          {==}
        case GT{}:
          Empty.absurd({Cmp.is_le(Word.cmp.fin(True{}, True{}, GT{})) == True{} : Bool}, fnt(h))

# A word compares at most equal to one whose low k bits are True, if the rest does.
def CL(n: Nat, a: Word(n), b: Word(n), k: Nat, +hb: {lo1(n, b, k) == True{} : Bool}, +hc: {Cmp.is_le(cmpFrom(n, a, b, k)) == True{} : Bool}) -> {Cmp.is_le(Word.cmp(n, a, b)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+ +p:
      match a:
        case WCon{+x, +at}:
          match b:
            case WCon{y, +bt}:
              match y:
                case False{}:
                  match k:
                    case 0n:
                      hc
                    case 1n+i:
                      Empty.absurd({Cmp.is_le(Word.cmp(1n+p, WCon{x, at}, WCon{False{}, bt})) == True{} : Bool}, fnt(hb))
                case True{}:
                  match k:
                    case 0n:
                      hc
                    case 1n+i:
