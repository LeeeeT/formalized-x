  tokI(gl, hg, N, ch, String.append(w, b), e, Equal.trans(Bool, tokb2(ch, skip_ws(String.append(w, b))), tokb2(ch, skip_ws(b)), True{}, Equal.cong(String, Bool, z => tokb2(ch, z), skip_ws(String.append(w, b)), skip_ws(b), WE(w, b, hw)), tokE(gl, hg, N, ch, b, e, hch, h)))

