def numokOf(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), a) == True{} : Bool}) -> {numok(a) == True{} : Bool}:
  %Equal.sym(Maybe<&2, SP>, num_scan(a), Some{SP{a, SNil{}}}, Equal.trans(Maybe<&2, SP>, num_scan(a), num_scan(String.append(a, SNil{})), Some{SP{a, SNil{}}}, Equal.cong(String, Maybe<&2, SP>, z => num_scan(z), a, String.append(a, SNil{}), Equal.sym(String, String.append(a, SNil{}), a, append_nil(a))), numC(gl, hg, a, SNil{}, h, {==}))) : {okend(_) == True{} : Bool}
  {==}

def strokOf(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), a) == True{} : Bool}) -> {strok(a) == True{} : Bool}:
