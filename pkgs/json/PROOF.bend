def F.nsim.x(b: Bool, +c: Char, +t2: String, +acc: String, -k: F.K, kf: F.KF(k)) -> {F.obs(t2, F.nnx2(b, acc, k, c)) == F.RN(F.cend(b, c, t2), acc, k) : Maybe<V>}:
  match b:
    case False{}:
      F.runX.obs(t2)
    case True{}:
      F.nsim.x2(c, t2, acc, k, kf)

