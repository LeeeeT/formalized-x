def strvPS(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, -t: String, ns: SNS(gl, hg, m, t, ABNF.rep.any(ABNF.ref("char")))) -> PSR(gl, hg, ABNF.ref("value"), strv(m), SCon{'"', t}):
  match m:
