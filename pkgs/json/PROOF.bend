        F.RS(str_scan(t2, SN{}), F.rev(pre(hexv(SCon{x1, SCon{x2, SCon{x3, SCon{c, SNil{}}}}}, 0), p), acc), DN{}, np(hexv(SCon{x1, SCon{x2, SCon{x3, SCon{c, SNil{}}}}}, 0), p), d),
