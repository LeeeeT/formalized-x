def strC.step(+gl: GL, +hg: {gl == GRAMMAR : GL}, -x: String, +a: String, +b: String, +t: String, +e: {String.append(a, b) == x : String}, +ha: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("char"), a) == True{} : Bool}, +ih: {str_scan(String.append(b, SCon{'"', t}), SN{}) == Some{SP{b, t}} : Maybe<&2, SP>})
  -> {str_scan(String.append(x, SCon{'"', t}), SN{}) == Some{SP{x, t}} : Maybe<&2, SP>}:
  %e : {str_scan(String.append(_, SCon{'"', t}), SN{}) == Some{SP{_, t}} : Maybe<&2, SP>}
  %Equal.sym(String, String.append(String.append(a, b), SCon{'"', t}), String.append(a, String.append(b, SCon{'"', t})), app3(a, b, SCon{'"', t})) : {str_scan(_, SN{}) == Some{SP{String.append(a, b), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, str_scan(String.append(a, String.append(b, SCon{'"', t})), SN{}), appM(a, str_scan(String.append(b, SCon{'"', t}), SN{})), strC1(gl, hg, a, String.append(b, SCon{'"', t}), ha)) : {_ == Some{SP{String.append(a, b), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, str_scan(String.append(b, SCon{'"', t}), SN{}), Some{SP{b, t}}, ih) : {appM(a, _) == Some{SP{String.append(a, b), t}} : Maybe<&2, SP>}
  {==}

def strC.m(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Nat, +x: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.exactly(m, ABNF.ref("char")), x) == True{} : Bool}) -> {str_scan(String.append(x, SCon{'"', t}), SN{}) == Some{SP{x, t}} : Maybe<&2, SP>}:
  match m:
    case 0n:
      %Equal.sym(String, x, SNil{}, emptyE(ABNF.full(toList(gl)), x, exZe(ABNF.full(toList(gl)), ABNF.ref("char"), x, h))) : {str_scan(String.append(_, SCon{'"', t}), SN{}) == Some{SP{_, t}} : Maybe<&2, SP>}
      {==}
    case 1n+ +m1:
      seqE2({str_scan(String.append(x, SCon{'"', t}), SN{}) == Some{SP{x, t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.ref("char"), ABNF.rep.exactly(m1, ABNF.ref("char")), x, exSe(ABNF.full(toList(gl)), m1, ABNF.ref("char"), x, h),
        +a => +b => +e => +ha => +hb => strC.step(gl, hg, x, a, b, t, e, ha, strC.m(gl, hg, m1, b, t, hb)))

def strC.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: String, +t: String, p: &m: Nat -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.exactly(m, ABNF.ref("char")), x) == True{} : Bool}) -> {str_scan(String.append(x, SCon{'"', t}), SN{}) == Some{SP{x, t}} : Maybe<&2, SP>}:
  (m, h) = p
  strC.m(gl, hg, m, x, t, h)

# A string's text scans to itself, whatever follows its closing quote.
def strC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}) -> {str_scan(String.append(x, SCon{'"', t}), SN{}) == Some{SP{x, t}} : Maybe<&2, SP>}:
  strC.go(gl, hg, x, t, ABNF.rep.any.elim(ABNF.full(toList(gl)), ABNF.ref("char"), x, h))

# Character classes
# =================

def isfol(+c: Char) -> Bool:
  Bool.or(isws(c), Bool.or(Char.is_eq(',', c), Bool.or(Char.is_eq(']', c), Bool.or(Char.is_eq('}', c), False{}))))

# fol(t): t may follow a value: it is empty, or starts with whitespace, a comma or a closing bracket.
def fol(t: String) -> Bool:
  match t:
    case SNil{}:
      True{}
    case SCon{c, r}:
      isfol(c)

def nd(t: String) -> Bool:
  match t:
    case SNil{}:
      True{}
    case SCon{c, r}:
      Bool.not(isdig(c))

def notdot(t: String) -> Bool:
  match t:
    case SNil{}:
      True{}
    case SCon{c, r}:
      Bool.not(Char.is_eq('.', c))

def notminus(t: String) -> Bool:
  match t:
    case SNil{}:
      True{}
    case SCon{c, r}:
      Bool.not(Char.is_eq('-', c))

