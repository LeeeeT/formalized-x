def ci2(+k: ABNF.Book, +lo: Char, +up: Char, +a: Char, +b: Char, +t: String) -> {ABNF.check.era(k, ABNF.seq([ABNF.alt([ABNF.char(lo), ABNF.char(up)]), ABNF.empty]), SCon{a, SCon{b, t}}) == False{} : Bool}:
