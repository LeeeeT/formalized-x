def altR(+k: ABNF.Book, +r: ABNF.Rule, rs: List<ABNF.Rule>, +s: String, +h: {ABNF.check.era(k, ABNF.alt(rs), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.alt(r <> rs), s) == True{} : Bool}:
