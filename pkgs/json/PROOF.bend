    case (str, +val):
      Equal.trans(Bool, F.ishexS(x), Bool.and(Bool.not(String.is_empty(x)), List.all(~&2, ~Char, ~(c2 => String.contains("0123456789abcdefABCDEF", SCon{c2, SNil{}})), String.to_list(x))), Extra.String.is_hex.era(x), F.ishexS.eq(x),
