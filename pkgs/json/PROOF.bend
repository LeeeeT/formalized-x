  {==}

def Laws.Value.cases.string(P, on_null, on_bool, on_number, on_string, on_array, on_object, t):
  {==}

def Laws.Value.cases.array(P, on_null, on_bool, on_number, on_string, on_array, on_object, a):
  {==}

def Laws.Value.cases.object(P, on_null, on_bool, on_number, on_string, on_array, on_object, o):
  {==}

# Copies of numbers, texts and values, field by field.
def dupN(n: NumT) -> NumT & NumT:
  match n:
    case NMk{+s, +h}:
      (NMk{s, h}, NMk{s, h})

def dupN.ok(n: NumT) -> {dupN(n) == (n, n) : NumT & NumT}:
  match n:
    case NMk{s, h}:
      {==}

def dupT(t: TxtT) -> TxtT & TxtT:
  match t:
    case TMk{+s, +h}:
      (TMk{s, h}, TMk{s, h})

def dupT.ok(t: TxtT) -> {dupT(t) == (t, t) : TxtT & TxtT}:
  match t:
    case TMk{s, h}:
      {==}

def consA(h: V, r: V) -> V:
  match r:
    case VArr{l}:
      VArr{h <> l}
    case r:
      VArr{[h]}

def consO(m: TxtT & V, r: V) -> V:
  match r:
    case VObj{l}:
      VObj{m <> l}
    case r:
      VObj{[m]}

def elPair(hp: V & V, tp: V & V) -> V & V:
  match hp:
    case (h1, h2):
      match tp:
        case (t1, t2):
          (consA(h1, t1), consA(h2, t2))

def memPair(kp: TxtT & TxtT, xp: V & V, tp: V & V) -> V & V:
  match kp:
    case (k1, k2):
      match xp:
        case (x1, x2):
          match tp:
            case (t1, t2):
              (consO((k1, x1), t1), consO((k2, x2), t2))

def numPair(p: NumT & NumT) -> V & V:
  match p:
    case (a, b):
      (VNum{a}, VNum{b})

def txtPair(p: TxtT & TxtT) -> V & V:
  match p:
    case (a, b):
      (VStr{a}, VStr{b})

def dupV(v: V) -> V & V:
  match v:
    case VNull{}:
      (VNull{}, VNull{})
    case VBool{+b}:
      (VBool{b}, VBool{b})
    case VNum{n}:
      numPair(dupN(n))
    case VStr{t}:
      txtPair(dupT(t))
    case VArr{a}:
      match a:
        case []:
          (VArr{[]}, VArr{[]})
        case h <> t:
          elPair(dupV(h), dupV(VArr{t}))
    case VObj{o}:
      match o:
        case []:
          (VObj{[]}, VObj{[]})
        case m <> t:
          match m:
            case (k, x):
              memPair(dupT(k), dupV(x), dupV(VObj{t}))

def dupV.ok(v: V) -> {dupV(v) == (v, v) : V & V}:
  match v:
    case VNull{}:
      {==}
    case VBool{b}:
      {==}
    case VNum{n}:
      match n:
        case NMk{s, h}:
          {==}
    case VStr{t}:
      match t:
        case TMk{s, h}:
          {==}
    case VArr{a}:
      match a:
        case []:
          {==}
        case h <> t:
          %dupV.ok(VArr{t}) : {elPair(dupV(h), dupV(VArr{t})) == elPair((h, h), _) : V & V}
          %dupV.ok(h) : {elPair(dupV(h), dupV(VArr{t})) == elPair(_, dupV(VArr{t})) : V & V}
          {==}
    case VObj{o}:
      match o:
        case []:
          {==}
        case m <> t:
          match m:
            case (k, x):
              %dupV.ok(VObj{t}) : {memPair(dupT(k), dupV(x), dupV(VObj{t})) == memPair((k, k), (x, x), _) : V & V}
              %dupV.ok(x) : {memPair(dupT(k), dupV(x), dupV(VObj{t})) == memPair((k, k), _, dupV(VObj{t})) : V & V}
              %dupT.ok(k) : {memPair(dupT(k), dupV(x), dupV(VObj{t})) == memPair(_, dupV(x), dupV(VObj{t})) : V & V}
              {==}

def unA(v: V) -> List<V>:
  match v:
    case VArr{l}:
      l
    case v:
      []

def unO(v: V) -> List<(TxtT & V)>:
  match v:
    case VObj{l}:
      l
    case v:
      []

def splitN(p: NumT & NumT) -> V & Maybe<NumT>:
  match p:
    case (a, b):
      (VNum{a}, Some{b})

def splitT(p: TxtT & TxtT) -> V & Maybe<TxtT>:
  match p:
    case (a, b):
      (VStr{a}, Some{b})

def splitA(p: V & V) -> V & Maybe<List<V>>:
  match p:
    case (a, b):
      (a, Some{unA(b)})

def splitO(p: V & V) -> V & Maybe<List<(TxtT & V)>>:
  match p:
    case (a, b):
      (a, Some{unO(b)})

def Laws.Value.as_null(v):
  Laws.Value.cases(~(_ => Laws.Value | (Unit & (Unit -> Laws.Value))), ~Inr{(Unit{}, u => Laws.Value.null)}, ~(b => Inl{Laws.Value.bool(b)}), ~(n => Inl{Laws.Value.number(n)}), ~(t => Inl{Laws.Value.string(t)}), ~(a => Inl{Laws.Value.array(a)}), ~(o => Inl{Laws.Value.object(o)}), v)

def Laws.Value.as_null.ok(v):
  {==}

def Laws.Value.as_null.dup(v):
  match v:
    case VNull{}:
      (VNull{}, Some{Unit{}})
    case VBool{b}:
      (VBool{b}, None{})
    case VNum{n}:
      (VNum{n}, None{})
    case VStr{t}:
      (VStr{t}, None{})
    case VArr{a}:
      (VArr{a}, None{})
    case VObj{o}:
      (VObj{o}, None{})

def Laws.Value.as_null.dup.ok(v):
  match v:
    case VNull{}:
      {==}
    case VBool{b}:
      {==}
    case VNum{n}:
      {==}
    case VStr{t}:
      {==}
    case VArr{a}:
      {==}
    case VObj{o}:
      {==}

def Laws.Value.as_null.era(v):
  Pair.snd(Laws.Value, Maybe<Unit>, Laws.Value.as_null.dup(v))

def Laws.Value.as_null.era.ok(v, w, val, h):
  %h : {Pair.snd(Laws.Value, Maybe<Unit>, _) == Laws.Value.as_null.era(v) : Maybe<Unit>}
  {==}

def Laws.Value.as_bool(v):
  Laws.Value.cases(~(_ => Laws.Value | (Bool & (Bool -> Laws.Value))), ~Inl{Laws.Value.null}, ~(b => Inr{(b, Laws.Value.bool)}), ~(n => Inl{Laws.Value.number(n)}), ~(t => Inl{Laws.Value.string(t)}), ~(a => Inl{Laws.Value.array(a)}), ~(o => Inl{Laws.Value.object(o)}), v)

def Laws.Value.as_bool.ok(v):
  {==}

def Laws.Value.as_bool.dup(v):
  match v:
    case VNull{}:
      (VNull{}, None{})
    case VBool{+b}:
      (VBool{b}, Some{b})
    case VNum{n}:
      (VNum{n}, None{})
    case VStr{t}:
      (VStr{t}, None{})
    case VArr{a}:
      (VArr{a}, None{})
    case VObj{o}:
      (VObj{o}, None{})

def Laws.Value.as_bool.dup.ok(v):
  match v:
    case VNull{}:
      {==}
    case VBool{b}:
      {==}
    case VNum{n}:
      {==}
    case VStr{t}:
      {==}
    case VArr{a}:
      {==}
    case VObj{o}:
      {==}

def Laws.Value.as_bool.era(v):
  Pair.snd(Laws.Value, Maybe<Bool>, Laws.Value.as_bool.dup(v))

