def eMO(+g: Nat, s: String, xM: @w: String -> EXT(MM{}, pv(g, MM{}, w), w, g)) -> EXT(MO{}, pv(1n+g, MO{}, s), s, 1n+g):
  match s:
    case SNil{}:
      Unit{}
    case SCon{+x, +w}:
      bcase(EXT(MO{}, pv(1n+g, MO{}, SCon{x, w}), SCon{x, w}, 1n+g), Char.is_eq('}', x), +h => eMO.e(g, x, w, h),
