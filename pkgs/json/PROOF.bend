def sign0(+gl: GL, +hg: {gl == GRAMMAR : GL}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")]), SNil{}) == False{} : Bool}:
  alt2F(ABNF.full(toList(gl)), ABNF.ref("minus"), [ABNF.ref("plus")], SNil{}, Equal.trans(Bool, ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("minus"), SNil{}), ABNF.check.era(ABNF.full(toList(gl)), ABNF.char('-'), SNil{}), False{}, MB(gl, hg, "minus", ABNF.char('-'), SNil{}, {==}), ABNF.char.nil(ABNF.full(toList(gl)), '-')),
