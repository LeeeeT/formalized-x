def sign2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: Char, +b: Char, +t: String) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")]), SCon{a, SCon{b, t}}) == False{} : Bool}:
