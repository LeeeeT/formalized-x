# exp decomposed: its e, sign and digits.
def expH(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +x: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("exp"), x) == True{} : Bool},
  f: @c: Char -> @s1: String -> @d1: String -> {SCon{c, String.append(s1, d1)} == x : String} -> {ise(c) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")])), s1) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.at_least(1n, ABNF.core.digit), d1) == True{} : Bool} -> C) -> C:
  seqE3(C, ABNF.full(toList(gl)), ABNF.ref("e"), ABNF.opt(ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")])), ABNF.rep.at_least(1n, ABNF.core.digit), x, MBe(gl, hg, "exp", ABNF.seq([ABNF.ref("e"), ABNF.opt(ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")])), ABNF.rep.at_least(1n, ABNF.core.digit)]), x, {==}, h), +e1 => +s1 => +d1 => +e => +he => +hs => +hd =>
    one(C, ABNF.full(toList(gl)), ABNF.ref("e"), e1, he, eref0(gl, hg), z1 => z2 => z3 => eref2(gl, hg, z1, z2, z3), +c => +ec => +hc =>
      f(c, s1, d1, Equal.trans(String, SCon{c, String.append(s1, d1)}, String.append(e1, String.append(s1, d1)), x, app_congr(String.append(s1, d1), SCon{c, SNil{}}, e1, ec), e),
        tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("e"), SCon{c, SNil{}}), ise(c), eref1(gl, hg, c), hc), hs, hd)))

def ndE.s(+c: Char, -s1: String, -d1: String, -x: String, +t: String, +e: {SCon{c, String.append(s1, d1)} == x : String}, +hc: {ise(c) == True{} : Bool}) -> {nd(String.append(x, t)) == True{} : Bool}:
  %e : {nd(String.append(_, t)) == True{} : Bool}
  not_ft(isdig(c), e_dig(c, hc))

# What follows int or frac is not a digit.
def ndE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), x) == True{} : Bool}, +ht: {fol(t) == True{} : Bool}) -> {nd(String.append(x, t)) == True{} : Bool}:
  optE({nd(String.append(x, t)) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("exp"), x, h,
    +hn => Equal.trans(Bool, nd(String.append(x, t)), nd(t), True{}, Equal.cong(String, Bool, z => nd(String.append(z, t)), x, SNil{}, hn), fol_nd(t, ht)),
    +hs => expH(gl, hg, {nd(String.append(x, t)) == True{} : Bool}, x, hs, +c => +s1 => +d1 => +e => +hc => +h1 => +h2 => ndE.s(c, s1, d1, x, t, e, hc)))

def notdotE.s(+c: Char, -s1: String, -d1: String, -x: String, +t: String, +e: {SCon{c, String.append(s1, d1)} == x : String}, +hc: {ise(c) == True{} : Bool}) -> {notdot(String.append(x, t)) == True{} : Bool}:
  %e : {notdot(String.append(_, t)) == True{} : Bool}
  not_ft(Char.is_eq('.', c), e_dot(c, hc))

def notdotE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), x) == True{} : Bool}, +ht: {fol(t) == True{} : Bool}) -> {notdot(String.append(x, t)) == True{} : Bool}:
  optE({notdot(String.append(x, t)) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("exp"), x, h,
    +hn => Equal.trans(Bool, notdot(String.append(x, t)), notdot(t), True{}, Equal.cong(String, Bool, z => notdot(String.append(z, t)), x, SNil{}, hn), fol_notdot(t, ht)),
    +hs => expH(gl, hg, {notdot(String.append(x, t)) == True{} : Bool}, x, hs, +c => +s1 => +d1 => +e => +hc => +h1 => +h2 => notdotE.s(c, s1, d1, x, t, e, hc)))

def nsignC.n.go(+c: Char, +y: String, -d1: String, +t: String, +e: {SCon{c, y} == d1 : String}, +hc: {isdig(c) == True{} : Bool}, +hd: {dig1(digits(String.append(d1, t))) == Some{SP{d1, t}} : Maybe<&2, SP>})
  -> {nsign(String.append(d1, t)) == Some{SP{d1, t}} : Maybe<&2, SP>}:
  %e : {nsign(String.append(_, t)) == Some{SP{_, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nsign(SCon{c, String.append(y, t)}), dig1(digits(SCon{c, String.append(y, t)})), selF(Maybe<&2, SP>, issign(c), u => prepM(c, dig1(digits(String.append(y, t)))), u => dig1(digits(SCon{c, String.append(y, t)})), dig_sign(c, hc))) : {_ == Some{SP{SCon{c, y}, t}} : Maybe<&2, SP>}
  %Equal.sym(String, SCon{c, y}, d1, e) : {dig1(digits(String.append(_, t))) == Some{SP{_, t}} : Maybe<&2, SP>}
  hd

def nsignC.s(+c: Char, -s1: String, +d1: String, +t: String, +ec: {SCon{c, SNil{}} == s1 : String}, +hc: {issign(c) == True{} : Bool}, +hd: {dig1(digits(String.append(d1, t))) == Some{SP{d1, t}} : Maybe<&2, SP>})
  -> {nsign(String.append(s1, String.append(d1, t))) == Some{SP{String.append(s1, d1), t}} : Maybe<&2, SP>}:
  %ec : {nsign(String.append(_, String.append(d1, t))) == Some{SP{String.append(_, d1), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nsign(SCon{c, String.append(d1, t)}), prepM(c, dig1(digits(String.append(d1, t)))), selT(Maybe<&2, SP>, issign(c), u => prepM(c, dig1(digits(String.append(d1, t)))), u => dig1(digits(SCon{c, String.append(d1, t)})), hc)) : {_ == Some{SP{SCon{c, d1}, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, dig1(digits(String.append(d1, t))), Some{SP{d1, t}}, hd) : {prepM(c, _) == Some{SP{SCon{c, d1}, t}} : Maybe<&2, SP>}
  {==}

def nsignC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s1: String, +d1: String, +t: String, +hs: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")])), s1) == True{} : Bool}, +hd: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.at_least(1n, ABNF.core.digit), d1) == True{} : Bool}, +ht: {nd(t) == True{} : Bool})
  -> {nsign(String.append(s1, String.append(d1, t))) == Some{SP{String.append(s1, d1), t}} : Maybe<&2, SP>}:
  optE({nsign(String.append(s1, String.append(d1, t))) == Some{SP{String.append(s1, d1), t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")]), s1, hs,
    +hn => Equal.trans(Maybe<&2, SP>, nsign(String.append(s1, String.append(d1, t))), nsign(String.append(d1, t)), Some{SP{String.append(s1, d1), t}},
      Equal.cong(String, Maybe<&2, SP>, z => nsign(String.append(z, String.append(d1, t))), s1, SNil{}, hn),
      Equal.trans(Maybe<&2, SP>, nsign(String.append(d1, t)), Some{SP{d1, t}}, Some{SP{String.append(s1, d1), t}},
        al1H(gl, hg, {nsign(String.append(d1, t)) == Some{SP{d1, t}} : Maybe<&2, SP>}, d1, hd, +c => +y => +e => +hc => +hy => nsignC.n.go(c, y, d1, t, e, hc, dig1Cm(gl, hg, d1, t, hd, ht))),
        Equal.cong(String, Maybe<&2, SP>, z => Some{SP{String.append(z, d1), t}}, SNil{}, s1, Equal.sym(String, s1, SNil{}, hn)))),
    +hsg => one({nsign(String.append(s1, String.append(d1, t))) == Some{SP{String.append(s1, d1), t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")]), s1, hsg, sign0(gl, hg), z1 => z2 => z3 => sign2(gl, hg, z1, z2, z3), +c => +ec => +hc =>
      nsignC.s(c, s1, d1, t, ec, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.ref("minus"), ABNF.ref("plus")]), SCon{c, SNil{}}), issign(c), sign1(gl, hg, c), hc), dig1Cm(gl, hg, d1, t, hd, ht))))

def nexp0(t: String, +ht: {fol(t) == True{} : Bool}) -> {nexp(t) == Some{SP{SNil{}, t}} : Maybe<&2, SP>}:
  match t:
    case SNil{}:
      {==}
    case SCon{+c, +r}:
      selF(Maybe<&2, SP>, ise(c), u => prepM(c, nsign(r)), u => Some{SP{SNil{}, SCon{c, r}}}, fol_e(c, ht))

def nexpC.s(+c: Char, +s1: String, +d1: String, -x: String, +t: String, +e: {SCon{c, String.append(s1, d1)} == x : String}, +hc: {ise(c) == True{} : Bool}, +hn: {nsign(String.append(s1, String.append(d1, t))) == Some{SP{String.append(s1, d1), t}} : Maybe<&2, SP>})
  -> {nexp(String.append(x, t)) == Some{SP{x, t}} : Maybe<&2, SP>}:
  %e : {nexp(String.append(_, t)) == Some{SP{_, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nexp(SCon{c, String.append(String.append(s1, d1), t)}), prepM(c, nsign(String.append(String.append(s1, d1), t))), selT(Maybe<&2, SP>, ise(c), u => prepM(c, nsign(String.append(String.append(s1, d1), t))), u => Some{SP{SNil{}, SCon{c, String.append(String.append(s1, d1), t)}}}, hc)) : {_ == Some{SP{SCon{c, String.append(s1, d1)}, t}} : Maybe<&2, SP>}
  %Equal.sym(String, String.append(String.append(s1, d1), t), String.append(s1, String.append(d1, t)), app3(s1, d1, t)) : {prepM(c, nsign(_)) == Some{SP{SCon{c, String.append(s1, d1)}, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nsign(String.append(s1, String.append(d1, t))), Some{SP{String.append(s1, d1), t}}, hn) : {prepM(c, _) == Some{SP{SCon{c, String.append(s1, d1)}, t}} : Maybe<&2, SP>}
  {==}

def nexpC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), x) == True{} : Bool}, +ht: {fol(t) == True{} : Bool}) -> {nexp(String.append(x, t)) == Some{SP{x, t}} : Maybe<&2, SP>}:
  optE({nexp(String.append(x, t)) == Some{SP{x, t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.ref("exp"), x, h,
    +hn => Equal.trans(Maybe<&2, SP>, nexp(String.append(x, t)), nexp(t), Some{SP{x, t}}, Equal.cong(String, Maybe<&2, SP>, z => nexp(String.append(z, t)), x, SNil{}, hn),
      Equal.trans(Maybe<&2, SP>, nexp(t), Some{SP{SNil{}, t}}, Some{SP{x, t}}, nexp0(t, ht), Equal.cong(String, Maybe<&2, SP>, z => Some{SP{z, t}}, SNil{}, x, Equal.sym(String, x, SNil{}, hn)))),
    +hs => expH(gl, hg, {nexp(String.append(x, t)) == Some{SP{x, t}} : Maybe<&2, SP>}, x, hs, +c => +s1 => +d1 => +e => +hc => +hsg => +hd => nexpC.s(c, s1, d1, x, t, e, hc, nsignC(gl, hg, s1, d1, t, hsg, hd, fol_nd(t, ht)))))

def nfracNE(X: String, +h: {notdot(X) == True{} : Bool}) -> {nfrac(X) == nexp(X) : Maybe<&2, SP>}:
  match X:
    case SNil{}:
      {==}
    case SCon{+c, +r}:
      selF(Maybe<&2, SP>, Char.is_eq('.', c), u => prepM(c, nfrac2(dig1(digits(r)))), u => nexp(SCon{c, r}), not_tf(Char.is_eq('.', c), h))

# frac decomposed: its point, and its digits.
def fracH(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +f1: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("frac"), f1) == True{} : Bool}, f: @d: String -> {SCon{'.', d} == f1 : String} -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.at_least(1n, ABNF.core.digit), d) == True{} : Bool} -> C) -> C:
  seqE2(C, ABNF.full(toList(gl)), ABNF.ref("decimal-point"), ABNF.rep.at_least(1n, ABNF.core.digit), f1, MBe(gl, hg, "frac", ABNF.seq([ABNF.ref("decimal-point"), ABNF.rep.at_least(1n, ABNF.core.digit)]), f1, {==}, h), +p1 => +d => +e => +hp => +hd =>
    f(d, Equal.trans(String, SCon{'.', d}, String.append(p1, d), f1, app_congr(d, SCon{'.', SNil{}}, p1, Equal.sym(String, p1, SCon{'.', SNil{}}, charIs(ABNF.full(toList(gl)), '.', p1, MBe(gl, hg, "decimal-point", ABNF.char('.'), p1, {==}, hp)))), e), hd))

def nfracC.n(+gl: GL, +hg: {gl == GRAMMAR : GL}, -f1: String, +e1: String, +t: String, +hn: {f1 == SNil{} : String}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {nfrac(String.append(f1, String.append(e1, t))) == Some{SP{String.append(f1, e1), t}} : Maybe<&2, SP>}:
  %Equal.sym(String, f1, SNil{}, hn) : {nfrac(String.append(_, String.append(e1, t))) == Some{SP{String.append(_, e1), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nfrac(String.append(e1, t)), nexp(String.append(e1, t)), nfracNE(String.append(e1, t), notdotE(gl, hg, e1, t, he, ht))) : {_ == Some{SP{e1, t}} : Maybe<&2, SP>}
  nexpC(gl, hg, e1, t, he, ht)

def nfracC.s(+gl: GL, +hg: {gl == GRAMMAR : GL}, -f1: String, +d: String, +e1: String, +t: String, +e: {SCon{'.', d} == f1 : String}, +hd: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.at_least(1n, ABNF.core.digit), d) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {nfrac(String.append(f1, String.append(e1, t))) == Some{SP{String.append(f1, e1), t}} : Maybe<&2, SP>}:
  %e : {nfrac(String.append(_, String.append(e1, t))) == Some{SP{String.append(_, e1), t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, dig1(digits(String.append(d, String.append(e1, t)))), Some{SP{d, String.append(e1, t)}}, dig1Cm(gl, hg, d, String.append(e1, t), hd, ndE(gl, hg, e1, t, he, ht))) : {prepM('.', nfrac2(_)) == Some{SP{SCon{'.', String.append(d, e1)}, t}} : Maybe<&2, SP>}
  %Equal.sym(Maybe<&2, SP>, nexp(String.append(e1, t)), Some{SP{e1, t}}, nexpC(gl, hg, e1, t, he, ht)) : {prepM('.', appM(d, _)) == Some{SP{SCon{'.', String.append(d, e1)}, t}} : Maybe<&2, SP>}
  {==}

def nfracC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +f1: String, +e1: String, +t: String, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {nfrac(String.append(f1, String.append(e1, t))) == Some{SP{String.append(f1, e1), t}} : Maybe<&2, SP>}:
  optE({nfrac(String.append(f1, String.append(e1, t))) == Some{SP{String.append(f1, e1), t}} : Maybe<&2, SP>}, ABNF.full(toList(gl)), ABNF.ref("frac"), f1, hf,
    +hn => nfracC.n(gl, hg, f1, e1, t, hn, he, ht),
    +hs => fracH(gl, hg, {nfrac(String.append(f1, String.append(e1, t))) == Some{SP{String.append(f1, e1), t}} : Maybe<&2, SP>}, f1, hs, +d => +e => +hd => nfracC.s(gl, hg, f1, d, e1, t, e, hd, he, ht)))

def ndF.s(-f1: String, -d: String, -X: String, +e: {SCon{'.', d} == f1 : String}) -> {nd(String.append(f1, X)) == True{} : Bool}:
  %e : {nd(String.append(_, X)) == True{} : Bool}
  {==}

# What follows int is not a digit.
def ndF(+gl: GL, +hg: {gl == GRAMMAR : GL}, +f1: String, +e1: String, +t: String, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
  -> {nd(String.append(f1, String.append(e1, t))) == True{} : Bool}:
  optE({nd(String.append(f1, String.append(e1, t))) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("frac"), f1, hf,
    +hn => Equal.trans(Bool, nd(String.append(f1, String.append(e1, t))), nd(String.append(e1, t)), True{}, Equal.cong(String, Bool, z => nd(String.append(z, String.append(e1, t))), f1, SNil{}, hn), ndE(gl, hg, e1, t, he, ht)),
    +hs => fracH(gl, hg, {nd(String.append(f1, String.append(e1, t))) == True{} : Bool}, f1, hs, +d => +e => +hd => ndF.s(f1, d, String.append(e1, t), e)))

def nintC.z(+gl: GL, +hg: {gl == GRAMMAR : GL}, -i: String, +f1: String, +e1: String, +t: String, +ei: {i == SCon{'0', SNil{}} : String}, +hf: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("frac")), f1) == True{} : Bool}, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.opt(ABNF.ref("exp")), e1) == True{} : Bool}, +ht: {fol(t) == True{} : Bool})
