# A hex digit's value has four bits.
def F.dvH(+c: Char, +h: {F.hx(c) == True{} : Bool}) -> DVT(c):
  bcase(DVT(c), Char.is_eq('0', c), +k => F.dvL0(c, k), +n0 => bcase(DVT(c), Char.is_eq('1', c), +k => F.dvL1(c, k), +n1 => bcase(DVT(c), Char.is_eq('2', c), +k => F.dvL2(c, k), +n2 => bcase(DVT(c), Char.is_eq('3', c), +k => F.dvL3(c, k), +n3 => bcase(DVT(c), Char.is_eq('4', c), +k => F.dvL4(c, k), +n4 => bcase(DVT(c), Char.is_eq('5', c), +k => F.dvL5(c, k), +n5 => bcase(DVT(c), Char.is_eq('6', c), +k => F.dvL6(c, k), +n6 => bcase(DVT(c), Char.is_eq('7', c), +k => F.dvL7(c, k), +n7 => bcase(DVT(c), Char.is_eq('8', c), +k => F.dvL8(c, k), +n8 => bcase(DVT(c), Char.is_eq('9', c), +k => F.dvL9(c, k), +n9 => bcase(DVT(c), Char.is_eq('a', c), +k => F.dvL10(c, k), +n10 => bcase(DVT(c), Char.is_eq('b', c), +k => F.dvL11(c, k), +n11 => bcase(DVT(c), Char.is_eq('c', c), +k => F.dvL12(c, k), +n12 => bcase(DVT(c), Char.is_eq('d', c), +k => F.dvL13(c, k), +n13 => bcase(DVT(c), Char.is_eq('e', c), +k => F.dvL14(c, k), +n14 => bcase(DVT(c), Char.is_eq('f', c), +k => F.dvL15(c, k), +n15 => bcase(DVT(c), Char.is_eq('A', c), +k => F.dvL16(c, k), +n16 => bcase(DVT(c), Char.is_eq('B', c), +k => F.dvL17(c, k), +n17 => bcase(DVT(c), Char.is_eq('C', c), +k => F.dvL18(c, k), +n18 => bcase(DVT(c), Char.is_eq('D', c), +k => F.dvL19(c, k), +n19 => bcase(DVT(c), Char.is_eq('E', c), +k => F.dvL20(c, k), +n20 => bcase(DVT(c), Char.is_eq('F', c), +k => F.dvL21(c, k), +n21 => Empty.absurd(DVT(c), contra(F.hx(c), h, F.hxsF("0123456789abcdefABCDEF", c, False{}, (n0, (n1, (n2, (n3, (n4, (n5, (n6, (n7, (n8, (n9, (n10, (n11, (n12, (n13, (n14, (n15, (n16, (n17, (n18, (n19, (n20, (n21, Unit{})))))))))))))))))))))))))))))))))))))))))))))))

def hexGo(+a: Char, +b: Char, +c: Char, +d: Char, pa: DVT(a), pb: DVT(b), pc: DVT(c), pd: DVT(d)) -> H4(hexv(X4(a, b, c, d), 0)):
  match pa:
    case (+a0, +a1, +a2, +a3, ea):
      match pb:
        case (+b0, +b1, +b2, +b3, eb):
          match pc:
            case (+c0, +c1, +c2, +c3, ec):
              match pd:
                case (+d0, +d1, +d2, +d3, ed):
                  (d0, d1, d2, d3, c0, c1, c2, c3, b0, b1, b2, b3, a0, a1, a2, a3, Equal.trans(U32, hexv(X4(a, b, c, d), 0), f4(U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, Word.zero(28n)}}}}}, U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, Word.zero(28n)}}}}}, U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, Word.zero(28n)}}}}}, U32{WCon{d0, WCon{d1, WCon{d2, WCon{d3, Word.zero(28n)}}}}}), U32{WCon{d0, WCon{d1, WCon{d2, WCon{d3, WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{a0, WCon{a1, WCon{a2, WCon{a3, Word.zero(16n)}}}}}}}}}}}}}}}}},
                    f4cong(hexd(a), U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, Word.zero(28n)}}}}}, hexd(b), U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, Word.zero(28n)}}}}}, hexd(c), U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, Word.zero(28n)}}}}}, hexd(d), U32{WCon{d0, WCon{d1, WCon{d2, WCon{d3, Word.zero(28n)}}}}}, ea, eb, ec, ed),
                    hex4w(a0, a1, a2, a3, b0, b1, b2, b3, c0, c1, c2, c3, d0, d1, d2, d3)))

# The value of four hexadecimal digits is below U+10000.
def HEX4(+a: Char, +b: Char, +c: Char, +d: Char, +hx: {F.ishexS(X4(a, b, c, d)) == True{} : Bool}) -> H4(hexv(X4(a, b, c, d), 0)):
  +h4 = Equal.trans(Bool, F.h4(a, b, c, d), F.ishexS(X4(a, b, c, d)), True{}, Equal.sym(Bool, F.ishexS(X4(a, b, c, d)), F.h4(a, b, c, d), F.h4Eq(a, b, c, d)), hx)
  hexGo(a, b, c, d, F.dvH(a, F.andL(F.hx(a), Bool.and(F.hx(b), Bool.and(F.hx(c), F.hx(d))), h4)),
    F.dvH(b, F.andL(F.hx(b), Bool.and(F.hx(c), F.hx(d)), F.andR(F.hx(a), Bool.and(F.hx(b), Bool.and(F.hx(c), F.hx(d))), h4))),
    F.dvH(c, F.andL(F.hx(c), F.hx(d), F.andR(F.hx(b), Bool.and(F.hx(c), F.hx(d)), F.andR(F.hx(a), Bool.and(F.hx(b), Bool.and(F.hx(c), F.hx(d))), h4)))),
    F.dvH(d, F.andR(F.hx(c), F.hx(d), F.andR(F.hx(b), Bool.and(F.hx(c), F.hx(d)), F.andR(F.hx(a), Bool.and(F.hx(b), Bool.and(F.hx(c), F.hx(d))), h4)))))

def h4le(-v: U32, w: H4(v)) -> {U32.is_le(v, 1114111) == True{} : Bool}:
  match w:
    case (h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, e):
      %Equal.sym(U32, v, U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}, e) : {U32.is_le(_, 1114111) == True{} : Bool}
      {==}

def castHi(-v: U32, -w: U32, +e: {v == w : U32}, +h: {hi(v) == True{} : Bool}) -> {hi(w) == True{} : Bool}:
  %e : {hi(_) == True{} : Bool}
  h

def castLo(-v: U32, -w: U32, +e: {v == w : U32}, +h: {lo(v) == True{} : Bool}) -> {lo(w) == True{} : Bool}:
  %e : {lo(_) == True{} : Bool}
  h

def pairB3(+h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +h8: Bool, +h9: Bool, +h10: Bool, +h11: Bool, +h12: Bool, +h13: Bool, +h14: Bool, +h15: Bool, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +l7: Bool, +l8: Bool, +l9: Bool, +l10: Bool, +l11: Bool, +l12: Bool, +l13: Bool, +l14: Bool, +l15: Bool, -l: U32, +el: {l == U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{l7, WCon{l8, WCon{l9, WCon{l10, WCon{l11, WCon{l12, WCon{l13, WCon{l14, WCon{l15, Word.zero(16n)}}}}}}}}}}}}}}}}} : U32}, +hh: {hi(U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}) == True{} : Bool}, +hl: {lo(l) == True{} : Bool}) -> {U32.is_le(pair(U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}, l), 1114111) == True{} : Bool}:
  %Equal.sym(U32, l, U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{l7, WCon{l8, WCon{l9, WCon{l10, WCon{l11, WCon{l12, WCon{l13, WCon{l14, WCon{l15, Word.zero(16n)}}}}}}}}}}}}}}}}}, el) : {U32.is_le(pair(U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}, _), 1114111) == True{} : Bool}
  pairH(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15, hh, castLo(l, U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{l7, WCon{l8, WCon{l9, WCon{l10, WCon{l11, WCon{l12, WCon{l13, WCon{l14, WCon{l15, Word.zero(16n)}}}}}}}}}}}}}}}}}, el, hl))

def pairB2(+h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +h8: Bool, +h9: Bool, +h10: Bool, +h11: Bool, +h12: Bool, +h13: Bool, +h14: Bool, +h15: Bool, -l: U32, Hl: H4(l), +hh: {hi(U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}) == True{} : Bool}, +hl: {lo(l) == True{} : Bool}) -> {U32.is_le(pair(U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}, l), 1114111) == True{} : Bool}:
  match Hl:
    case (l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15, el):
      pairB3(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15, l, el, hh, hl)

def pairB1(+h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +h8: Bool, +h9: Bool, +h10: Bool, +h11: Bool, +h12: Bool, +h13: Bool, +h14: Bool, +h15: Bool, -h: U32, +eh: {h == U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}} : U32}, -l: U32, Hl: H4(l), +hh: {hi(h) == True{} : Bool}, +hl: {lo(l) == True{} : Bool}) -> {U32.is_le(pair(h, l), 1114111) == True{} : Bool}:
  %Equal.sym(U32, h, U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}, eh) : {U32.is_le(pair(_, l), 1114111) == True{} : Bool}
  pairB2(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, l, Hl, castHi(h, U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}}, eh, hh), hl)

def pairB(-h: U32, -l: U32, Hh: H4(h), Hl: H4(l), +hh: {hi(h) == True{} : Bool}, +hl: {lo(l) == True{} : Bool}) -> {U32.is_le(pair(h, l), 1114111) == True{} : Bool}:
  match Hh:
    case (h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, eh):
      pairB1(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h, eh, l, Hl, hh, hl)

# ========================
# Decoded text is Unicode
# ========================

def eqnSym(a: Nat, b: Nat) -> {eqn(a, b) == eqn(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      eqnSym(p, q)

def eqSym(+a: Char, +b: Char) -> {Char.is_eq(a, b) == Char.is_eq(b, a) : Bool}:
  Equal.trans(Bool, Char.is_eq(a, b), eqn(nv(a), nv(b)), Char.is_eq(b, a), ch_eq(a, b),
    Equal.trans(Bool, eqn(nv(a), nv(b)), eqn(nv(b), nv(a)), Char.is_eq(b, a), eqnSym(nv(a), nv(b)), Equal.sym(Bool, Char.is_eq(b, a), eqn(nv(b), nv(a)), ch_eq(b, a))))

def eqSymT(+a: Char, +b: Char, +h: {Char.is_eq(a, b) == True{} : Bool}) -> {Char.is_eq(b, a) == True{} : Bool}:
  Equal.trans(Bool, Char.is_eq(b, a), Char.is_eq(a, b), True{}, eqSym(b, a), h)

def eqSymF(+a: Char, +b: Char, +h: {Char.is_eq(a, b) == False{} : Bool}) -> {Char.is_eq(b, a) == False{} : Bool}:
  Equal.trans(Bool, Char.is_eq(b, a), Char.is_eq(a, b), False{}, eqSym(b, a), h)

def u32le(+x: Word(32n), +y: Word(32n)) -> {U32.is_le(U32{x}, U32{y}) == le(Word.to_nat(32n, x), Word.to_nat(32n, y)) : Bool}:
  Equal.trans(Bool, Cmp.is_le(Word.cmp(32n, x, y)), Cmp.is_le(ncmp(Word.to_nat(32n, x), Word.to_nat(32n, y))), le(Word.to_nat(32n, x), Word.to_nat(32n, y)),
    Equal.cong(Cmp, Bool, Cmp.is_le, Word.cmp(32n, x, y), ncmp(Word.to_nat(32n, x), Word.to_nat(32n, y)), wcmp(32n, x, y)), ncmp_le(Word.to_nat(32n, x), Word.to_nat(32n, y)))

def u32le_trans(a: U32, b: U32, c: U32, +h1: {U32.is_le(a, b) == True{} : Bool}, +h2: {U32.is_le(b, c) == True{} : Bool}) -> {U32.is_le(a, c) == True{} : Bool}:
  match a:
    case U32{+x}:
      match b:
        case U32{+y}:
          match c:
            case U32{+z}:
              Equal.trans(Bool, U32.is_le(U32{x}, U32{z}), le(Word.to_nat(32n, x), Word.to_nat(32n, z)), True{}, u32le(x, z),
                le_trans(Word.to_nat(32n, x), Word.to_nat(32n, y), Word.to_nat(32n, z),
                  Equal.trans(Bool, le(Word.to_nat(32n, x), Word.to_nat(32n, y)), U32.is_le(U32{x}, U32{y}), True{}, Equal.sym(Bool, U32.is_le(U32{x}, U32{y}), le(Word.to_nat(32n, x), Word.to_nat(32n, y)), u32le(x, y)), h1),
                  Equal.trans(Bool, le(Word.to_nat(32n, y), Word.to_nat(32n, z)), U32.is_le(U32{y}, U32{z}), True{}, Equal.sym(Bool, U32.is_le(U32{y}, U32{z}), le(Word.to_nat(32n, y), Word.to_nat(32n, z)), u32le(y, z)), h2)))

def chEqLe(+K: Char, +c: Char, +e: {Char.is_eq(K, c) == True{} : Bool}, +hk: {U32.is_le(Char.to_u32(K), 1114111) == True{} : Bool}) -> {U32.is_le(Char.to_u32(c), 1114111) == True{} : Bool}:
  %char_eq(K, c, e) : {U32.is_le(Char.to_u32(_), 1114111) == True{} : Bool}
  hk

def chEqLeE(+K: Char, +c: Char, +e: {Char.is_eq(K, c) == True{} : Bool}, +hk: {U32.is_le(Char.to_u32(esc(K)), 1114111) == True{} : Bool}) -> {U32.is_le(Char.to_u32(esc(c)), 1114111) == True{} : Bool}:
  %char_eq(K, c, e) : {U32.is_le(Char.to_u32(esc(_)), 1114111) == True{} : Bool}
