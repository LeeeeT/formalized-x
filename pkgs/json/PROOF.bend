  %Equal.sym(String, skip_ws(String.append(vs, String.append(mem, String.append(X2, E)))), SCon{',', String.append(str_tl(skip_ws(vs)), String.append(mem, String.append(X2, E)))}, tokU(',', vs, String.append(mem, String.append(X2, E)), hvs)) : {pv(1n+String.length(_), MO{}, _) == Some{PR{r, u}} : Maybe<&2, PR>}
  %Equal.sym(String, skip_ws(String.append(str_tl(skip_ws(vs)), String.append(mem, String.append(X2, E)))), skip_ws(String.append(mem, String.append(X2, E))), WE(str_tl(skip_ws(vs)), String.append(mem, String.append(X2, E)), tokW(',', vs, hvs))) : {pv(1n+String.length(String.append(str_tl(skip_ws(vs)), String.append(mem, String.append(X2, E)))), MM{}, _) == Some{PR{r, u}} : Maybe<&2, PR>}
  extNil(gl, hg, MM{}, skip_ws(String.append(mem, String.append(X2, E))), r, u, eM, 1n+String.length(String.append(str_tl(skip_ws(vs)), String.append(mem, String.append(X2, E)))), w,
    leOcc(String.append(mem, String.append(X2, E)), String.append(str_tl(skip_ws(vs)), String.append(mem, String.append(X2, E))), str_tl(skip_ws(vs)), SNil{}, app_congl(str_tl(skip_ws(vs)), String.append(String.append(mem, String.append(X2, E)), SNil{}), String.append(mem, String.append(X2, E)), append_nil(String.append(mem, String.append(X2, E))))))

def moS.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, -X: String, +E: String, -it: String, +X2: String, +vs: String, +mem: String, +es: {String.append(X, E) == s : String}, +ex: {String.append(it, X2) == X : String}, +eit: {String.append(vs, mem) == it : String}, +hvs: {tokb(',', vs) == True{} : Bool},
  +r: Raw, +u: String, +eM: {pvc(MM{}, skip_ws(String.append(mem, String.append(X2, E)))) == Some{PR{r, u}} : Maybe<&2, PR>}, +w: {wsall(u) == True{} : Bool}) -> CRO(s):
  %es : CRO(_)
  %ex : CRO(String.append(_, E))
  %eit : CRO(String.append(String.append(_, X2), E))
  (r, u, moS.eq(gl, hg, vs, mem, X2, E, hvs, r, u, eM, w), w)

def moS.d(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, -X: String, +E: String, -it: String, +X2: String, +vs: String, +mem: String, +es: {String.append(X, E) == s : String}, +ex: {String.append(it, X2) == X : String}, +eit: {String.append(vs, mem) == it : String}, +hvs: {tokb(',', vs) == True{} : Bool},
  IH: CR(CMM{}, String.append(mem, String.append(X2, E)))) -> CRO(s):
  (r, u, eM, w) = IH
  moS.go(gl, hg, s, X, E, it, X2, vs, mem, es, ex, eit, hvs, r, u, eM, w)

# A comma and the members after it.
def moS(+gl: GL, +hg: {gl == GRAMMAR : GL}, +d: Nat, +m1: Nat, +s: String, h: {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.seq([ABNF.rep.exactly(1n+m1, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object")]), s) == True{} : Bool}, ih: @w: String -> CH(gl, hg, CMM{}, d, m1, w) -> CR(CMM{}, w)) -> CRO(s):
  seqE2(CRO(s), ABNF.limit(d, toList(gl)), ABNF.rep.exactly(1n+m1, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object"), s, h, +X => +E => +es => +hX => +hE =>
    seqE2(CRO(s), ABNF.limit(d, toList(gl)), ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")]), ABNF.rep.exactly(m1, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), X, exSe(ABNF.limit(d, toList(gl)), m1, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")]), X, hX), +it => +X2 => +ex => +hit => +hX2 =>
      seqE2(CRO(s), ABNF.limit(d, toList(gl)), ABNF.ref("value-separator"), ABNF.ref("member"), it, hit, +vs => +mem => +eit => +hvs => +hmem =>
        moS.d(gl, hg, s, X, E, it, X2, vs, mem, es, ex, eit, tokE(gl, hg, "value-separator", ',', vs, {==}, {==}, toBK(gl, hg, d, ABNF.ref("value-separator"), vs, hvs)),
          ih(String.append(mem, String.append(X2, E)), seqI3(ABNF.limit(d, toList(gl)), ABNF.ref("member"), ABNF.rep.exactly(m1, ABNF.seq([ABNF.ref("value-separator"), ABNF.ref("member")])), ABNF.ref("end-object"), mem, X2, E, hmem, hX2, hE))))))

# Whatever matches the grammar at some depth, the parser reads.
def Core(+gl: GL, +hg: {gl == GRAMMAR : GL}, d: Nat, m: Nat, c: CMd, +s: String, h: CH(gl, hg, c, d, m, s)) -> CR(c, s):
  match d:
    case 0n:
      core0(gl, hg, m, c, s, h)
    case 1n+ +d1:
      match d1:
        case 0n:
          match m:
            case 0n:
              match c:
                case CV{}:
                  Empty.absurd(CR(CV{}, s), val1(gl, hg, s, h))
                case CA{}:
                  ca0(gl, hg, 1n+0n, s, h)
                case CMM{}:
                  cmm(gl, hg, 0n, 0n, s, h, +y => hy => core0(gl, hg, 0n, CV{}, y, hy), +z => hz => moZ(gl, hg, 1n+0n, z, hz))
            case 1n+ +m1:
              match c:
                case CV{}:
                  Empty.absurd(CR(CV{}, s), val1(gl, hg, s, h))
                case CA{}:
                  caS(gl, hg, 1n+0n, m1, s, h, +y => hy => Core(gl, hg, 1n+0n, m1, CV{}, y, hy), +z => hz => Core(gl, hg, 1n+0n, m1, CA{}, z, hz))
                case CMM{}:
                  cmm(gl, hg, 0n, 1n+m1, s, h, +y => hy => core0(gl, hg, 0n, CV{}, y, hy), +z => hz => moS(gl, hg, 1n+0n, m1, z, hz, +w => hw => Core(gl, hg, 1n+0n, m1, CMM{}, w, hw)))
        case 1n+ +d2:
          match m:
            case 0n:
              match c:
                case CV{}:
                  cvCase(gl, hg, d2, s, h, +y => hy => Core(gl, hg, d2, 0n, CV{}, y, hy), +k => +z => hz => Core(gl, hg, d2, k, CA{}, z, hz), +k => +z => hz => Core(gl, hg, d2, k, CMM{}, z, hz))
                case CA{}:
                  ca0(gl, hg, 1n+1n+d2, s, h)
                case CMM{}:
                  cmm(gl, hg, 1n+d2, 0n, s, h, +y => hy => Core(gl, hg, 1n+d2, 0n, CV{}, y, hy), +z => hz => moZ(gl, hg, 1n+1n+d2, z, hz))
            case 1n+ +m1:
              match c:
                case CV{}:
                  cvCase(gl, hg, d2, s, h, +y => hy => Core(gl, hg, d2, 0n, CV{}, y, hy), +k => +z => hz => Core(gl, hg, d2, k, CA{}, z, hz), +k => +z => hz => Core(gl, hg, d2, k, CMM{}, z, hz))
                case CA{}:
                  caS(gl, hg, 1n+1n+d2, m1, s, h, +y => hy => Core(gl, hg, 1n+1n+d2, m1, CV{}, y, hy), +z => hz => Core(gl, hg, 1n+1n+d2, m1, CA{}, z, hz))
                case CMM{}:
                  cmm(gl, hg, 1n+d2, 1n+m1, s, h, +y => hy => Core(gl, hg, 1n+d2, 0n, CV{}, y, hy), +z => hz => moS(gl, hg, 1n+1n+d2, m1, z, hz, +w => hw => Core(gl, hg, 1n+1n+d2, m1, CMM{}, w, hw)))

# Dumping and loading
# ===================

def emptyOf(u: String, +h: {String.is_empty(u) == True{} : Bool}) -> {u == SNil{} : String}:
  match u:
    case SNil{}:
      {==}
    case SCon{c, t}:
      Empty.absurd({SCon{c, t} == SNil{} : String}, false_ne_true(h))

def numK.go2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, u: String, -s: String, +e: {String.append(a, u) == s : String}, +ha: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), a) == True{} : Bool}, +h: {String.is_empty(u) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), s) == True{} : Bool}:
  match u:
    case SNil{}:
      %e : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), _) == True{} : Bool}
      %Equal.sym(String, String.append(a, SNil{}), a, append_nil(a)) : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), _) == True{} : Bool}
      ha
    case SCon{c, t}:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), s) == True{} : Bool}, false_ne_true(h))

def numK.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, -s: String, ns: NS(gl, hg, m, s, ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))])), +h: {okend(m) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), s) == True{} : Bool}:
  match m:
    case None{}:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), s) == True{} : Bool}, false_ne_true(h))
    case Some{p}:
      match p:
        case SP{+a, +u}:
          (e, +ha) = ns
          numK.go2(gl, hg, a, u, s, e, castSPA(gl, hg, ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), a, u, ha), h)

# A number's text that scans whole is a number.
def numK(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +h: {numok(s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]), s) == True{} : Bool}:
  numK.go(gl, hg, num_scan(s), s, numS(gl, hg, s), h)

def strK.go2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, u: String, +s: String, +e: {String.append(a, SCon{'"', u}) == String.append(s, SCon{'"', SNil{}}) : String}, +ha: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), a) == True{} : Bool}, +h: {String.is_empty(u) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), s) == True{} : Bool}:
  match u:
    case SNil{}:
      %snoc_cancel(a, s, '"', e) : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), _) == True{} : Bool}
      ha
    case SCon{c, t}:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), s) == True{} : Bool}, false_ne_true(h))

def strK.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, +s: String, ns: SNS(gl, hg, m, String.append(s, SCon{'"', SNil{}}), ABNF.rep.any(ABNF.ref("char"))), +h: {okend(m) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), s) == True{} : Bool}:
  match m:
    case None{}:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), s) == True{} : Bool}, false_ne_true(h))
    case Some{p}:
      match p:
        case SP{+a, +u}:
          (e, +ha) = ns
          strK.go2(gl, hg, a, u, s, e, castSPA(gl, hg, ABNF.rep.any(ABNF.ref("char")), a, u, ha), h)

# A string's text that scans whole is a run of chars.
def strK(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +h: {strok(s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), s) == True{} : Bool}:
  strK.go(gl, hg, str_scan(String.append(s, SCon{'"', SNil{}}), SN{}), s, strS(gl, hg, String.append(s, SCon{'"', SNil{}}), SN{}), h)

def rtNum.s(s: String, +en: {num_scan(s) == Some{SP{s, SNil{}}} : Maybe<&2, SP>}) -> {pvc(MV{}, skip_ws(s)) == Some{PR{RNum{s}, SNil{}}} : Maybe<&2, PR>}:
  match s:
    case SNil{}:
      Empty.absurd({pvc(MV{}, skip_ws(SNil{})) == Some{PR{RNum{SNil{}}, SNil{}}} : Maybe<&2, PR>}, none_ne_some(&2, SP, SP{SNil{}, SNil{}}, en))
    case SCon{+c, +s1}:
      bcase({pvc(MV{}, skip_ws(SCon{c, s1})) == Some{PR{RNum{SCon{c, s1}}, SNil{}}} : Maybe<&2, PR>}, isnum0(c), +k => cvNum.eq(c, s1, k, en),
        +k => Empty.absurd({pvc(MV{}, skip_ws(SCon{c, s1})) == Some{PR{RNum{SCon{c, s1}}, SNil{}}} : Maybe<&2, PR>}, none_ne_some(&2, SP, SP{SCon{c, s1}, SNil{}}, Equal.trans(Maybe<&2, SP>, None{}, num_scan(SCon{c, s1}), Some{SP{SCon{c, s1}, SNil{}}}, Equal.sym(Maybe<&2, SP>, num_scan(SCon{c, s1}), None{}, cvNum.nf(c, s1, k)), en))))

def rtNum(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +h: {numok(s) == True{} : Bool}) -> {pvc(MV{}, skip_ws(s)) == Some{PR{RNum{s}, SNil{}}} : Maybe<&2, PR>}:
  rtNum.s(s, Equal.trans(Maybe<&2, SP>, num_scan(s), num_scan(String.append(s, SNil{})), Some{SP{s, SNil{}}}, Equal.cong(String, Maybe<&2, SP>, z => num_scan(z), s, String.append(s, SNil{}), Equal.sym(String, String.append(s, SNil{}), s, append_nil(s))), numC(gl, hg, s, SNil{}, numK(gl, hg, s, h), {==})))

# RTY(m, r): the parser reads back what pr(r, m) writes.
def RTY(m: PM, r: Raw) -> Data:
  match m:
    case PTop{}:
      {pvc(MV{}, skip_ws(pr(r, PTop{}))) == Some{PR{r, SNil{}}} : Maybe<&2, PR>}
    case PTail{}:
      match r:
        case RNull{}:
          Unit
        case RBool{b}:
          Unit
        case RNum{s}:
          Unit
        case RStr{s}:
          Unit
        case RArr{xs}:
          {pvc(MA{}, skip_ws(pr(RArr{xs}, PTail{}))) == Some{PR{RArr{xs}, SNil{}}} : Maybe<&2, PR>}
        case RObj{ms}:
          {pvc(MO{}, skip_ws(pr(RObj{ms}, PTail{}))) == Some{PR{RObj{ms}, SNil{}}} : Maybe<&2, PR>}

def rtArr(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: Raw, +rest: List<&2, Raw>, +IH1: RTY(PTop{}, x), +IH2: RTY(PTail{}, RArr{rest})) -> RTY(PTop{}, RArr{x <> rest}):
  %Equal.sym(Maybe<&2, PR>, brk(']', skip_ws(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), MA{}, skip_ws(prt(p)))))), Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), MV{}, skip_ws(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{})))), +p => acons(prr(p), pv(1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), MA{}, skip_ws(prt(p))))), brkNot(pr(x, PTop{}), pr(RArr{rest}, PTail{}), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), MA{}, skip_ws(prt(p))))), x, SNil{}, IH1)) : {_ == Some{PR{RArr{x <> rest}, SNil{}}} : Maybe<&2, PR>}
  itemsCore(gl, hg, 1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), pr(x, PTop{}), pr(RArr{rest}, PTail{}), x, SNil{}, IH1, {==}, RArr{rest}, SNil{}, IH2, {==},
    leOcc(pr(x, PTop{}), String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{})), SNil{}, pr(RArr{rest}, PTail{}), {==}),
    leOcc(pr(RArr{rest}, PTail{}), String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{})), pr(x, PTop{}), SNil{}, app_congl(pr(x, PTop{}), String.append(pr(RArr{rest}, PTail{}), SNil{}), pr(RArr{rest}, PTail{}), append_nil(pr(RArr{rest}, PTail{})))))

def rtArrT(+gl: GL, +hg: {gl == GRAMMAR : GL}, +x: Raw, +rest: List<&2, Raw>, +IH1: RTY(PTop{}, x), +IH2: RTY(PTail{}, RArr{rest})) -> RTY(PTail{}, RArr{x <> rest}):
  itemsCore(gl, hg, 1n+String.length(String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{}))), pr(x, PTop{}), pr(RArr{rest}, PTail{}), x, SNil{}, IH1, {==}, RArr{rest}, SNil{}, IH2, {==},
    leOcc(pr(x, PTop{}), String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{})), SNil{}, pr(RArr{rest}, PTail{}), {==}),
    leOcc(pr(RArr{rest}, PTail{}), String.append(pr(x, PTop{}), pr(RArr{rest}, PTail{})), pr(x, PTop{}), SNil{}, app_congl(pr(x, PTop{}), String.append(pr(RArr{rest}, PTail{}), SNil{}), pr(RArr{rest}, PTail{}), append_nil(pr(RArr{rest}, PTail{})))))

# A member as pr writes it, and the members after it.
def rtMem(+gl: GL, +hg: {gl == GRAMMAR : GL}, +k: String, +v: Raw, +rest: List<&2, RMem>, +hk: {strok(k) == True{} : Bool}, +IHv: RTY(PTop{}, v), +IHr: RTY(PTail{}, RObj{rest}))
  -> {pv(1n+String.length(SCon{'"', String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}})}), MM{}, SCon{'"', String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}})}) == Some{PR{RObj{RMem{k, v} <> rest}, SNil{}}} : Maybe<&2, PR>}:
  %Equal.sym(Maybe<&2, SP>, str_scan(String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}), SN{}), Some{SP{k, SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}}, strC(gl, hg, k, SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}, strK(gl, hg, k, hk))) : {Maybe.bind(&2, SP, PR, _, +q => colon(skip_ws(spt(q)), w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}})), MV{}, skip_ws(w)), +p => ocons(spa(q), prr(p), pv(1n+String.length(String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}})), MO{}, skip_ws(prt(p))))))) == Some{PR{RObj{RMem{k, v} <> rest}, SNil{}}} : Maybe<&2, PR>}
  memCore(gl, hg, 1n+String.length(String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}})), k, pr(v, PTop{}), pr(RObj{rest}, PTail{}), v, SNil{}, IHv, {==}, RObj{rest}, SNil{},
    extNil(gl, hg, MO{}, skip_ws(pr(RObj{rest}, PTail{})), RObj{rest}, SNil{}, IHr, 1n+String.length(String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}})), {==},
      leOcc(pr(RObj{rest}, PTail{}), String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}), String.append(k, SCon{'"', SCon{':', pr(v, PTop{})}}), SNil{},
        Equal.trans(String, String.append(String.append(k, SCon{'"', SCon{':', pr(v, PTop{})}}), String.append(pr(RObj{rest}, PTail{}), SNil{})), String.append(String.append(k, SCon{'"', SCon{':', pr(v, PTop{})}}), pr(RObj{rest}, PTail{})), String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}),
          app_congl(String.append(k, SCon{'"', SCon{':', pr(v, PTop{})}}), String.append(pr(RObj{rest}, PTail{}), SNil{}), pr(RObj{rest}, PTail{}), append_nil(pr(RObj{rest}, PTail{}))),
          app3(k, SCon{'"', SCon{':', pr(v, PTop{})}}, pr(RObj{rest}, PTail{}))))),
    leOcc(pr(v, PTop{}), String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}), String.append(k, SCon{'"', SCon{':', SNil{}}}), pr(RObj{rest}, PTail{}), app3(k, SCon{'"', SCon{':', SNil{}}}, String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{})))))

def rtObj(+gl: GL, +hg: {gl == GRAMMAR : GL}, +k: String, +v: Raw, +rest: List<&2, RMem>, +hk: {strok(k) == True{} : Bool}, +IHv: RTY(PTop{}, v), +IHr: RTY(PTail{}, RObj{rest})) -> RTY(PTop{}, RObj{RMem{k, v} <> rest}):
  %Equal.sym(String, String.append(String.append(k, String.append("\":", pr(v, PTop{}))), pr(RObj{rest}, PTail{})), String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}), app3(k, String.append("\":", pr(v, PTop{})), pr(RObj{rest}, PTail{}))) : {pvc(MV{}, skip_ws(SCon{'{', SCon{'"', _}})) == Some{PR{RObj{RMem{k, v} <> rest}, SNil{}}} : Maybe<&2, PR>}
  rtMem(gl, hg, k, v, rest, hk, IHv, IHr)

def rtObjT(+gl: GL, +hg: {gl == GRAMMAR : GL}, +k: String, +v: Raw, +rest: List<&2, RMem>, +hk: {strok(k) == True{} : Bool}, +IHv: RTY(PTop{}, v), +IHr: RTY(PTail{}, RObj{rest})) -> RTY(PTail{}, RObj{RMem{k, v} <> rest}):
  %Equal.sym(String, String.append(String.append(k, String.append("\":", pr(v, PTop{}))), pr(RObj{rest}, PTail{})), String.append(k, SCon{'"', SCon{':', String.append(pr(v, PTop{}), pr(RObj{rest}, PTail{}))}}), app3(k, String.append("\":", pr(v, PTop{})), pr(RObj{rest}, PTail{}))) : {pvc(MO{}, skip_ws(SCon{',', SCon{'"', _}})) == Some{PR{RObj{RMem{k, v} <> rest}, SNil{}}} : Maybe<&2, PR>}
  rtMem(gl, hg, k, v, rest, hk, IHv, IHr)

# What pr writes, the parser reads back.
def RT(+gl: GL, +hg: {gl == GRAMMAR : GL}, r: Raw, m: PM, +h: IsTrue(wf(r))) -> RTY(m, r):
  match r:
    case RNull{}:
      match m:
        case PTop{}:
          {==}
        case PTail{}:
          Unit{}
    case RBool{b}:
      match b:
        case True{}:
          match m:
            case PTop{}:
              {==}
            case PTail{}:
              Unit{}
        case False{}:
          match m:
            case PTop{}:
              {==}
            case PTail{}:
              Unit{}
    case RNum{+s}:
      match m:
        case PTop{}:
          rtNum(gl, hg, s, ofTrue(numok(s), h))
        case PTail{}:
          Unit{}
    case RStr{+s}:
      match m:
        case PTop{}:
          cvStr.eq(gl, hg, s, strK(gl, hg, s, ofTrue(strok(s), h)))
        case PTail{}:
          Unit{}
    case RArr{xs}:
      match xs:
        case []:
          match m:
            case PTop{}:
              {==}
            case PTail{}:
              {==}
        case +x <> +rest:
          match m:
            case PTop{}:
              rtArr(gl, hg, x, rest, RT(gl, hg, x, PTop{}, andT1(wf(x), wf(RArr{rest}), h)), RT(gl, hg, RArr{rest}, PTail{}, andT2(wf(x), wf(RArr{rest}), h)))
            case PTail{}:
              rtArrT(gl, hg, x, rest, RT(gl, hg, x, PTop{}, andT1(wf(x), wf(RArr{rest}), h)), RT(gl, hg, RArr{rest}, PTail{}, andT2(wf(x), wf(RArr{rest}), h)))
    case RObj{ms}:
      match ms:
        case []:
          match m:
            case PTop{}:
              {==}
            case PTail{}:
              {==}
        case RMem{+k, +v} <> +rest:
          match m:
            case PTop{}:
              rtObj(gl, hg, k, v, rest, ofTrue(strok(k), andT1(strok(k), Bool.and(wf(v), wf(RObj{rest})), h)), RT(gl, hg, v, PTop{}, andT1(wf(v), wf(RObj{rest}), andT2(strok(k), Bool.and(wf(v), wf(RObj{rest})), h))), RT(gl, hg, RObj{rest}, PTail{}, andT2(wf(v), wf(RObj{rest}), andT2(strok(k), Bool.and(wf(v), wf(RObj{rest})), h))))
            case PTail{}:
              rtObjT(gl, hg, k, v, rest, ofTrue(strok(k), andT1(strok(k), Bool.and(wf(v), wf(RObj{rest})), h)), RT(gl, hg, v, PTop{}, andT1(wf(v), wf(RObj{rest}), andT2(strok(k), Bool.and(wf(v), wf(RObj{rest})), h))), RT(gl, hg, RObj{rest}, PTail{}, andT2(wf(v), wf(RObj{rest}), andT2(strok(k), Bool.and(wf(v), wf(RObj{rest})), h))))

def mkEq(+r: Raw, b: Bool, e: {wf(r) == b : Bool}, +h: IsTrue(wf(r))) -> {mk(r, b, e) == Some{J{r, h}} : Maybe<Js>}:
  match b:
    case True{}:
      Equal.cong(Js, Maybe<Js>, z => Some{z}, J{r, istrue(wf(r), e)}, J{r, h}, j_irr(r, istrue(wf(r), e), h))
    case False{}:
      Empty.absurd({mk(r, False{}, e) == Some{J{r, h}} : Maybe<Js>}, contra(wf(r), ofTrue(wf(r), h), e))

def load.ref.dump_ok(+gl: GL, +hg: {gl == GRAMMAR : GL}, j: Js) -> {load.ref(oDump(j)) == Some{j} : Maybe<Js>}:
  match j:
    case J{+r, +h}:
      %Equal.sym(Maybe<&2, PR>, pvc(MV{}, skip_ws(pr(r, PTop{}))), Some{PR{r, SNil{}}}, RT(gl, hg, r, PTop{}, h)) : {fin(_) == Some{J{r, h}} : Maybe<Js>}
      mkEq(r, wf(r), {==}, h)

def finT(+r: Raw, b: Bool, +h: {Maybe.is_some(&1, Js, fin2(r, b)) == True{} : Bool}) -> {b == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, false_ne_true(h))

def emptyWs(+t: String, +he: {String.is_empty(skip_ws(t)) == True{} : Bool}) -> {wsall(t) == True{} : Bool}:
  %WI(t) : {wsall(_) == True{} : Bool}
  %Equal.sym(String, skip_ws(t), SNil{}, emptyOf(skip_ws(t), he)) : {wsall(String.append(wsp(t), _)) == True{} : Bool}
  %Equal.sym(String, String.append(wsp(t), SNil{}), wsp(t), append_nil(wsp(t))) : {wsall(_) == True{} : Bool}
  WIa(t)

def loadF.q(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +t: String, +y: String, +ey: {String.append(y, t) == skip_ws(s) : String}, +hy: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("value"), y) == True{} : Bool}, +he: {String.is_empty(skip_ws(t)) == True{} : Bool})
  -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s) == True{} : Bool}:
  %WI(s) : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), _) == True{} : Bool}
  %ey : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), String.append(wsp(s), _)) == True{} : Bool}
  seqI3(ABNF.full(toList(gl)), ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws"), wsp(s), y, t, wsI(gl, hg, wsp(s), WIa(s)), hy, wsI(gl, hg, t, emptyWs(t, he)))

def loadF.p(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +p: PR, P: PSR(gl, hg, ABNF.ref("value"), Some{p}, skip_ws(s)),
  +h: {Maybe.is_some(&1, Js, fin2(prr(p), String.is_empty(skip_ws(prt(p))))) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s) == True{} : Bool}:
  (y, ey, hy, hw) = P
  loadF.q(gl, hg, s, prt(p), y, ey, hy, finT(prr(p), String.is_empty(skip_ws(prt(p))), h))

def loadF.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, res: Maybe<&2, PR>, P: PSR(gl, hg, ABNF.ref("value"), res, skip_ws(s)), +h: {Maybe.is_some(&1, Js, fin(res)) == True{} : Bool})
  -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s) == True{} : Bool}:
  match res:
    case None{}:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s) == True{} : Bool}, false_ne_true(h))
    case Some{+p}:
      loadF.p(gl, hg, s, p, P, h)

# What loads is JSON text.
def loadF(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +h: {Maybe.is_some(&1, Js, load.ref(s)) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s) == True{} : Bool}:
  loadF.go(gl, hg, s, pvc(MV{}, skip_ws(s)), Sound(gl, hg, 1n+String.length(skip_ws(s)), MV{}, skip_ws(s)), h)

def wsNil(s: String, +h: {wsall(s) == True{} : Bool}) -> {skip_ws(s) == SNil{} : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      %Equal.sym(String, skip_ws(SCon{c, t}), skip_ws(t), selT(String, isws(c), u => skip_ws(t), u => SCon{c, t}, and_l(isws(c), wsall(t), h))) : {_ == SNil{} : String}
      wsNil(t, and_r(isws(c), wsall(t), h))

def wfOf.p(+gl: GL, +hg: {gl == GRAMMAR : GL}, -S: String, +p: PR, P: PSR(gl, hg, ABNF.ref("value"), Some{p}, S), -r: Raw, -u: String, +e: {Some{p} == Some{PR{r, u}} : Maybe<&2, PR>})
  -> {wf(r) == True{} : Bool}:
  (y, ey, hy, hw) = P
  Equal.trans(Bool, wf(r), wf(prr(p)), True{}, Equal.cong(PR, Bool, z => wf(prr(z)), PR{r, u}, p, Equal.sym(PR, p, PR{r, u}, some_inj(&2, PR, p, PR{r, u}, e))), hw)

def wfOf.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, -S: String, res: Maybe<&2, PR>, P: PSR(gl, hg, ABNF.ref("value"), res, S), -r: Raw, -u: String, +e: {res == Some{PR{r, u}} : Maybe<&2, PR>}) -> {wf(r) == True{} : Bool}:
  match res:
    case None{}:
      Empty.absurd({wf(r) == True{} : Bool}, none_ne_some(&2, PR, PR{r, u}, e))
    case Some{+p}:
      wfOf.p(gl, hg, S, p, P, r, u, e)

# What the parser builds from a value is valid.
def wfOf(+gl: GL, +hg: {gl == GRAMMAR : GL}, +S: String, -r: Raw, -u: String, +e: {pvc(MV{}, S) == Some{PR{r, u}} : Maybe<&2, PR>}) -> {wf(r) == True{} : Bool}:
  wfOf.go(gl, hg, S, pvc(MV{}, S), Sound(gl, hg, 1n+String.length(S), MV{}, S), r, u, e)

def mkSome(+r: Raw, b: Bool, e: {wf(r) == b : Bool}, +hb: {b == True{} : Bool}) -> {Maybe.is_some(&1, Js, mk(r, b, e)) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({Maybe.is_some(&1, Js, mk(r, False{}, e)) == True{} : Bool}, false_ne_true(hb))

def loadB.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, +w1: String, +v: String, +w2: String, +es: {String.append(w1, String.append(v, w2)) == s : String}, +hw1: {wsall(w1) == True{} : Bool}, +hw2: {wsall(w2) == True{} : Bool},
  +r: Raw, +u: String, +e: {pvc(MV{}, skip_ws(v)) == Some{PR{r, u}} : Maybe<&2, PR>}, +wu: {wsall(u) == True{} : Bool}) -> {Maybe.is_some(&1, Js, load.ref(s)) == True{} : Bool}:
  %es : {Maybe.is_some(&1, Js, fin(pvc(MV{}, skip_ws(_)))) == True{} : Bool}
  %Equal.sym(String, skip_ws(String.append(w1, String.append(v, w2))), skip_ws(String.append(v, w2)), WE(w1, String.append(v, w2), hw1)) : {Maybe.is_some(&1, Js, fin(pvc(MV{}, _))) == True{} : Bool}
  %Equal.sym(String, skip_ws(String.append(v, w2)), String.append(skip_ws(v), w2), skipApp(v, w2, mvNE(1n+String.length(skip_ws(v)), skip_ws(v), PR{r, u}, e))) : {Maybe.is_some(&1, Js, fin(pvc(MV{}, _))) == True{} : Bool}
  %Equal.sym(Maybe<&2, PR>, pvc(MV{}, String.append(skip_ws(v), w2)), Some{PR{r, String.append(u, w2)}}, extApply(gl, hg, MV{}, skip_ws(v), r, u, e, w2, 1n+String.length(String.append(skip_ws(v), w2)), folWsPre(u, w2, wu, folWs(w2, hw2)), lePre(skip_ws(v), w2))) : {Maybe.is_some(&1, Js, fin(_)) == True{} : Bool}
  %Equal.sym(String, skip_ws(String.append(u, w2)), skip_ws(w2), WE(u, w2, wu)) : {Maybe.is_some(&1, Js, fin2(r, String.is_empty(_))) == True{} : Bool}
  %Equal.sym(String, skip_ws(w2), SNil{}, wsNil(w2, hw2)) : {Maybe.is_some(&1, Js, fin2(r, String.is_empty(_))) == True{} : Bool}
  mkSome(r, wf(r), {==}, wfOf(gl, hg, skip_ws(v), r, u, e))

def loadB.c(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, +w1: String, +v: String, +w2: String, +es: {String.append(w1, String.append(v, w2)) == s : String}, +hw1: {wsall(w1) == True{} : Bool}, +hw2: {wsall(w2) == True{} : Bool}, c: CR(CV{}, v))
  -> {Maybe.is_some(&1, Js, load.ref(s)) == True{} : Bool}:
  (r, u, e, wu) = c
  loadB.go(gl, hg, s, w1, v, w2, es, hw1, hw2, r, u, e, wu)

def loadB.d(+gl: GL, +hg: {gl == GRAMMAR : GL}, -s: String, +w1: String, +v: String, +w2: String, +es: {String.append(w1, String.append(v, w2)) == s : String}, +hw1: {wsall(w1) == True{} : Bool}, +hw2: {wsall(w2) == True{} : Bool},
  p: &d: Nat -> {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.ref("value"), v) == True{} : Bool}) -> {Maybe.is_some(&1, Js, load.ref(s)) == True{} : Bool}:
  (d, hd) = p
  loadB.c(gl, hg, s, w1, v, w2, es, hw1, hw2, Core(gl, hg, d, 0n, CV{}, v, hd))

# JSON text loads.
def loadB(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s) == True{} : Bool}) -> {Maybe.is_some(&1, Js, load.ref(s)) == True{} : Bool}:
  seqE3({Maybe.is_some(&1, Js, load.ref(s)) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws"), s, h, +w1 => +v => +w2 => +es => +h1 => +hv => +h3 =>
    loadB.d(gl, hg, s, w1, v, w2, es, wsE(gl, hg, w1, h1), wsE(gl, hg, w2, h3), ABNF.full.elim(toList(gl), ABNF.ref("value"), v, hv)))

def loadOk(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String) -> {Maybe.is_some(&1, Js, load.ref(s)) == ABNF.matches.era(toList(gl), "JSON-text", s) : Bool}:
  %Equal.sym(Bool, ABNF.matches.era(toList(gl), "JSON-text", s), ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("JSON-text"), s), mtEq(gl, hg, "JSON-text", s, ABNF.matches(toList(gl), "JSON-text", s), {==})) : {Maybe.is_some(&1, Js, load.ref(s)) == _ : Bool}
  %Equal.sym(Bool, ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("JSON-text"), s), ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s), MB(gl, hg, "JSON-text", ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s, {==})) : {Maybe.is_some(&1, Js, load.ref(s)) == _ : Bool}
  beq(Maybe.is_some(&1, Js, load.ref(s)), ABNF.check.era(ABNF.full(toList(gl)), ABNF.seq([ABNF.ref("ws"), ABNF.ref("value"), ABNF.ref("ws")]), s), +h => loadF(gl, hg, s, h), +h => loadB(gl, hg, s, h))

def loadOk2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String) -> {Maybe.is_some(&1, Js, load.ref(s)) == ABNF.matches.era(toList(gl), "JSON-text", s) : Bool}:
  Equal.trans(Bool, Maybe.is_some(&1, Js, load.ref(s)), Maybe.is_some(&1, Js, load.ref(s)), ABNF.matches.era(toList(gl), "JSON-text", s), {==}, loadOk(gl, hg, s))

def load.ref.ok(+gl: GL, +hg: {gl == GRAMMAR : GL}, s: String) -> {Maybe.is_some(&1, Js, load.ref(s)) == ABNF.matches.era(toList(gl), "JSON-text", s) : Bool}:
  loadOk2(gl, hg, s)

# Shapes
# ======

def wsM(+gl: GL, +hg: {gl == GRAMMAR : GL}, +s: String, +h: {ABNF.matches.era(toList(gl), "ws", s) == True{} : Bool}) -> {wsall(s) == True{} : Bool}:
  wsE(gl, hg, s, mt(gl, hg, "ws", s, h))

def tokM(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +ch: Char, +b: String, +e: {gsel(GRAMMAR, N) == [ABNF.seq([ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws")])] : List<ABNF.Rule>}, +hch: {isws(ch) == False{} : Bool}, +h: {ABNF.matches.era(toList(gl), N, b) == True{} : Bool}) -> {tokb(ch, b) == True{} : Bool}:
  tokE(gl, hg, N, ch, b, e, hch, mt(gl, hg, N, b, h))

# A value between whitespace parses as the value.
def wrapWs(+gl: GL, +hg: {gl == GRAMMAR : GL}, +w1: String, +v: String, +w2: String, +hw1: {wsall(w1) == True{} : Bool}, +hw2: {wsall(w2) == True{} : Bool}, +r: Raw, +u: String, +e: {pvc(MV{}, skip_ws(v)) == Some{PR{r, u}} : Maybe<&2, PR>}, +wu: {wsall(u) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(String.append(w1, String.append(v, w2)))) == Some{PR{r, String.append(u, w2)}} : Maybe<&2, PR>}:
  %Equal.sym(String, skip_ws(String.append(w1, String.append(v, w2))), skip_ws(String.append(v, w2)), WE(w1, String.append(v, w2), hw1)) : {pvc(MV{}, _) == Some{PR{r, String.append(u, w2)}} : Maybe<&2, PR>}
  %Equal.sym(String, skip_ws(String.append(v, w2)), String.append(skip_ws(v), w2), skipApp(v, w2, mvNE(1n+String.length(skip_ws(v)), skip_ws(v), PR{r, u}, e))) : {pvc(MV{}, _) == Some{PR{r, String.append(u, w2)}} : Maybe<&2, PR>}
  extApply(gl, hg, MV{}, skip_ws(v), r, u, e, w2, 1n+String.length(String.append(skip_ws(v), w2)), folWsPre(u, w2, wu, folWs(w2, hw2)), lePre(skip_ws(v), w2))

# A text the parser reads loads as what it builds.
def finEq(+gl: GL, +hg: {gl == GRAMMAR : GL}, +S: String, +r: Raw, +u: String, +e: {pvc(MV{}, skip_ws(S)) == Some{PR{r, u}} : Maybe<&2, PR>}, +wu: {wsall(u) == True{} : Bool}) -> {load.ref(S) == Some{J{r, istrue(wf(r), wfOf(gl, hg, skip_ws(S), r, u, e))}} : Maybe<Js>}:
  %Equal.sym(Maybe<&2, PR>, pvc(MV{}, skip_ws(S)), Some{PR{r, u}}, e) : {fin(_) == Some{J{r, istrue(wf(r), wfOf(gl, hg, skip_ws(S), r, u, e))}} : Maybe<Js>}
  %Equal.sym(String, skip_ws(u), SNil{}, wsNil(u, wu)) : {fin2(r, String.is_empty(_)) == Some{J{r, istrue(wf(r), wfOf(gl, hg, skip_ws(S), r, u, e))}} : Maybe<Js>}
  mkEq(r, wf(r), {==}, istrue(wf(r), wfOf(gl, hg, skip_ws(S), r, u, e)))

def litE(-w: String, -lit: String, -r: Raw, +e2: {w == lit : String}, +ok: {pvc(MV{}, skip_ws(lit)) == Some{PR{r, SNil{}}} : Maybe<&2, PR>}) -> {pvc(MV{}, skip_ws(w)) == Some{PR{r, SNil{}}} : Maybe<&2, PR>}:
  %Equal.sym(String, w, lit, e2) : {pvc(MV{}, skip_ws(_)) == Some{PR{r, SNil{}}} : Maybe<&2, PR>}
  ok

def quoteEq(-a: String, -c: String, +y: String, +ea: {a == SCon{'"', SNil{}} : String}, +ec: {c == SCon{'"', SNil{}} : String}) -> {SCon{'"', String.append(y, SCon{'"', SNil{}})} == String.append(a, String.append(y, c)) : String}:
  %Equal.sym(String, a, SCon{'"', SNil{}}, ea) : {SCon{'"', String.append(y, SCon{'"', SNil{}})} == String.append(_, String.append(y, c)) : String}
  %Equal.sym(String, c, SCon{'"', SNil{}}, ec) : {SCon{'"', String.append(y, SCon{'"', SNil{}})} == SCon{'"', String.append(y, _)} : String}
  {==}

def strX.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, -q1: String, +x: String, -q2: String, -a: String, +y: String, -c: String, +es: {String.append(a, String.append(y, c)) == String.append(q1, String.append(x, q2)) : String},
  +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +ea: {a == SCon{'"', SNil{}} : String}, +ec: {c == SCon{'"', SNil{}} : String}, +hy: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), y) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}:
  %snoc_cancel(y, x, '"', scon_tl('"', '"', String.append(y, SCon{'"', SNil{}}), String.append(x, SCon{'"', SNil{}}),
    Equal.trans(String, SCon{'"', String.append(y, SCon{'"', SNil{}})}, String.append(a, String.append(y, c)), SCon{'"', String.append(x, SCon{'"', SNil{}})}, quoteEq(a, c, y, ea, ec),
      Equal.trans(String, String.append(a, String.append(y, c)), String.append(q1, String.append(x, q2)), SCon{'"', String.append(x, SCon{'"', SNil{}})}, es, Equal.sym(String, SCon{'"', String.append(x, SCon{'"', SNil{}})}, String.append(q1, String.append(x, q2)), quoteEq(q1, q2, x, eq1, eq2)))))) : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), _) == True{} : Bool}
  hy

# The text between a string's quotation marks is a run of chars.
def strX(+gl: GL, +hg: {gl == GRAMMAR : GL}, +q1: String, +x: String, +q2: String, +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("string"), String.append(q1, String.append(x, q2))) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}:
  seqE3({ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("quotation-mark"), ABNF.rep.any(ABNF.ref("char")), ABNF.ref("quotation-mark"), String.append(q1, String.append(x, q2)), MBe(gl, hg, "string", ABNF.seq([ABNF.ref("quotation-mark"), ABNF.rep.any(ABNF.ref("char")), ABNF.ref("quotation-mark")]), String.append(q1, String.append(x, q2)), {==}, hx), +a => +y => +c => +es => +ha => +hy => +hc =>
    strX.go(gl, hg, q1, x, q2, a, y, c, es, eq1, eq2, charIs(ABNF.full(toList(gl)), '"', a, MBe(gl, hg, "quotation-mark", ABNF.char('"'), a, {==}, ha)), charIs(ABNF.full(toList(gl)), '"', c, MBe(gl, hg, "quotation-mark", ABNF.char('"'), c, {==}, hc)), hy))

def qmE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +q: String, +h: {ABNF.matches.era(toList(gl), "quotation-mark", q) == True{} : Bool}) -> {q == SCon{'"', SNil{}} : String}:
  charIs(ABNF.full(toList(gl)), '"', q, MBe(gl, hg, "quotation-mark", ABNF.char('"'), q, {==}, mt(gl, hg, "quotation-mark", q, h)))

def strQ(+gl: GL, +hg: {gl == GRAMMAR : GL}, -q1: String, +x: String, -q2: String, +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(String.append(q1, String.append(x, q2)))) == Some{PR{RStr{x}, SNil{}}} : Maybe<&2, PR>}:
  %Equal.sym(String, q1, SCon{'"', SNil{}}, eq1) : {pvc(MV{}, skip_ws(String.append(_, String.append(x, q2)))) == Some{PR{RStr{x}, SNil{}}} : Maybe<&2, PR>}
  %Equal.sym(String, q2, SCon{'"', SNil{}}, eq2) : {pvc(MV{}, skip_ws(SCon{'"', String.append(x, _)})) == Some{PR{RStr{x}, SNil{}}} : Maybe<&2, PR>}
  cvStr.eq(gl, hg, x, hx)

def withV.c(-C: Type, +v: String, c: CR(CV{}, v), k: @r: Raw -> @u: String -> {pvc(MV{}, skip_ws(v)) == Some{PR{r, u}} : Maybe<&2, PR>} -> {wsall(u) == True{} : Bool} -> C) -> C:
  (r, u, e, w) = c
  k(r, u, e, w)

def withV.d(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +v: String, p: &d: Nat -> {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.ref("value"), v) == True{} : Bool}, k: @r: Raw -> @u: String -> {pvc(MV{}, skip_ws(v)) == Some{PR{r, u}} : Maybe<&2, PR>} -> {wsall(u) == True{} : Bool} -> C) -> C:
  (d, hd) = p
  withV.c(C, v, Core(gl, hg, d, 0n, CV{}, v, hd), k)

# A value parses.
def withV(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +v: String, +hv: {ABNF.matches.era(toList(gl), "value", v) == True{} : Bool}, k: @r: Raw -> @u: String -> {pvc(MV{}, skip_ws(v)) == Some{PR{r, u}} : Maybe<&2, PR>} -> {wsall(u) == True{} : Bool} -> C) -> C:
  withV.d(gl, hg, C, v, ABNF.full.elim(toList(gl), ABNF.ref("value"), v, mt(gl, hg, "value", v, hv)), k)

def arrOneE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +b: String, +v: String, +e: String, +hb: {tokb('[', b) == True{} : Bool}, +he: {tokb(']', e) == True{} : Bool}, -r1: Raw, +u1: String, +e1: {pvc(MV{}, skip_ws(v)) == Some{PR{r1, u1}} : Maybe<&2, PR>}, +w1: {wsall(u1) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(String.append(b, String.append(v, e)))) == Some{PR{RArr{[r1]}, str_tl(skip_ws(e))}} : Maybe<&2, PR>}:
  %append_nil(v) : {pvc(MV{}, skip_ws(String.append(b, String.append(_, e)))) == Some{PR{RArr{[r1]}, str_tl(skip_ws(e))}} : Maybe<&2, PR>}
  cvArr.eq(gl, hg, b, v, SNil{}, e, hb, r1, u1, e1, w1, RArr{[]}, str_tl(skip_ws(e)), ca0.eq(e, he), tokW(']', e, he))

# An object's text from its opening bracket, given its first member's parts.
def objText(+gl: GL, +hg: {gl == GRAMMAR : GL}, +b: String, +x: String, +n: String, +v: String, +RE: String, +hb: {tokb('{', b) == True{} : Bool}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}, +hn: {tokb(':', n) == True{} : Bool},
  -r1: Raw, +u1: String, +e1: {pvc(MV{}, skip_ws(v)) == Some{PR{r1, u1}} : Maybe<&2, PR>}, +w1: {wsall(u1) == True{} : Bool}, -rO: Raw, +uO: String, +eO: {pvc(MO{}, skip_ws(RE)) == Some{PR{rO, uO}} : Maybe<&2, PR>}, +wO: {wsall(uO) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(String.append(b, SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})}))) == Some{PR{ocons1(x, r1, rO), uO}} : Maybe<&2, PR>}:
  %Equal.sym(String, skip_ws(String.append(b, SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})})), SCon{'{', String.append(str_tl(skip_ws(b)), SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})})}, tokU('{', b, SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})}, hb)) : {pv(1n+String.length(_), MV{}, _) == Some{PR{ocons1(x, r1, rO), uO}} : Maybe<&2, PR>}
  %Equal.sym(String, skip_ws(String.append(str_tl(skip_ws(b)), SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})})), skip_ws(SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})}), WE(str_tl(skip_ws(b)), SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})}, tokW('{', b, hb))) : {brk('}', _, w => Some{PR{RObj{[]}, w}}, w => pv(1n+String.length(String.append(str_tl(skip_ws(b)), SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})})), MM{}, w)) == Some{PR{ocons1(x, r1, rO), uO}} : Maybe<&2, PR>}
  extNil(gl, hg, MM{}, SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})}, ocons1(x, r1, rO), uO, cmm.eq(gl, hg, x, n, v, RE, hx, hn, r1, u1, e1, w1, rO, uO, eO, wO), 1n+String.length(String.append(str_tl(skip_ws(b)), SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})})), wO,
    leSuf(str_tl(skip_ws(b)), SCon{'"', String.append(x, SCon{'"', String.append(n, String.append(v, RE))})}))

# The text of a member's name, with its parts.
def keyText(+b: String, -k: String, +q1: String, +x: String, +q2: String, +T: String, +es: {String.append(q1, String.append(x, q2)) == k : String}, +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String})
  -> {String.append(b, SCon{'"', String.append(x, SCon{'"', T})}) == String.append(b, String.append(k, T)) : String}:
  %es : {String.append(b, SCon{'"', String.append(x, SCon{'"', T})}) == String.append(b, String.append(_, T)) : String}
  %Equal.sym(String, q1, SCon{'"', SNil{}}, eq1) : {String.append(b, SCon{'"', String.append(x, SCon{'"', T})}) == String.append(b, String.append(String.append(_, String.append(x, q2)), T)) : String}
  %Equal.sym(String, q2, SCon{'"', SNil{}}, eq2) : {String.append(b, SCon{'"', String.append(x, SCon{'"', T})}) == String.append(b, SCon{'"', String.append(String.append(x, _), T)}) : String}
  app_congl(b, SCon{'"', String.append(x, SCon{'"', T})}, SCon{'"', String.append(String.append(x, SCon{'"', SNil{}}), T)}, Equal.cong(String, String, z => SCon{'"', z}, String.append(x, SCon{'"', T}), String.append(String.append(x, SCon{'"', SNil{}}), T), Equal.sym(String, String.append(String.append(x, SCon{'"', SNil{}}), T), String.append(x, SCon{'"', T}), app3(x, SCon{'"', SNil{}}, T))))

def loOneE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +b: String, +k: String, +q1: String, +x: String, +q2: String, +n: String, +v: String, +e: String, +es: {String.append(q1, String.append(x, q2)) == k : String}, +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String},
  +hb: {tokb('{', b) == True{} : Bool}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool}, +hn: {tokb(':', n) == True{} : Bool}, +he: {tokb('}', e) == True{} : Bool}, -r1: Raw, +u1: String, +e1: {pvc(MV{}, skip_ws(v)) == Some{PR{r1, u1}} : Maybe<&2, PR>}, +w1: {wsall(u1) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(String.append(b, String.append(k, String.append(n, String.append(v, e)))))) == Some{PR{ocons1(x, r1, RObj{[]}), str_tl(skip_ws(e))}} : Maybe<&2, PR>}:
  %keyText(b, k, q1, x, q2, String.append(n, String.append(v, e)), es, eq1, eq2) : {pvc(MV{}, skip_ws(_)) == Some{PR{ocons1(x, r1, RObj{[]}), str_tl(skip_ws(e))}} : Maybe<&2, PR>}
  objText(gl, hg, b, x, n, v, e, hb, hx, hn, r1, u1, e1, w1, RObj{[]}, str_tl(skip_ws(e)), moZ.eq(e, he), tokW('}', e, he))

def kE(+gl: GL, +hg: {gl == GRAMMAR : GL}, -k: String, +q1: String, +x: String, +q2: String, +es: {String.append(q1, String.append(x, q2)) == k : String}, +eq1: {q1 == SCon{'"', SNil{}} : String}, +eq2: {q2 == SCon{'"', SNil{}} : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), x) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(k)) == Some{PR{RStr{x}, SNil{}}} : Maybe<&2, PR>}:
  %es : {pvc(MV{}, skip_ws(_)) == Some{PR{RStr{x}, SNil{}}} : Maybe<&2, PR>}
  strQ(gl, hg, q1, x, q2, eq1, eq2, hx)

def emptyAbs(-C: Type, +h: {False{} == True{} : Bool}) -> C:
  Empty.absurd(C, false_ne_true(h))

def aconsInv(-C: Type, -x: Raw, m: Maybe<&2, PR>, -q: PR, +h: {acons(x, m) == Some{q} : Maybe<&2, PR>}, k: @p: PR -> {m == Some{p} : Maybe<&2, PR>} -> {PR{acons1(x, prr(p)), prt(p)} == q : PR} -> C) -> C:
  match m:
    case None{}:
      Empty.absurd(C, none_ne_some(&2, PR, q, h))
    case Some{+p}:
      k(p, {==}, some_inj(&2, PR, PR{acons1(x, prr(p)), prt(p)}, q, h))

# A value and what MA reads after it.
def XInv(-C: Type, +F: Nat, +S: String, m: Maybe<&2, PR>, +em: {pv(F, MV{}, S) == m : Maybe<&2, PR>}, -q: PR, +h: {Maybe.bind(&2, PR, PR, m, +p => acons(prr(p), pv(F, MA{}, skip_ws(prt(p))))) == Some{q} : Maybe<&2, PR>},
  k: @p1: PR -> {pv(F, MV{}, S) == Some{p1} : Maybe<&2, PR>} -> @p2: PR -> {pv(F, MA{}, skip_ws(prt(p1))) == Some{p2} : Maybe<&2, PR>} -> {PR{acons1(prr(p1), prr(p2)), prt(p2)} == q : PR} -> C) -> C:
  match m:
    case None{}:
      Empty.absurd(C, none_ne_some(&2, PR, q, h))
    case Some{+p1}:
      aconsInv(C, prr(p1), pv(F, MA{}, skip_ws(prt(p1))), q, h, k(p1, em))

def XEq(+F: Nat, +S: String, -p1: PR, -p2: PR, +e1: {pv(F, MV{}, S) == Some{p1} : Maybe<&2, PR>}, +e2: {pv(F, MA{}, skip_ws(prt(p1))) == Some{p2} : Maybe<&2, PR>})
  -> {Maybe.bind(&2, PR, PR, pv(F, MV{}, S), +p => acons(prr(p), pv(F, MA{}, skip_ws(prt(p))))) == Some{PR{acons1(prr(p1), prr(p2)), prt(p2)}} : Maybe<&2, PR>}:
  %Equal.sym(Maybe<&2, PR>, pv(F, MV{}, S), Some{p1}, e1) : {Maybe.bind(&2, PR, PR, _, +p => acons(prr(p), pv(F, MA{}, skip_ws(prt(p))))) == Some{PR{acons1(prr(p1), prr(p2)), prt(p2)}} : Maybe<&2, PR>}
  %Equal.sym(Maybe<&2, PR>, pv(F, MA{}, skip_ws(prt(p1))), Some{p2}, e2) : {acons(prr(p1), _) == Some{PR{acons1(prr(p1), prr(p2)), prt(p2)}} : Maybe<&2, PR>}
  {==}

def prEta(p: PR) -> {PR{prr(p), prt(p)} == p : PR}:
  match p:
    case PR{r, t}:
      {==}

def mono.go(+f: Nat, +m: Md, +S: String, res: Maybe<&2, PR>, E: EXT(m, res, S, f), -p: PR, +e: {res == Some{p} : Maybe<&2, PR>}, +hf: {fol(prt(p)) == True{} : Bool}, +f2: Nat, +hl: {le(f, f2) == True{} : Bool}) -> {pv(f2, m, S) == Some{p} : Maybe<&2, PR>}:
  match res:
    case None{}:
      Empty.absurd({pv(f2, m, S) == Some{p} : Maybe<&2, PR>}, none_ne_some(&2, PR, p, e))
    case Some{+p0}:
      %some_inj(&2, PR, p0, p, e) : {pv(f2, m, S) == Some{_} : Maybe<&2, PR>}
      %prEta(p0) : {pv(f2, m, S) == Some{_} : Maybe<&2, PR>}
      %append_nil(S) : {pv(f2, m, _) == Some{PR{prr(p0), prt(p0)}} : Maybe<&2, PR>}
      %append_nil(prt(p0)) : {pv(f2, m, String.append(S, SNil{})) == Some{PR{prr(p0), _}} : Maybe<&2, PR>}
      E(SNil{}, f2, Equal.trans(Bool, fol(String.append(prt(p0), SNil{})), fol(prt(p)), True{}, Equal.trans(Bool, fol(String.append(prt(p0), SNil{})), fol(prt(p0)), fol(prt(p)), Equal.cong(String, Bool, z => fol(z), String.append(prt(p0), SNil{}), prt(p0), append_nil(prt(p0))), Equal.cong(PR, Bool, z => fol(prt(z)), p0, p, some_inj(&2, PR, p0, p, e))), hf), hl)

# A parse with some fuel gives the same result with more.
def mono(+gl: GL, +hg: {gl == GRAMMAR : GL}, +f: Nat, +m: Md, +S: String, -p: PR, +e: {pv(f, m, S) == Some{p} : Maybe<&2, PR>}, +hf: {fol(prt(p)) == True{} : Bool}, +f2: Nat, +hl: {le(f, f2) == True{} : Bool}) -> {pv(f2, m, S) == Some{p} : Maybe<&2, PR>}:
  mono.go(f, m, S, pv(f, m, S), Ext(gl, hg, f, m, S), p, e, hf, f2, hl)

def tokFol(+s: String, +X: String, +hs: {tokb(',', s) == True{} : Bool}) -> {fol(String.append(s, X)) == True{} : Bool}:
  %WI(s) : {fol(String.append(_, X)) == True{} : Bool}
  %Equal.sym(String, String.append(String.append(wsp(s), skip_ws(s)), X), String.append(wsp(s), String.append(skip_ws(s), X)), app3(wsp(s), skip_ws(s), X)) : {fol(_) == True{} : Bool}
  %Equal.sym(String, skip_ws(s), SCon{',', str_tl(skip_ws(s))}, tokU0(',', s, hs)) : {fol(String.append(wsp(s), String.append(_, X))) == True{} : Bool}
  folWsPre(wsp(s), SCon{',', String.append(str_tl(skip_ws(s)), X)}, WIa(s), {==})

def leIns(B: String, +M: String, +R: String, +hM: {String.is_empty(M) == False{} : Bool}) -> {le(1n+String.length(String.append(B, R)), String.length(String.append(B, String.append(M, R)))) == True{} : Bool}:
  match B:
    case SNil{}:
      match M:
        case SNil{}:
          emptyAbs({le(1n+String.length(R), String.length(R)) == True{} : Bool}, Equal.sym(Bool, True{}, False{}, hM))
        case SCon{c, M1}:
          leSuf(M1, R)
    case SCon{c, B1}:
      leIns(B1, M, R, hM)

def neVS(v: String, -s: String, +h: {String.is_empty(skip_ws(v)) == False{} : Bool}) -> {String.is_empty(String.append(v, s)) == False{} : Bool}:
  match v:
    case SNil{}:
      emptyAbs({String.is_empty(s) == False{} : Bool}, Equal.sym(Bool, True{}, False{}, h))
    case SCon{c, t}:
      {==}

def leCon(+B: String, +v: String, +s: String, +rest: String, +hv: {String.is_empty(skip_ws(v)) == False{} : Bool}) -> {le(1n+String.length(String.append(B, rest)), String.length(String.append(B, String.append(v, String.append(s, rest))))) == True{} : Bool}:
  %app3(v, s, rest) : {le(1n+String.length(String.append(B, rest)), String.length(String.append(B, _))) == True{} : Bool}
  leIns(B, String.append(v, s), rest, neVS(v, s, hv))

# Arrays with more elements
# =========================

# The parse of [v,rest: v, then what follows the comma.
def arrFull(+gl: GL, +hg: {gl == GRAMMAR : GL}, +b: String, +v: String, +s: String, +rest: String, +hb: {tokb('[', b) == True{} : Bool}, +hs: {tokb(',', s) == True{} : Bool}, -r1: Raw, +u1: String, +e1: {pvc(MV{}, skip_ws(v)) == Some{PR{r1, u1}} : Maybe<&2, PR>}, +w1: {wsall(u1) == True{} : Bool})
  -> {pvc(MV{}, skip_ws(String.append(b, String.append(v, String.append(s, rest))))) == acons(r1, Maybe.bind(&2, PR, PR, pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, skip_ws(rest)), +p => acons(prr(p), pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}:
  %Equal.sym(String, skip_ws(String.append(b, String.append(v, String.append(s, rest)))), SCon{'[', String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))}, tokU('[', b, String.append(v, String.append(s, rest)), hb)) : {pv(1n+String.length(_), MV{}, _) == acons(r1, Maybe.bind(&2, PR, PR, pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, skip_ws(rest)), +p => acons(prr(p), pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}
  %Equal.sym(String, skip_ws(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), skip_ws(String.append(v, String.append(s, rest))), WE(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)), tokW('[', b, hb))) : {brk(']', _, w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p)))))) == acons(r1, Maybe.bind(&2, PR, PR, pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, skip_ws(rest)), +p => acons(prr(p), pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}
  %Equal.sym(Maybe<&2, PR>, brk(']', skip_ws(String.append(v, String.append(s, rest))), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p)))))), Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, skip_ws(String.append(v, String.append(s, rest)))), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p))))), brkNot(v, String.append(s, rest), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p))))), r1, u1, e1)) : {_ == acons(r1, Maybe.bind(&2, PR, PR, pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MV{}, skip_ws(rest)), +p => acons(prr(p), pv(String.length(String.append(str_tl(skip_ws(b)), String.append(v, String.append(s, rest)))), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}
