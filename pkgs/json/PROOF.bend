def strC1.esc(+gl: GL, +hg: {gl == GRAMMAR : GL}, -a: String, -e1: String, +e2: String, +R: String, +e: {String.append(e1, e2) == a : String}, +ee: {SCon{'\\', SNil{}} == e1 : String}, +h2: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.char('"'), ABNF.char('\\'), ABNF.char('/'), ABNF.char('b'), ABNF.char('f'), ABNF.char('n'), ABNF.char('r'), ABNF.char('t'), ABNF.seq([ABNF.char('u'), ABNF.rep.exactly(4n, ABNF.core.hexdig)])]), e2) == True{} : Bool})
  -> {str_scan(String.append(a, R), SN{}) == appM(a, str_scan(R, SN{})) : Maybe<&2, SP>}:
