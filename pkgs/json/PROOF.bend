    withV(GRAMMAR, {==}, {R.le(String.append(b, String.append(k, String.append(n, String.append(v, e))))) == Some{VObj{[(key, x)]}} : Maybe<V>}, v, hyp("value", v, hv), +r1 => +u1 => +e1 => +w1 =>
      objOne(b, k, n, v, e, tokM(GRAMMAR, {==}, "begin-object", '{', b, {==}, {==}, hyp("begin-object", b, hb)), tokM(GRAMMAR, {==}, "name-separator", ':', n, {==}, {==}, hyp("name-separator", n, hn)), tokM(GRAMMAR, {==}, "end-object", '}', e, {==}, {==}, hyp("end-object", e, he)),
        q1, xs, q2, es, charIs(ABNF.full(toList(GRAMMAR)), '"', q1, MBe(GRAMMAR, {==}, "quotation-mark", ABNF.char('"'), q1, {==}, h1)), charIs(ABNF.full(toList(GRAMMAR)), '"', q2, MBe(GRAMMAR, {==}, "quotation-mark", ABNF.char('"'), q2, {==}, h3)), hxs,
        key, hkey, x, hx, r1, u1, e1, w1)))

# ==========================
# Loading arrays and objects
# ==========================

def mkInvV(+r: Raw, c: Bool, e: {wf(r) == c : Bool}, -w: V, +h: {lv(mk(r, c, e)) == Some{w} : Maybe<V>}) -> {rvM(r) == Some{w} : Maybe<V>}:
  match c:
    case True{}:
      h
    case False{}:
      Empty.absurd({rvM(r) == Some{w} : Maybe<V>}, none_ne_some(&1, V, w, h))

def fin2InvV(-C: Type, +q: PR, b: Bool, +eb: {String.is_empty(skip_ws(prt(q))) == b : Bool}, -w: V, +h: {lv(fin2(prr(q), b)) == Some{w} : Maybe<V>},
  k: {String.is_empty(skip_ws(prt(q))) == True{} : Bool} -> {rvM(prr(q)) == Some{w} : Maybe<V>} -> C) -> C:
  match b:
    case True{}:
      k(eb, mkInvV(prr(q), wf(prr(q)), {==}, w, h))
    case False{}:
      Empty.absurd(C, none_ne_some(&1, V, w, h))

# What a load to Some{w} parsed.
def lvInv(-C: Type, m: Maybe<&2, PR>, -w: V, +h: {lv(fin(m)) == Some{w} : Maybe<V>},
  k: @q: PR -> {m == Some{q} : Maybe<&2, PR>} -> {String.is_empty(skip_ws(prt(q))) == True{} : Bool} -> {rvM(prr(q)) == Some{w} : Maybe<V>} -> C) -> C:
  match m:
    case None{}:
      Empty.absurd(C, none_ne_some(&1, V, w, h))
    case Some{+q}:
      fin2InvV(C, q, String.is_empty(skip_ws(prt(q))), {==}, w, h, +he => +hr => k(q, {==}, he, hr))

# After an opening bracket, either its closing one or what follows.
def brkInv(-C: Type, +c: Char, u: String, -kc: String -> Maybe<&2, PR>, -ko: String -> Maybe<&2, PR>, -q: PR, +h: {brk(c, u, kc, ko) == Some{q} : Maybe<&2, PR>},
  f1: @w: String -> {kc(w) == Some{q} : Maybe<&2, PR>} -> C, f2: {ko(u) == Some{q} : Maybe<&2, PR>} -> C) -> C:
  match u:
    case SNil{}:
      f2(h)
    case SCon{+x, +w}:
      bcase(C, Char.is_eq(c, x),
        +hc => f1(w, Equal.trans(Maybe<&2, PR>, kc(w), brk(c, SCon{x, w}, kc, ko), Some{q}, Equal.sym(Maybe<&2, PR>, brk(c, SCon{x, w}, kc, ko), kc(w), selT(Maybe<&2, PR>, Char.is_eq(c, x), z => kc(w), z => ko(SCon{x, w}), hc)), h)),
        +hc => f2(Equal.trans(Maybe<&2, PR>, ko(SCon{x, w}), brk(c, SCon{x, w}, kc, ko), Some{q}, Equal.sym(Maybe<&2, PR>, brk(c, SCon{x, w}, kc, ko), ko(SCon{x, w}), selF(Maybe<&2, PR>, Char.is_eq(c, x), z => kc(w), z => ko(SCon{x, w}), hc)), h)))

def arrOpen(+b: String, +rest: String, +hb: {tokb('[', b) == True{} : Bool}) -> {pvc(MV{}, skip_ws(String.append(b, rest))) == brk(']', skip_ws(rest), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}:
  %Equal.sym(String, skip_ws(String.append(b, rest)), SCon{'[', String.append(str_tl(skip_ws(b)), rest)}, tokU('[', b, rest, hb)) : {pv(1n+String.length(_), MV{}, _) == brk(']', skip_ws(rest), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}
  %Equal.sym(String, skip_ws(String.append(str_tl(skip_ws(b)), rest)), skip_ws(rest), WE(str_tl(skip_ws(b)), rest, tokW('[', b, hb))) : {brk(']', _, w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MA{}, skip_ws(prt(p)))))) == brk(']', skip_ws(rest), w => Some{PR{RArr{[]}, w}}, w => Maybe.bind(&2, PR, PR, pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MV{}, w), +p => acons(prr(p), pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MA{}, skip_ws(prt(p)))))) : Maybe<&2, PR>}
  {==}

def objOpen(+b: String, +rest: String, +hb: {tokb('{', b) == True{} : Bool}) -> {pvc(MV{}, skip_ws(String.append(b, rest))) == brk('}', skip_ws(rest), w => Some{PR{RObj{[]}, w}}, w => pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MM{}, w)) : Maybe<&2, PR>}:
  %Equal.sym(String, skip_ws(String.append(b, rest)), SCon{'{', String.append(str_tl(skip_ws(b)), rest)}, tokU('{', b, rest, hb)) : {pv(1n+String.length(_), MV{}, _) == brk('}', skip_ws(rest), w => Some{PR{RObj{[]}, w}}, w => pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MM{}, w)) : Maybe<&2, PR>}
  %Equal.sym(String, skip_ws(String.append(str_tl(skip_ws(b)), rest)), skip_ws(rest), WE(str_tl(skip_ws(b)), rest, tokW('{', b, hb))) : {brk('}', _, w => Some{PR{RObj{[]}, w}}, w => pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MM{}, w)) == brk('}', skip_ws(rest), w => Some{PR{RObj{[]}, w}}, w => pv(1n+String.length(String.append(str_tl(skip_ws(b)), rest)), MM{}, w)) : Maybe<&2, PR>}
  {==}

def isArrM(m: Maybe<V>) -> Bool:
  match m:
    case Some{v}:
      match v:
        case VArr{a}:
          True{}
        case v:
          False{}
    case None{}:
      False{}

def isObjM(m: Maybe<V>) -> Bool:
  match m:
    case Some{v}:
      match v:
        case VObj{o}:
          True{}
        case v:
          False{}
    case None{}:
      False{}

def arrNE(m: Maybe<V>) -> Bool:
  match m:
    case Some{v}:
      match v:
        case VArr{a}:
          match a:
            case []:
              False{}
            case h <> t:
              True{}
        case v:
          False{}
    case None{}:
      False{}

def objNE(m: Maybe<V>) -> Bool:
  match m:
    case Some{v}:
      match v:
        case VObj{o}:
          match o:
            case []:
              False{}
            case h <> t:
              True{}
        case v:
          False{}
    case None{}:
      False{}

def notArr(-C: Type, -m: Maybe<V>, -l: List<V>, +h0: {isArrM(m) == False{} : Bool}, +h: {m == Some{VArr{l}} : Maybe<V>}) -> C:
  Empty.absurd(C, false_ne_true(Equal.trans(Bool, False{}, isArrM(m), True{}, Equal.sym(Bool, isArrM(m), False{}, h0), Equal.cong(Maybe<V>, Bool, isArrM, m, Some{VArr{l}}, h))))

def notObj(-C: Type, -m: Maybe<V>, -l: List<(TxtT & V)>, +h0: {isObjM(m) == False{} : Bool}, +h: {m == Some{VObj{l}} : Maybe<V>}) -> C:
  Empty.absurd(C, false_ne_true(Equal.trans(Bool, False{}, isObjM(m), True{}, Equal.sym(Bool, isObjM(m), False{}, h0), Equal.cong(Maybe<V>, Bool, isObjM, m, Some{VObj{l}}, h))))

def numV.na(m: Maybe<NumT>) -> {isArrM(numV(m)) == False{} : Bool} & {isObjM(numV(m)) == False{} : Bool}:
  match m:
    case None{}:
      ({==}, {==})
    case Some{n}:
      ({==}, {==})

def strV.na(m: Maybe<TxtT>) -> {isArrM(strV(m)) == False{} : Bool} & {isObjM(strV(m)) == False{} : Bool}:
  match m:
    case None{}:
      ({==}, {==})
    case Some{t}:
      ({==}, {==})

def consO.na(-m: TxtT & V, w: V) -> {isArrM(Some{consO(m, w)}) == False{} : Bool}:
  match w:
    case VNull{}:
      {==}
    case VBool{b}:
      {==}
    case VNum{n}:
      {==}
    case VStr{t}:
      {==}
    case VArr{a}:
      {==}
    case VObj{o}:
      {==}

def consA.no(-x: V, w: V) -> {isObjM(Some{consA(x, w)}) == False{} : Bool}:
  match w:
    case VNull{}:
      {==}
    case VBool{b}:
      {==}
    case VNum{n}:
      {==}
    case VStr{t}:
      {==}
    case VArr{a}:
      {==}
    case VObj{o}:
      {==}

def memM.na(k: Maybe<TxtT>, x: Maybe<V>, r: Maybe<V>) -> {isArrM(memM(k, x, r)) == False{} : Bool}:
  match k:
    case None{}:
      {==}
    case Some{kt}:
      match x:
        case None{}:
          {==}
        case Some{v}:
          match r:
            case None{}:
              {==}
            case Some{w}:
              consO.na((kt, v), w)

def consM.no(x: Maybe<V>, r: Maybe<V>) -> {isObjM(consM(x, r)) == False{} : Bool}:
  match x:
    case None{}:
      {==}
    case Some{v}:
      match r:
        case None{}:
          {==}
        case Some{w}:
          consA.no(v, w)

def first(-A: Type, -B: Type, p: A & B) -> A:
  match p:
    case (a, b):
      a

def second(-A: Type, -B: Type, p: A & B) -> B:
  match p:
    case (a, b):
      b

def objRaw.na(ms: List<&2, RMem>) -> {isArrM(rvM(RObj{ms})) == False{} : Bool}:
  match ms:
    case []:
      {==}
    case m <> rest:
      match m:
        case RMem{k, v}:
          memM.na(Laws.Text.make.try.era(Laws.decode.era(k)), rvM(v), rvM(RObj{rest}))

def arrRaw.no(xs: List<&2, Raw>) -> {isObjM(rvM(RArr{xs})) == False{} : Bool}:
  match xs:
    case []:
      {==}
    case x <> rest:
      consM.no(rvM(x), rvM(RArr{rest}))

# Putting an element in front of an array's elements.
def aconsRv(+r1: Raw, rq: Raw, -x: V, -l: List<V>, +h1: {rvM(r1) == Some{x} : Maybe<V>}, +h2: {rvM(rq) == Some{VArr{l}} : Maybe<V>}) -> {rvM(acons1(r1, rq)) == Some{VArr{x <> l}} : Maybe<V>}:
  match rq:
    case RNull{}:
      notArr({rvM(acons1(r1, RNull{})) == Some{VArr{x <> l}} : Maybe<V>}, Some{VNull{}}, l, {==}, h2)
    case RBool{bb}:
      notArr({rvM(acons1(r1, RBool{bb})) == Some{VArr{x <> l}} : Maybe<V>}, Some{VBool{bb}}, l, {==}, h2)
    case RNum{ns}:
      notArr({rvM(acons1(r1, RNum{ns})) == Some{VArr{x <> l}} : Maybe<V>}, rvM(RNum{ns}), l, first({isArrM(numV(Laws.Number.make.try.era(ns))) == False{} : Bool}, {isObjM(numV(Laws.Number.make.try.era(ns))) == False{} : Bool}, numV.na(Laws.Number.make.try.era(ns))), h2)
    case RStr{ss}:
      notArr({rvM(acons1(r1, RStr{ss})) == Some{VArr{x <> l}} : Maybe<V>}, rvM(RStr{ss}), l, first({isArrM(strV(Laws.Text.make.try.era(Laws.decode.era(ss)))) == False{} : Bool}, {isObjM(strV(Laws.Text.make.try.era(Laws.decode.era(ss)))) == False{} : Bool}, strV.na(Laws.Text.make.try.era(Laws.decode.era(ss)))), h2)
    case RArr{+rs}:
      %h2 : {consM(rvM(r1), rvM(RArr{rs})) == consM(Some{x}, _) : Maybe<V>}
      %h1 : {consM(rvM(r1), rvM(RArr{rs})) == consM(_, rvM(RArr{rs})) : Maybe<V>}
      {==}
    case RObj{ms}:
      notArr({rvM(acons1(r1, RObj{ms})) == Some{VArr{x <> l}} : Maybe<V>}, rvM(RObj{ms}), l, objRaw.na(ms), h2)

# Putting a member in front of an object's members.
def oconsRv(+xs: String, +r1: Raw, rq: Raw, -key: TxtT, -x: V, -l: List<(TxtT & V)>, +hk: {Laws.Text.make.try.era(Laws.decode.era(xs)) == Some{key} : Maybe<TxtT>}, +h1: {rvM(r1) == Some{x} : Maybe<V>}, +h2: {rvM(rq) == Some{VObj{l}} : Maybe<V>}) -> {rvM(ocons1(xs, r1, rq)) == Some{VObj{(key, x) <> l}} : Maybe<V>}:
  match rq:
    case RNull{}:
      notObj({rvM(ocons1(xs, r1, RNull{})) == Some{VObj{(key, x) <> l}} : Maybe<V>}, Some{VNull{}}, l, {==}, h2)
    case RBool{bb}:
      notObj({rvM(ocons1(xs, r1, RBool{bb})) == Some{VObj{(key, x) <> l}} : Maybe<V>}, Some{VBool{bb}}, l, {==}, h2)
    case RNum{ns}:
      notObj({rvM(ocons1(xs, r1, RNum{ns})) == Some{VObj{(key, x) <> l}} : Maybe<V>}, rvM(RNum{ns}), l, second({isArrM(numV(Laws.Number.make.try.era(ns))) == False{} : Bool}, {isObjM(numV(Laws.Number.make.try.era(ns))) == False{} : Bool}, numV.na(Laws.Number.make.try.era(ns))), h2)
    case RStr{ss}:
