                                case SCon{c2, r32}:
                                  match r32:
                                    case SNil{}:
                                      len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}} ++ e ++ "u" ++ SCon{a2, SCon{b2, SCon{c2, SNil{}}}} ++ t) == SCon{Chr{Extra.String.to_hex.era(SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}}, hx1)}, Laws.decode.era(e ++ "u" ++ SCon{a2, SCon{b2, SCon{c2, SNil{}}}} ++ t)} : String}, String.length(SCon{a2, SCon{b2, SCon{c2, SNil{}}}}), lx2, {==})
