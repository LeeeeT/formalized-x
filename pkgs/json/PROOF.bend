def eMM.fin(+gl: GL, +hg: {gl == GRAMMAR : GL}, +g: Nat, +t0: String, +q: SP, +eq1: {String.append(spa(q), SCon{'"', spt(q)}) == t0 : String}, +hk: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), spa(q)) == True{} : Bool}, +x: Char, +w: String, +eu: {skip_ws(spt(q)) == SCon{x, w} : String}, +hx: {Char.is_eq(':', x) == True{} : Bool},
