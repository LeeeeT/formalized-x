# What str_scan reads is a string's text, up to its closing quote.
def strS(+gl: GL, +hg: {gl == GRAMMAR : GL}, s: String, st: SS) -> SNS(gl, hg, str_scan(s, st), s, STR(st)):
  match s:
    case SNil{}:
      Unit{}
    case SCon{+c, +t}:
      match st:
        case SN{}:
          bcase(SNS(gl, hg, str_scan(SCon{c, t}, SN{}), SCon{c, t}, STR(SN{})), Char.is_eq('"', c), +h => strS.q(gl, hg, c, t, h),
            +h => bcase(SNS(gl, hg, str_scan(SCon{c, t}, SN{}), SCon{c, t}, STR(SN{})), Char.is_eq('\\', c), +h2 => strS.bs(gl, hg, c, t, h, h2, strS(gl, hg, t, SE{})),
              +h2 => bcase(SNS(gl, hg, str_scan(SCon{c, t}, SN{}), SCon{c, t}, STR(SN{})), isunesc(c), +h3 => strS.u(gl, hg, c, t, h, h2, h3, strS(gl, hg, t, SN{})), +h3 => strS.n(gl, hg, c, t, h, h2, h3))))
        case SE{}:
          bcase(SNS(gl, hg, str_scan(SCon{c, t}, SE{}), SCon{c, t}, STR(SE{})), issimple(c), +h => strS.es(gl, hg, c, t, h, strS(gl, hg, t, SN{})),
            +h => bcase(SNS(gl, hg, str_scan(SCon{c, t}, SE{}), SCon{c, t}, STR(SE{})), Char.is_eq('u', c), +h2 => strS.eu(gl, hg, c, t, h, h2, strS(gl, hg, t, SH{3n})), +h2 => strS.en(gl, hg, c, t, h, h2)))
        case SH{n}:
          match n:
            case 0n:
              bcase(SNS(gl, hg, str_scan(SCon{c, t}, SH{0n}), SCon{c, t}, STR(SH{0n})), ishex(c), +h => strS.h0(gl, hg, c, t, h, strS(gl, hg, t, SN{})), +h => strS.hn(gl, hg, c, 0n, t, h))
            case 1n+ +n1:
              bcase(SNS(gl, hg, str_scan(SCon{c, t}, SH{1n+n1}), SCon{c, t}, STR(SH{1n+n1})), ishex(c), +h => strS.h1(gl, hg, c, n1, t, h, strS(gl, hg, t, SH{n1})), +h => strS.hn(gl, hg, c, 1n+n1, t, h))

def prepApp(+c: Char, m: Maybe<&2, SP>) -> {prepM(c, m) == appM(SCon{c, SNil{}}, m) : Maybe<&2, SP>}:
  match m:
    case None{}:
      {==}
    case Some{SP{+part_a, +part_t}}:
      {==}

def prepApp2(+c1: Char, +c2: Char, m: Maybe<&2, SP>) -> {prepM(c1, prepM(c2, m)) == appM(SCon{c1, SCon{c2, SNil{}}}, m) : Maybe<&2, SP>}:
  match m:
    case None{}:
      {==}
    case Some{SP{+part_a, +part_t}}:
      {==}

def prepApp6(+c1: Char, +c2: Char, +c3: Char, +c4: Char, +c5: Char, +c6: Char, m: Maybe<&2, SP>) -> {prepM(c1, prepM(c2, prepM(c3, prepM(c4, prepM(c5, prepM(c6, m)))))) == appM(SCon{c1, SCon{c2, SCon{c3, SCon{c4, SCon{c5, SCon{c6, SNil{}}}}}}}, m) : Maybe<&2, SP>}:
  match m:
    case None{}:
      {==}
    case Some{SP{+part_a, +part_t}}:
      {==}

def strH(+x: Char, -X: String, +n: Nat, +h: {ishex(x) == True{} : Bool}) -> {str_scan(SCon{x, X}, SH{n}) == prepM(x, str_scan(X, hnext(n))) : Maybe<&2, SP>}:
  selT(Maybe<&2, SP>, ishex(x), u => prepM(x, str_scan(X, hnext(n))), u => None{}, h)

