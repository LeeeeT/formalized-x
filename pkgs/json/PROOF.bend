def not_ft(b: Bool, +h: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  match b:
    case True{}:
      Empty.absurd({False{} == True{} : Bool}, false_ne_true(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      {==}

def not_tf(b: Bool, +h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, false_ne_true(h))
    case False{}:
      {==}

# If c is x, then P(c) is what P(x) computes to.
def contraEq(+x: Char, +c: Char, -P: Char -> Bool, +hp: {P(c) == True{} : Bool}, +hx: {P(x) == False{} : Bool}) -> {Char.is_eq(x, c) == False{} : Bool}:
  bcase({Char.is_eq(x, c) == False{} : Bool}, Char.is_eq(x, c),
    +kk => Empty.absurd({Char.is_eq(x, c) == False{} : Bool}, false_ne_true(Equal.trans(Bool, False{}, P(x), True{}, Equal.sym(Bool, P(x), False{}, hx), Equal.trans(Bool, P(x), P(c), True{}, Equal.cong(Char, Bool, z => P(z), x, c, char_eq(x, c, kk)), hp)))),
    +kk => kk)

def dig_sign(+c: Char, +h: {isdig(c) == True{} : Bool}) -> {issign(c) == False{} : Bool}:
  bcase({issign(c) == False{} : Bool}, issign(c),
    +kk => Empty.absurd({issign(c) == False{} : Bool}, contra(isdig(c), h, sign_dig(c, kk))),
    +kk => kk)

def fol_nd(t: String, +h: {fol(t) == True{} : Bool}) -> {nd(t) == True{} : Bool}:
  match t:
    case SNil{}:
      {==}
    case SCon{+c, r}:
      not_ft(isdig(c), fol_dig(c, h))

def fol_notdot(t: String, +h: {fol(t) == True{} : Bool}) -> {notdot(t) == True{} : Bool}:
  match t:
    case SNil{}:
      {==}
    case SCon{+c, r}:
      not_ft(Char.is_eq('.', c), fol_dot(c, h))

# Numbers, back
# =============

def digC0(t: String, +ht: {nd(t) == True{} : Bool}) -> {digits(t) == SP{SNil{}, t} : SP}:
  match t:
    case SNil{}:
      {==}
    case SCon{+c, +r}:
      selF(SP, isdig(c), u => prepS(c, digits(r)), u => SP{SNil{}, SCon{c, r}}, not_tf(isdig(c), ht))

def digC.step(+c: Char, -x: String, +y: String, -a: String, +t: String, +e: {String.append(x, y) == a : String}, +ec: {SCon{c, SNil{}} == x : String}, +hc: {isdig(c) == True{} : Bool}, +ih: {digits(String.append(y, t)) == SP{y, t} : SP})
  -> {digits(String.append(a, t)) == SP{a, t} : SP}:
  %e : {digits(String.append(_, t)) == SP{_, t} : SP}
  %ec : {digits(String.append(String.append(_, y), t)) == SP{String.append(_, y), t} : SP}
  %Equal.sym(SP, digits(SCon{c, String.append(y, t)}), prepS(c, digits(String.append(y, t))), selT(SP, isdig(c), u => prepS(c, digits(String.append(y, t))), u => SP{SNil{}, SCon{c, String.append(y, t)}}, hc)) : {_ == SP{SCon{c, y}, t} : SP}
  %Equal.sym(SP, digits(String.append(y, t)), SP{y, t}, ih) : {prepS(c, _) == SP{SCon{c, y}, t} : SP}
  {==}

def digC.m(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Nat, +a: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.exactly(m, ABNF.core.digit), a) == True{} : Bool}, +ht: {nd(t) == True{} : Bool}) -> {digits(String.append(a, t)) == SP{a, t} : SP}:
  match m:
    case 0n:
      %Equal.sym(String, a, SNil{}, emptyE(ABNF.full(toList(gl)), a, exZe(ABNF.full(toList(gl)), ABNF.core.digit, a, h))) : {digits(String.append(_, t)) == SP{_, t} : SP}
      digC0(t, ht)
    case 1n+ +m1:
      seqE2({digits(String.append(a, t)) == SP{a, t} : SP}, ABNF.full(toList(gl)), ABNF.core.digit, ABNF.rep.exactly(m1, ABNF.core.digit), a, exSe(ABNF.full(toList(gl)), m1, ABNF.core.digit, a, h), +x => +y => +e => +hx => +hy =>
        one({digits(String.append(a, t)) == SP{a, t} : SP}, ABNF.full(toList(gl)), ABNF.core.digit, x, hx, cd0(ABNF.full(toList(gl))), z1 => z2 => z3 => cd2(ABNF.full(toList(gl)), z1, z2, z3), +c => +ec => +hc =>
          digC.step(c, x, y, a, t, e, ec, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.core.digit, SCon{c, SNil{}}), inR('0', '9', c), cd1(ABNF.full(toList(gl)), c), hc), digC.m(gl, hg, m1, y, t, hy, ht))))

def digC.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, +t: String, p: &m: Nat -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.exactly(m, ABNF.core.digit), a) == True{} : Bool}, +ht: {nd(t) == True{} : Bool}) -> {digits(String.append(a, t)) == SP{a, t} : SP}:
  (m, h) = p
  digC.m(gl, hg, m, a, t, h, ht)

# A run of digits followed by a non-digit is read whole.
def digC(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.core.digit), a) == True{} : Bool}, +ht: {nd(t) == True{} : Bool}) -> {digits(String.append(a, t)) == SP{a, t} : SP}:
  digC.go(gl, hg, a, t, ABNF.rep.any.elim(ABNF.full(toList(gl)), ABNF.core.digit, a, h), ht)

# AL1 decomposed: its first digit, and the rest.
def al1H(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +a: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.at_least(1n, ABNF.core.digit), a) == True{} : Bool}, f: @c: Char -> @y: String -> {SCon{c, y} == a : String} -> {isdig(c) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.core.digit), y) == True{} : Bool} -> C) -> C:
  seqE2(C, ABNF.full(toList(gl)), ABNF.core.digit, ABNF.rep.any(ABNF.core.digit), a, atl1E(ABNF.full(toList(gl)), ABNF.core.digit, a, h), +x => +y => +e => +hx => +hy =>
    one(C, ABNF.full(toList(gl)), ABNF.core.digit, x, hx, cd0(ABNF.full(toList(gl))), z1 => z2 => z3 => cd2(ABNF.full(toList(gl)), z1, z2, z3), +c => +ec => +hc =>
      f(c, y, Equal.trans(String, SCon{c, y}, String.append(x, y), a, app_congr(y, SCon{c, SNil{}}, x, ec), e), tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.core.digit, SCon{c, SNil{}}), inR('0', '9', c), cd1(ABNF.full(toList(gl)), c), hc), hy)))

def dig1Cm.go(+c: Char, +y: String, -a: String, +t: String, +e: {SCon{c, y} == a : String}, +hc: {isdig(c) == True{} : Bool}, +hy: {digits(String.append(y, t)) == SP{y, t} : SP})
  -> {dig1(digits(String.append(a, t))) == Some{SP{a, t}} : Maybe<&2, SP>}:
  %e : {dig1(digits(String.append(_, t))) == Some{SP{_, t}} : Maybe<&2, SP>}
  %Equal.sym(SP, digits(SCon{c, String.append(y, t)}), prepS(c, digits(String.append(y, t))), selT(SP, isdig(c), u => prepS(c, digits(String.append(y, t))), u => SP{SNil{}, SCon{c, String.append(y, t)}}, hc)) : {dig1(_) == Some{SP{SCon{c, y}, t}} : Maybe<&2, SP>}
  %Equal.sym(SP, digits(String.append(y, t)), SP{y, t}, hy) : {dig1(prepS(c, _)) == Some{SP{SCon{c, y}, t}} : Maybe<&2, SP>}
  {==}

def dig1Cm(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, +t: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.at_least(1n, ABNF.core.digit), a) == True{} : Bool}, +ht: {nd(t) == True{} : Bool}) -> {dig1(digits(String.append(a, t))) == Some{SP{a, t}} : Maybe<&2, SP>}:
  al1H(gl, hg, {dig1(digits(String.append(a, t))) == Some{SP{a, t}} : Maybe<&2, SP>}, a, h, +c => +y => +e => +hc => +hy => dig1Cm.go(c, y, a, t, e, hc, digC(gl, hg, y, t, hy, ht)))

def eref0(+gl: GL, +hg: {gl == GRAMMAR : GL}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("e"), SNil{}) == False{} : Bool}:
  Equal.trans(Bool, ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("e"), SNil{}), ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.char('e'), ABNF.char('E')]), SNil{}), False{},
    MB(gl, hg, "e", ABNF.alt([ABNF.char('e'), ABNF.char('E')]), SNil{}, {==}),
    alt2F(ABNF.full(toList(gl)), ABNF.char('e'), [ABNF.char('E')], SNil{}, ABNF.char.nil(ABNF.full(toList(gl)), 'e'), alt2F(ABNF.full(toList(gl)), ABNF.char('E'), [], SNil{}, ABNF.char.nil(ABNF.full(toList(gl)), 'E'), ABNF.alt.nil(ABNF.full(toList(gl)), SNil{}))))

def eref2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: Char, +b: Char, +t: String) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("e"), SCon{a, SCon{b, t}}) == False{} : Bool}:
