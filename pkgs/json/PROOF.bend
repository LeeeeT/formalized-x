                      dech2(GRAMMAR, {==}, e, SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, t, a, b, c, d, {==}, hyp("escape", e, he), F.toIS(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, hx), F.cvB(a, b, c, d, hx, v => Bool.and(U32.is_ge(v, 55296), U32.is_le(v, 56319)), hs), ht)
                    case SCon{f, r5}:
                      len4ne({Laws.decode.era(e ++ "u" ++ SCon{a, SCon{b, SCon{c, SCon{d, SCon{f, r5}}}}} ++ t) == SCon{Chr{Extra.String.to_hex.era(SCon{a, SCon{b, SCon{c, SCon{d, SCon{f, r5}}}}}, hx)}, Laws.decode.era(t)} : String}, String.length(SCon{a, SCon{b, SCon{c, SCon{d, SCon{f, r5}}}}}), lx, {==})

def Laws.decode.pair(e, x1, x2, t, he, hx1, lx1, hx2, lx2, hs1, hs2):
  match x1:
    case SNil{}:
      len4ne({Laws.decode.era(e ++ "u" ++ SNil{} ++ e ++ "u" ++ x2 ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SNil{}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(x2, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SNil{}), lx1, {==})
    case SCon{a1, r11}:
      match r11:
        case SNil{}:
          len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SNil{}} ++ e ++ "u" ++ x2 ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SNil{}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(x2, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SCon{a1, SNil{}}), lx1, {==})
        case SCon{b1, r21}:
          match r21:
            case SNil{}:
              len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SNil{}}} ++ e ++ "u" ++ x2 ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SCon{b1, SNil{}}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(x2, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SCon{a1, SCon{b1, SNil{}}}), lx1, {==})
            case SCon{c1, r31}:
              match r31:
                case SNil{}:
                  len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SCon{c1, SNil{}}}} ++ e ++ "u" ++ x2 ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SCon{b1, SCon{c1, SNil{}}}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(x2, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SCon{a1, SCon{b1, SCon{c1, SNil{}}}}), lx1, {==})
                case SCon{d1, r41}:
                  match r41:
                    case SNil{}:
                      match x2:
                        case SNil{}:
                          len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}} ++ e ++ "u" ++ SNil{} ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(SNil{}, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SNil{}), lx2, {==})
                        case SCon{a2, r12}:
                          match r12:
                            case SNil{}:
                              len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}} ++ e ++ "u" ++ SCon{a2, SNil{}} ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(SCon{a2, SNil{}}, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SCon{a2, SNil{}}), lx2, {==})
                            case SCon{b2, r22}:
                              match r22:
                                case SNil{}:
                                  len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}} ++ e ++ "u" ++ SCon{a2, SCon{b2, SNil{}}} ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(SCon{a2, SCon{b2, SNil{}}}, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SCon{a2, SCon{b2, SNil{}}}), lx2, {==})
                                case SCon{c2, r32}:
                                  match r32:
                                    case SNil{}:
                                      len4ne({Laws.decode.era(e ++ "u" ++ SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}} ++ e ++ "u" ++ SCon{a2, SCon{b2, SCon{c2, SNil{}}}} ++ t) == SCon{Chr{(65536 + (Extra.String.to_hex.era(SCon{a1, SCon{b1, SCon{c1, SCon{d1, SNil{}}}}}, hx1) - 55296) * 1024 + (Extra.String.to_hex.era(SCon{a2, SCon{b2, SCon{c2, SNil{}}}}, hx2) - 56320) : U32)}, Laws.decode.era(t)} : String}, String.length(SCon{a2, SCon{b2, SCon{c2, SNil{}}}}), lx2, {==})
                                    case SCon{d2, r42}:
                                      match r42:
                                        case SNil{}:
                                          +a1 = a1
                                          +b1 = b1
                                          +c1 = c1
                                          +d1 = d1
                                          +a2 = a2
                                          +b2 = b2
                                          +c2 = c2
                                          +d2 = d2
                                          +hx1 = hx1
                                          +hx2 = hx2
