def strText(+gl: GL, +hg: {gl == GRAMMAR : GL}, +a: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.ref("char")), a) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("string"), SCon{'"', String.append(a, SCon{'"', SNil{}})}) == True{} : Bool}:
