def starConsH(+k: ABNF.Book, +r: ABNF.Rule, +c: Char, +b: String, +ha: {ABNF.check.era(k, r, SCon{c, SNil{}}) == True{} : Bool}, +hb: {ABNF.check.era(k, ABNF.rep.any(r), b) == True{} : Bool})
  -> {ABNF.check.era(k, ABNF.rep.any(r), SCon{c, b}) == True{} : Bool}:
  starCons(k, r, SCon{c, SNil{}}, b, ha, hb)

def starConsX(+k: ABNF.Book, +r: ABNF.Rule, +c: Char, +x: String, +b: String, +ha: {ABNF.check.era(k, r, SCon{c, x}) == True{} : Bool}, +hb: {ABNF.check.era(k, ABNF.rep.any(r), b) == True{} : Bool})
  -> {ABNF.check.era(k, ABNF.rep.any(r), SCon{c, String.append(x, b)}) == True{} : Bool}:
  starCons(k, r, SCon{c, x}, b, ha, hb)

def starCase.m(-C: Type, +k: ABNF.Book, +r: ABNF.Rule, +s: String, m: Nat, +hm: {ABNF.check.era(k, ABNF.rep.exactly(m, r), s) == True{} : Bool},
  fn: {s == SNil{} : String} -> C,
  fc: @a: String -> @b: String -> {String.append(a, b) == s : String} -> {ABNF.check.era(k, r, a) == True{} : Bool} -> {ABNF.check.era(k, ABNF.rep.any(r), b) == True{} : Bool} -> C) -> C:
  match m:
    case 0n:
      fn(emptyE(k, s, exZe(k, r, s, hm)))
    case 1n+ +m1:
      seqE2(C, k, r, ABNF.rep.exactly(m1, r), s, exSe(k, m1, r, s, hm), a => +b => +e => ha => hb => fc(a, b, e, ha, ABNF.rep.any.intro(k, m1, r, b, hb)))

def starCase.go(-C: Type, +k: ABNF.Book, +r: ABNF.Rule, +s: String, p: &m: Nat -> {ABNF.check.era(k, ABNF.rep.exactly(m, r), s) == True{} : Bool},
  fn: {s == SNil{} : String} -> C,
  fc: @a: String -> @b: String -> {String.append(a, b) == s : String} -> {ABNF.check.era(k, r, a) == True{} : Bool} -> {ABNF.check.era(k, ABNF.rep.any(r), b) == True{} : Bool} -> C) -> C:
  (m, hm) = p
  starCase.m(C, k, r, s, m, hm, fn, fc)

# A repetition is empty, or one more and a repetition.
def starCase(-C: Type, +k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.rep.any(r), s) == True{} : Bool},
  fn: {s == SNil{} : String} -> C,
  fc: @a: String -> @b: String -> {String.append(a, b) == s : String} -> {ABNF.check.era(k, r, a) == True{} : Bool} -> {ABNF.check.era(k, ABNF.rep.any(r), b) == True{} : Bool} -> C) -> C:
  starCase.go(C, k, r, s, ABNF.rep.any.elim(k, r, s, h), fn, fc)

def optE(-C: Type, +k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.opt(r), s) == True{} : Bool},
  fn: {s == SNil{} : String} -> C, fs: {ABNF.check.era(k, r, s) == True{} : Bool} -> C) -> C:
  either(&2, &2, {ABNF.check.era(k, ABNF.empty, s) == True{} : Bool}, {ABNF.check.era(k, ABNF.alt([r]), s) == True{} : Bool}, C,
    or_elim(ABNF.check.era(k, ABNF.empty, s), ABNF.check.era(k, ABNF.alt([r]), s), tt.sym(ABNF.check.era(k, ABNF.opt(r), s), Bool.or(ABNF.check.era(k, ABNF.empty, s), ABNF.check.era(k, ABNF.alt([r]), s)), Equal.trans(Bool, ABNF.check.era(k, ABNF.opt(r), s), ABNF.check.era(k, ABNF.alt([ABNF.empty, r]), s), Bool.or(ABNF.check.era(k, ABNF.empty, s), ABNF.check.era(k, ABNF.alt([r]), s)), ABNF.opt.ok(k, r, s), ABNF.alt.con(k, s, ABNF.empty, [r])), h)),
    +he => fn(emptyE(k, s, he)),
    +hr => fs(tt.sym(ABNF.check.era(k, ABNF.alt([r]), s), ABNF.check.era(k, r, s), altS(k, r, s), hr)))

def optN(+k: ABNF.Book, +r: ABNF.Rule) -> {ABNF.check.era(k, ABNF.opt(r), SNil{}) == True{} : Bool}:
  tt(ABNF.check.era(k, ABNF.opt(r), SNil{}), Bool.or(ABNF.check.era(k, ABNF.empty, SNil{}), ABNF.check.era(k, ABNF.alt([r]), SNil{})), Equal.trans(Bool, ABNF.check.era(k, ABNF.opt(r), SNil{}), ABNF.check.era(k, ABNF.alt([ABNF.empty, r]), SNil{}), Bool.or(ABNF.check.era(k, ABNF.empty, SNil{}), ABNF.check.era(k, ABNF.alt([r]), SNil{})), ABNF.opt.ok(k, r, SNil{}), ABNF.alt.con(k, SNil{}, ABNF.empty, [r])),
    or_l(ABNF.check.era(k, ABNF.empty, SNil{}), ABNF.check.era(k, ABNF.alt([r]), SNil{}), ABNF.empty.nil(k)))

def optS(+k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, r, s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.opt(r), s) == True{} : Bool}:
  tt(ABNF.check.era(k, ABNF.opt(r), s), Bool.or(ABNF.check.era(k, ABNF.empty, s), ABNF.check.era(k, ABNF.alt([r]), s)), Equal.trans(Bool, ABNF.check.era(k, ABNF.opt(r), s), ABNF.check.era(k, ABNF.alt([ABNF.empty, r]), s), Bool.or(ABNF.check.era(k, ABNF.empty, s), ABNF.check.era(k, ABNF.alt([r]), s)), ABNF.opt.ok(k, r, s), ABNF.alt.con(k, s, ABNF.empty, [r])),
    or_r(ABNF.check.era(k, ABNF.empty, s), ABNF.check.era(k, ABNF.alt([r]), s), tt(ABNF.check.era(k, ABNF.alt([r]), s), ABNF.check.era(k, r, s), altS(k, r, s), h)))

# References
# ==========

def ufA.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, d: Nat, +N: String, +s: String, +h: {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.ref(N), s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s) == True{} : Bool}:
  match d:
    case 0n:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s) == True{} : Bool}, contra(ABNF.check.era(ABNF.limit(0n, toList(gl)), ABNF.ref(N), s), h, ABNF.ref.zero(toList(gl), N, s)))
    case 1n+ +d1:
      ABNF.full.intro(d1, toList(gl), ABNF.lookup.era(toList(gl), N), s,
        tt.sym(ABNF.check.era(ABNF.limit(1n+d1, toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.limit(d1, toList(gl)), ABNF.lookup.era(toList(gl), N), s), ABNF.ref.succ(toList(gl), N, s, d1), h))

def ufA(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +s: String, p: &d: Nat -> {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.ref(N), s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s) == True{} : Bool}:
  (d, h) = p
  ufA.go(gl, hg, d, N, s, h)

def ufB(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +s: String, p: &d: Nat -> {ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.lookup.era(toList(gl), N), s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == True{} : Bool}:
  (+d, h) = p
  ABNF.full.intro(1n+d, toList(gl), ABNF.ref(N), s,
    tt(ABNF.check.era(ABNF.limit(1n+d, toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.lookup.era(toList(gl), N), s), ABNF.ref.succ(toList(gl), N, s, d), h))

def unfold1(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +s: String) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s) : Bool}:
  beq(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s),
    +h => ufA(gl, hg, N, s, ABNF.full.elim(toList(gl), ABNF.ref(N), s, h)),
    +h => ufB(gl, hg, N, s, ABNF.full.elim(toList(gl), ABNF.lookup.era(toList(gl), N), s, h)))

def anyIf(c: Bool, -X: Bool, -Y: Bool, +ih: {X == Y : Bool}) -> {List.any.if(u => X, c) == Bool.or(c, Y) : Bool}:
  match c:
    case False{}:
      ih
    case True{}:
      {==}

def lkStep(+book: ABNF.Book, b: Bool, +r: ABNF.Rule, -L: List<ABNF.Rule>, +s: String, -X: Bool, +ih: {X == galt(book, L, s) : Bool})
  -> {List.any.if(u => X, Bool.and(b, ABNF.check.era(book, r, s))) == galt(book, gselC(b, r, L), s) : Bool}:
  match b:
    case True{}:
      anyIf(ABNF.check.era(book, r, s), X, galt(book, L, s), ih)
    case False{}:
      ih

# The last of three or four facts.
def third(-A: Type, -B: Type, -C: Type, p: A & B & C) -> C:
  match p:
    case (a, b, c):
      c

def fourth(-A: Type, -B: Type, -C: Type, -D: Type, p: A & B & C & D) -> D:
  match p:
    case (a, b, c, d):
      d

# Through lookup.ok: matching what lookup finds is matching one of the rules named name.
def lkq(+gl: GL, +hg: {gl == GRAMMAR : GL}, +book: ABNF.Book, +name: String, +s: String, p: List<(String & ABNF.Rule)> & String & ABNF.Rule, +e: {ABNF.lookup(toList(gl), name) == p : List<(String & ABNF.Rule)> & String & ABNF.Rule})
  -> {ABNF.check.era(book, ABNF.lookup.era(toList(gl), name), s) == List.any(~&1, ~(String & ABNF.Rule), ~(m => String.eq(String.to_lower(Pair.fst(String, ABNF.Rule, m)), String.to_lower(name)) && ABNF.check.era(book, Pair.snd(String, ABNF.Rule, m), s)), toList(gl)) : Bool}:
  match p:
    case (g2, n2, r):
      %ABNF.lookup.era.ok(toList(gl), name, g2, n2, r, e) : {ABNF.check.era(book, _, s) == List.any(~&1, ~(String & ABNF.Rule), ~(m => String.eq(String.to_lower(Pair.fst(String, ABNF.Rule, m)), String.to_lower(name)) && ABNF.check.era(book, Pair.snd(String, ABNF.Rule, m), s)), toList(gl)) : Bool}
      third({g2 == toList(gl) : List<(String & ABNF.Rule)>}, {n2 == name : String}, {ABNF.check.era(book, r, s) == List.any(~&1, ~(String & ABNF.Rule), ~(m => String.eq(String.to_lower(Pair.fst(String, ABNF.Rule, m)), String.to_lower(name)) && ABNF.check.era(book, Pair.snd(String, ABNF.Rule, m), s)), toList(gl)) : Bool}, ABNF.lookup.ok(toList(gl), name, g2, n2, r, e, book, s))

def lookupEqG(+book: ABNF.Book, +gl: GL, +name: String, +s: String) -> {List.any(~&1, ~(String & ABNF.Rule), ~(m => String.eq(String.to_lower(Pair.fst(String, ABNF.Rule, m)), String.to_lower(name)) && ABNF.check.era(book, Pair.snd(String, ABNF.Rule, m), s)), toList(gl)) == galt(book, gsel(gl, name), s) : Bool}:
  match gl:
    case GNil{}:
      {==}
    case GCons{+k, +r, +rest}:
      lkStep(book, String.eq(String.to_lower(k), String.to_lower(name)), r, gsel(rest, name), s, List.any(~&1, ~(String & ABNF.Rule), ~(m => String.eq(String.to_lower(Pair.fst(String, ABNF.Rule, m)), String.to_lower(name)) && ABNF.check.era(book, Pair.snd(String, ABNF.Rule, m), s)), toList(rest)), lookupEqG(book, rest, name, s))

# Matching a lookup in the grammar is matching one of the rules it finds.
# Matching a lookup in the grammar is matching one of the rules it finds.
def lookupEq(+gl: GL, +hg: {gl == GRAMMAR : GL}, +book: ABNF.Book, +name: String, +s: String) -> {ABNF.check.era(book, ABNF.lookup.era(toList(gl), name), s) == galt(book, gsel(gl, name), s) : Bool}:
  Equal.trans(Bool, ABNF.check.era(book, ABNF.lookup.era(toList(gl), name), s), List.any(~&1, ~(String & ABNF.Rule), ~(m => String.eq(String.to_lower(Pair.fst(String, ABNF.Rule, m)), String.to_lower(name)) && ABNF.check.era(book, Pair.snd(String, ABNF.Rule, m), s)), toList(gl)), galt(book, gsel(gl, name), s),
    lkq(gl, hg, book, name, s, ABNF.lookup(toList(gl), name), {==}), lookupEqG(book, gl, name, s))

# The rules named N in the grammar gl, which is GRAMMAR.
def gselG(+gl: GL, +hg: {gl == GRAMMAR : GL}, -N: String, -body: ABNF.Rule, +e: {gsel(GRAMMAR, N) == [body] : List<ABNF.Rule>}) -> {gsel(gl, N) == [body] : List<ABNF.Rule>}:
  %Equal.sym(GL, gl, GRAMMAR, hg) : {gsel(_, N) == [body] : List<ABNF.Rule>}
  e

# MB(N, body): matching the rule N is matching its body.
def MB(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +body: ABNF.Rule, +s: String, +e: {gsel(GRAMMAR, N) == [body] : List<ABNF.Rule>}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == ABNF.check.era(ABNF.full(toList(gl)), body, s) : Bool}:
  Equal.trans(Bool, ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s), ABNF.check.era(ABNF.full(toList(gl)), body, s), unfold1(gl, hg, N, s),
    Equal.trans(Bool, ABNF.check.era(ABNF.full(toList(gl)), ABNF.lookup.era(toList(gl), N), s), galt(ABNF.full(toList(gl)), gsel(gl, N), s), ABNF.check.era(ABNF.full(toList(gl)), body, s), lookupEq(gl, hg, ABNF.full(toList(gl)), N, s),
      Equal.trans(Bool, galt(ABNF.full(toList(gl)), gsel(gl, N), s), galt(ABNF.full(toList(gl)), [body], s), ABNF.check.era(ABNF.full(toList(gl)), body, s),
        Equal.cong(List<ABNF.Rule>, Bool, L => galt(ABNF.full(toList(gl)), L, s), gsel(gl, N), [body], gselG(gl, hg, N, body, e)), galt1(ABNF.full(toList(gl)), body, s))))

def MBe(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +body: ABNF.Rule, +s: String, +e: {gsel(GRAMMAR, N) == [body] : List<ABNF.Rule>}, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), body, s) == True{} : Bool}:
  tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.full(toList(gl)), body, s), MB(gl, hg, N, body, s, e), h)

def MBi(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +body: ABNF.Rule, +s: String, +e: {gsel(GRAMMAR, N) == [body] : List<ABNF.Rule>}, +h: {ABNF.check.era(ABNF.full(toList(gl)), body, s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == True{} : Bool}:
  tt(ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.full(toList(gl)), body, s), MB(gl, hg, N, body, s, e), h)

def refL(+gl: GL, +hg: {gl == GRAMMAR : GL}, +d: Nat, +N: String, +body: ABNF.Rule, +s: String, +e: {gsel(GRAMMAR, N) == [body] : List<ABNF.Rule>}) -> {ABNF.check.era(ABNF.limit(1n+d, toList(gl)), ABNF.ref(N), s) == ABNF.check.era(ABNF.limit(d, toList(gl)), body, s) : Bool}:
  Equal.trans(Bool, ABNF.check.era(ABNF.limit(1n+d, toList(gl)), ABNF.ref(N), s), ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.lookup.era(toList(gl), N), s), ABNF.check.era(ABNF.limit(d, toList(gl)), body, s), ABNF.ref.succ(toList(gl), N, s, d),
    Equal.trans(Bool, ABNF.check.era(ABNF.limit(d, toList(gl)), ABNF.lookup.era(toList(gl), N), s), galt(ABNF.limit(d, toList(gl)), gsel(gl, N), s), ABNF.check.era(ABNF.limit(d, toList(gl)), body, s), lookupEq(gl, hg, ABNF.limit(d, toList(gl)), N, s),
      Equal.trans(Bool, galt(ABNF.limit(d, toList(gl)), gsel(gl, N), s), galt(ABNF.limit(d, toList(gl)), [body], s), ABNF.check.era(ABNF.limit(d, toList(gl)), body, s),
        Equal.cong(List<ABNF.Rule>, Bool, L => galt(ABNF.limit(d, toList(gl)), L, s), gsel(gl, N), [body], gselG(gl, hg, N, body, e)), galt1(ABNF.limit(d, toList(gl)), body, s))))

# A match at some depth is a match.
def toBK(+gl: GL, +hg: {gl == GRAMMAR : GL}, +d: Nat, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(ABNF.limit(d, toList(gl)), r, s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), r, s) == True{} : Bool}:
  ABNF.full.intro(d, toList(gl), r, s, h)

# matches.era is a check against the grammar, through matches.ok.
def mtEq(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +s: String, p: List<(String & ABNF.Rule)> & String & String & Bool, +e: {ABNF.matches(toList(gl), N, s) == p : List<(String & ABNF.Rule)> & String & String & Bool})
  -> {ABNF.matches.era(toList(gl), N, s) == ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) : Bool}:
  match p:
    case (g2, n2, s2, v):
      Equal.trans(Bool, ABNF.matches.era(toList(gl), N, s), v, ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s), Equal.sym(Bool, v, ABNF.matches.era(toList(gl), N, s), ABNF.matches.era.ok(toList(gl), N, s, g2, n2, s2, v, e)), fourth({g2 == toList(gl) : List<(String & ABNF.Rule)>}, {n2 == N : String}, {s2 == s : String}, {v == ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) : Bool}, ABNF.matches.ok(toList(gl), N, s, g2, n2, s2, v, e)))

# A law's matches is a check against the grammar.
def mt(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +s: String, +h: {ABNF.matches.era(toList(gl), N, s) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == True{} : Bool}:
  tt.sym(ABNF.matches.era(toList(gl), N, s), ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s), mtEq(gl, hg, N, s, ABNF.matches(toList(gl), N, s), {==}), h)

# Choices
# =======

def selT(-A: Type, b: Bool, -x: Unit -> A, -y: Unit -> A, +h: {b == True{} : Bool}) -> {sel(A, b, x, y) == x(Unit{}) : A}:
  match b:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({sel(A, False{}, x, y) == x(Unit{}) : A}, false_ne_true(h))

def selF(-A: Type, b: Bool, -x: Unit -> A, -y: Unit -> A, +h: {b == False{} : Bool}) -> {sel(A, b, x, y) == y(Unit{}) : A}:
  match b:
    case True{}:
      Empty.absurd({sel(A, True{}, x, y) == y(Unit{}) : A}, false_ne_true(Equal.sym(Bool, True{}, False{}, h)))
    case False{}:
      {==}

# Whitespace
# ==========

def wsall(s: String) -> Bool:
  match s:
    case SNil{}:
      True{}
    case SCon{c, t}:
      Bool.and(isws(c), wsall(t))

def wsp(s: String) -> String:
  match s:
    case SNil{}:
      SNil{}
    case SCon{+c, +t}:
      sel(String, isws(c), u => SCon{c, wsp(t)}, u => SNil{})

def wsc1(+k: ABNF.Book, +c: Char) -> {ABNF.check.era(k, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), SCon{c, SNil{}}) == isws(c) : Bool}:
  alt2(k, ABNF.char(Chr{32}), [ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})], SCon{c, SNil{}}, Char.is_eq(Chr{32}, c), Bool.or(Char.is_eq(Chr{9}, c), Bool.or(Char.is_eq(Chr{10}, c), Bool.or(Char.is_eq(Chr{13}, c), False{}))), ABNF.char.one(k, Chr{32}, c),
    alt2(k, ABNF.char(Chr{9}), [ABNF.char(Chr{10}), ABNF.char(Chr{13})], SCon{c, SNil{}}, Char.is_eq(Chr{9}, c), Bool.or(Char.is_eq(Chr{10}, c), Bool.or(Char.is_eq(Chr{13}, c), False{})), ABNF.char.one(k, Chr{9}, c),
      alt2(k, ABNF.char(Chr{10}), [ABNF.char(Chr{13})], SCon{c, SNil{}}, Char.is_eq(Chr{10}, c), Bool.or(Char.is_eq(Chr{13}, c), False{}), ABNF.char.one(k, Chr{10}, c),
        alt2(k, ABNF.char(Chr{13}), [], SCon{c, SNil{}}, Char.is_eq(Chr{13}, c), False{}, ABNF.char.one(k, Chr{13}, c), ABNF.alt.nil(k, SCon{c, SNil{}})))))

def wsc0(+k: ABNF.Book) -> {ABNF.check.era(k, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), SNil{}) == False{} : Bool}:
  alt2F(k, ABNF.char(Chr{32}), [ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})], SNil{}, ABNF.char.nil(k, Chr{32}),
    alt2F(k, ABNF.char(Chr{9}), [ABNF.char(Chr{10}), ABNF.char(Chr{13})], SNil{}, ABNF.char.nil(k, Chr{9}),
      alt2F(k, ABNF.char(Chr{10}), [ABNF.char(Chr{13})], SNil{}, ABNF.char.nil(k, Chr{10}),
        alt2F(k, ABNF.char(Chr{13}), [], SNil{}, ABNF.char.nil(k, Chr{13}), ABNF.alt.nil(k, SNil{})))))

def wsc2(+k: ABNF.Book, +a: Char, +b: Char, +t: String) -> {ABNF.check.era(k, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), SCon{a, SCon{b, t}}) == False{} : Bool}:
  alt2F(k, ABNF.char(Chr{32}), [ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})], SCon{a, SCon{b, t}}, ABNF.char.many(k, Chr{32}, a, b, t),
    alt2F(k, ABNF.char(Chr{9}), [ABNF.char(Chr{10}), ABNF.char(Chr{13})], SCon{a, SCon{b, t}}, ABNF.char.many(k, Chr{9}, a, b, t),
      alt2F(k, ABNF.char(Chr{10}), [ABNF.char(Chr{13})], SCon{a, SCon{b, t}}, ABNF.char.many(k, Chr{10}, a, b, t),
        alt2F(k, ABNF.char(Chr{13}), [], SCon{a, SCon{b, t}}, ABNF.char.many(k, Chr{13}, a, b, t), ABNF.alt.nil(k, SCon{a, SCon{b, t}})))))

def wsE.step(+gl: GL, +hg: {gl == GRAMMAR : GL}, +c: Char, -b: String, -w: String, +e: {String.append(SCon{c, SNil{}}, b) == w : String}, +hc: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), SCon{c, SNil{}}) == True{} : Bool}, +hb: {wsall(b) == True{} : Bool})
  -> {wsall(w) == True{} : Bool}:
  %e : {wsall(_) == True{} : Bool}
  and_intro(isws(c), wsall(b), tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), SCon{c, SNil{}}), isws(c), wsc1(ABNF.full(toList(gl)), c), hc), hb)

def wsE.m(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Nat, +w: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.exactly(m, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})])), w) == True{} : Bool}) -> {wsall(w) == True{} : Bool}:
  match m:
    case 0n:
      %Equal.sym(String, w, SNil{}, emptyE(ABNF.full(toList(gl)), w, exZe(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), w, h))) : {wsall(_) == True{} : Bool}
      {==}
    case 1n+ +m1:
      seqE2({wsall(w) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), ABNF.rep.exactly(m1, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})])), w, exSe(ABNF.full(toList(gl)), m1, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), w, h), +a => +b => +e => +ha => hb =>
        one({wsall(w) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), a, ha, wsc0(ABNF.full(toList(gl))), x => y => z => wsc2(ABNF.full(toList(gl)), x, y, z), c => ec => hc =>
          wsE.step(gl, hg, c, b, w, Equal.trans(String, String.append(SCon{c, SNil{}}, b), String.append(a, b), w, app_congr(b, SCon{c, SNil{}}, a, ec), e), hc, wsE.m(gl, hg, m1, b, hb))))

def wsE.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +w: String, p: &m: Nat -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.exactly(m, ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})])), w) == True{} : Bool}) -> {wsall(w) == True{} : Bool}:
  (m, h) = p
  wsE.m(gl, hg, m, w, h)

def wsE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +w: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("ws"), w) == True{} : Bool}) -> {wsall(w) == True{} : Bool}:
  wsE.go(gl, hg, w, ABNF.rep.any.elim(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), w, MBe(gl, hg, "ws", ABNF.rep.any(ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})])), w, {==}, h)))

def wsI.star(+gl: GL, +hg: {gl == GRAMMAR : GL}, w: String, +h: {wsall(w) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.rep.any(ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})])), w) == True{} : Bool}:
  match w:
    case SNil{}:
      starNil(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]))
    case SCon{+c, +t}:
      starConsH(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), c, t, tt(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})]), SCon{c, SNil{}}), isws(c), wsc1(ABNF.full(toList(gl)), c), and_l(isws(c), wsall(t), h)), wsI.star(gl, hg, t, and_r(isws(c), wsall(t), h)))

def wsI(+gl: GL, +hg: {gl == GRAMMAR : GL}, +w: String, +h: {wsall(w) == True{} : Bool}) -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("ws"), w) == True{} : Bool}:
  MBi(gl, hg, "ws", ABNF.rep.any(ABNF.alt([ABNF.char(Chr{32}), ABNF.char(Chr{9}), ABNF.char(Chr{10}), ABNF.char(Chr{13})])), w, {==}, wsI.star(gl, hg, w, h))

# skip_ws drops a whitespace prefix.
def WE(w: String, -t: String, +h: {wsall(w) == True{} : Bool}) -> {skip_ws(String.append(w, t)) == skip_ws(t) : String}:
  match w:
    case SNil{}:
      {==}
    case SCon{+c, +w1}:
      Equal.trans(String, skip_ws(SCon{c, String.append(w1, t)}), skip_ws(String.append(w1, t)), skip_ws(t),
        selT(String, isws(c), u => skip_ws(String.append(w1, t)), u => SCon{c, String.append(w1, t)}, and_l(isws(c), wsall(w1), h)),
        WE(w1, t, and_r(isws(c), wsall(w1), h)))

def skipF(+c: Char, -t: String, +h: {isws(c) == False{} : Bool}) -> {skip_ws(SCon{c, t}) == SCon{c, t} : String}:
  selF(String, isws(c), u => skip_ws(t), u => SCon{c, t}, h)

def WI.t(+c: Char, +t: String, +h: {isws(c) == True{} : Bool}, +ih: {String.append(wsp(t), skip_ws(t)) == t : String}) -> {String.append(wsp(SCon{c, t}), skip_ws(SCon{c, t})) == SCon{c, t} : String}:
  %Equal.sym(String, wsp(SCon{c, t}), SCon{c, wsp(t)}, selT(String, isws(c), u => SCon{c, wsp(t)}, u => SNil{}, h)) : {String.append(_, skip_ws(SCon{c, t})) == SCon{c, t} : String}
  %Equal.sym(String, skip_ws(SCon{c, t}), skip_ws(t), selT(String, isws(c), u => skip_ws(t), u => SCon{c, t}, h)) : {String.append(SCon{c, wsp(t)}, _) == SCon{c, t} : String}
  cons_eq(c, String.append(wsp(t), skip_ws(t)), t, ih)

def WI.f(+c: Char, +t: String, +h: {isws(c) == False{} : Bool}) -> {String.append(wsp(SCon{c, t}), skip_ws(SCon{c, t})) == SCon{c, t} : String}:
  %Equal.sym(String, wsp(SCon{c, t}), SNil{}, selF(String, isws(c), u => SCon{c, wsp(t)}, u => SNil{}, h)) : {String.append(_, skip_ws(SCon{c, t})) == SCon{c, t} : String}
  skipF(c, t, h)

# A string is its whitespace prefix, then what skip_ws leaves.
def WI(s: String) -> {String.append(wsp(s), skip_ws(s)) == s : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      bcase({String.append(wsp(SCon{c, t}), skip_ws(SCon{c, t})) == SCon{c, t} : String}, isws(c), +h => WI.t(c, t, h, WI(t)), +h => WI.f(c, t, h))

def WIa.t(+c: Char, +t: String, +h: {isws(c) == True{} : Bool}, +ih: {wsall(wsp(t)) == True{} : Bool}) -> {wsall(wsp(SCon{c, t})) == True{} : Bool}:
  %Equal.sym(String, wsp(SCon{c, t}), SCon{c, wsp(t)}, selT(String, isws(c), u => SCon{c, wsp(t)}, u => SNil{}, h)) : {wsall(_) == True{} : Bool}
  and_intro(isws(c), wsall(wsp(t)), h, ih)

def WIa.f(+c: Char, +t: String, +h: {isws(c) == False{} : Bool}) -> {wsall(wsp(SCon{c, t})) == True{} : Bool}:
  %Equal.sym(String, wsp(SCon{c, t}), SNil{}, selF(String, isws(c), u => SCon{c, wsp(t)}, u => SNil{}, h)) : {wsall(_) == True{} : Bool}
  {==}

def WIa(s: String) -> {wsall(wsp(s)) == True{} : Bool}:
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      bcase({wsall(wsp(SCon{c, t})) == True{} : Bool}, isws(c), +h => WIa.t(c, t, h, WIa(t)), +h => WIa.f(c, t, h))

def SKA.f(+a: Char, -r: String, -t: String, -c: Char, -y: String, +h: {isws(a) == False{} : Bool}, +e: {skip_ws(SCon{a, r}) == SCon{c, y} : String})
  -> {skip_ws(SCon{a, String.append(r, t)}) == SCon{c, String.append(y, t)} : String}:
  %Equal.sym(String, skip_ws(SCon{a, String.append(r, t)}), SCon{a, String.append(r, t)}, skipF(a, String.append(r, t), h)) : {_ == SCon{c, String.append(y, t)} : String}
  Equal.cong(String, String, z => String.append(z, t), SCon{a, r}, SCon{c, y}, Equal.trans(String, SCon{a, r}, skip_ws(SCon{a, r}), SCon{c, y}, Equal.sym(String, skip_ws(SCon{a, r}), SCon{a, r}, skipF(a, r, h)), e))

# When skip_ws leaves something, more text after it stays.
def SKA(x: String, +t: String, +c: Char, +y: String, +e: {skip_ws(x) == SCon{c, y} : String}) -> {skip_ws(String.append(x, t)) == SCon{c, String.append(y, t)} : String}:
  match x:
    case SNil{}:
      Empty.absurd({skip_ws(t) == SCon{c, String.append(y, t)} : String}, nil_ne_con(c, y, e))
    case SCon{+a, +r}:
      bcase({skip_ws(SCon{a, String.append(r, t)}) == SCon{c, String.append(y, t)} : String}, isws(a),
        +h => Equal.trans(String, skip_ws(SCon{a, String.append(r, t)}), skip_ws(String.append(r, t)), SCon{c, String.append(y, t)},
          selT(String, isws(a), u => skip_ws(String.append(r, t)), u => SCon{a, String.append(r, t)}, h),
          SKA(r, t, c, y, Equal.trans(String, skip_ws(r), skip_ws(SCon{a, r}), SCon{c, y}, Equal.sym(String, skip_ws(SCon{a, r}), skip_ws(r), selT(String, isws(a), u => skip_ws(r), u => SCon{a, r}, h)), e))),
        +h => SKA.f(a, r, t, c, y, h, e))

def tokb2(+ch: Char, x: String) -> Bool:
  match x:
    case SNil{}:
      False{}
    case SCon{c, y}:
      Bool.and(Char.is_eq(ch, c), wsall(y))

def tokb(+ch: Char, b: String) -> Bool:
  tokb2(ch, skip_ws(b))

# Tokens
# ======
#
# tokb(c, b): b is whitespace, c, whitespace, as in begin-array.

def tokE.ws(+gl: GL, +hg: {gl == GRAMMAR : GL}, +ch: Char, +x: Char, +hch: {isws(ch) == False{} : Bool}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{x, SNil{}}) == True{} : Bool}) -> {isws(x) == False{} : Bool}:
  %char_eq(ch, x, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{x, SNil{}}), Char.is_eq(ch, x), ABNF.char.one(ABNF.full(toList(gl)), ch, x), hx)) : {isws(_) == False{} : Bool}
  hch

def tokE.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +ch: Char, -b: String, +w1: String, +x: Char, +w2: String, +eb: {String.append(w1, SCon{x, w2}) == b : String},
  +hw1: {wsall(w1) == True{} : Bool}, +hw2: {wsall(w2) == True{} : Bool}, +hch: {isws(ch) == False{} : Bool}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{x, SNil{}}) == True{} : Bool})
  -> {tokb(ch, b) == True{} : Bool}:
  %eb : {tokb(ch, _) == True{} : Bool}
  %Equal.sym(String, skip_ws(String.append(w1, SCon{x, w2})), skip_ws(SCon{x, w2}), WE(w1, SCon{x, w2}, hw1)) : {tokb2(ch, _) == True{} : Bool}
  %Equal.sym(String, skip_ws(SCon{x, w2}), SCon{x, w2}, skipF(x, w2, tokE.ws(gl, hg, ch, x, hch, hx))) : {tokb2(ch, _) == True{} : Bool}
  and_intro(Char.is_eq(ch, x), wsall(w2), tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{x, SNil{}}), Char.is_eq(ch, x), ABNF.char.one(ABNF.full(toList(gl)), ch, x), hx), hw2)

def tokE(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +ch: Char, +b: String, +e: {gsel(GRAMMAR, N) == [ABNF.seq([ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws")])] : List<ABNF.Rule>}, +hch: {isws(ch) == False{} : Bool}, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), b) == True{} : Bool})
  -> {tokb(ch, b) == True{} : Bool}:
  seqE3({tokb(ch, b) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws"), b, MBe(gl, hg, N, ABNF.seq([ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws")]), b, e, h), +w1 => +cs => +w2 => +eb => +h1 => +h2 => +h3 =>
    one({tokb(ch, b) == True{} : Bool}, ABNF.full(toList(gl)), ABNF.char(ch), cs, h2, ABNF.char.nil(ABNF.full(toList(gl)), ch), x => y => z => ABNF.char.many(ABNF.full(toList(gl)), ch, x, y, z), +x => +ex => +hx =>
      tokE.go(gl, hg, ch, b, w1, x, w2, Equal.trans(String, String.append(w1, SCon{x, w2}), String.append(w1, String.append(cs, w2)), b, app_congl(w1, SCon{x, w2}, String.append(cs, w2), app_congr(w2, SCon{x, SNil{}}, cs, ex)), eb),
        wsE(gl, hg, w1, h1), wsE(gl, hg, w2, h3), hch, hx)))

def tokI.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +ch: Char, +b: String, x: String, +ex: {skip_ws(b) == x : String}, +e: {gsel(GRAMMAR, N) == [ABNF.seq([ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws")])] : List<ABNF.Rule>}, +h: {tokb2(ch, x) == True{} : Bool})
  -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), b) == True{} : Bool}:
  match x:
    case SNil{}:
      Empty.absurd({ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), b) == True{} : Bool}, false_ne_true(h))
    case SCon{+c, +y}:
      %Equal.sym(String, b, String.append(wsp(b), SCon{c, y}), Equal.trans(String, b, String.append(wsp(b), skip_ws(b)), String.append(wsp(b), SCon{c, y}), Equal.sym(String, String.append(wsp(b), skip_ws(b)), b, WI(b)), app_congl(wsp(b), skip_ws(b), SCon{c, y}, ex))) : {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), _) == True{} : Bool}
      MBi(gl, hg, N, ABNF.seq([ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws")]), String.append(wsp(b), SCon{c, y}), e,
        seqI3m(ABNF.full(toList(gl)), ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws"), wsp(b), c, y, wsI(gl, hg, wsp(b), WIa(b)),
          tt(ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{c, SNil{}}), Char.is_eq(ch, c), ABNF.char.one(ABNF.full(toList(gl)), ch, c), and_l(Char.is_eq(ch, c), wsall(y), h)),
          wsI(gl, hg, y, and_r(Char.is_eq(ch, c), wsall(y), h))))

def tokI(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +ch: Char, +b: String, +e: {gsel(GRAMMAR, N) == [ABNF.seq([ABNF.ref("ws"), ABNF.char(ch), ABNF.ref("ws")])] : List<ABNF.Rule>}, +h: {tokb(ch, b) == True{} : Bool})
  -> {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), b) == True{} : Bool}:
  tokI.go(gl, hg, N, ch, b, skip_ws(b), {==}, e, h)

def tokU.go(+ch: Char, +b: String, +t: String, x: String, +ex: {skip_ws(b) == x : String}, +h: {tokb2(ch, x) == True{} : Bool})
  -> {skip_ws(String.append(b, t)) == SCon{ch, String.append(str_tl(x), t)} : String}:
  match x:
    case SNil{}:
      Empty.absurd({skip_ws(String.append(b, t)) == SCon{ch, String.append(SNil{}, t)} : String}, false_ne_true(h))
    case SCon{+c, +y}:
      %Equal.sym(Char, ch, c, char_eq(ch, c, and_l(Char.is_eq(ch, c), wsall(y), h))) : {skip_ws(String.append(b, t)) == SCon{_, String.append(y, t)} : String}
      SKA(b, t, c, y, ex)

# After a token, the text continues with its character and some whitespace.
def tokU(+ch: Char, +b: String, +t: String, +h: {tokb(ch, b) == True{} : Bool}) -> {skip_ws(String.append(b, t)) == SCon{ch, String.append(str_tl(skip_ws(b)), t)} : String}:
  tokU.go(ch, b, t, skip_ws(b), {==}, h)

def tokW.go(+ch: Char, x: String, +h: {tokb2(ch, x) == True{} : Bool}) -> {wsall(str_tl(x)) == True{} : Bool}:
  match x:
    case SNil{}:
      Empty.absurd({wsall(SNil{}) == True{} : Bool}, false_ne_true(h))
    case SCon{+c, +y}:
      and_r(Char.is_eq(ch, c), wsall(y), h)

def tokW(+ch: Char, +b: String, +h: {tokb(ch, b) == True{} : Bool}) -> {wsall(str_tl(skip_ws(b))) == True{} : Bool}:
  tokW.go(ch, skip_ws(b), h)

# Literals
# ========

def csE.go(+c: Char, -t: String, +x: Char, -a: String, +b: String, -s: String, +e: {String.append(a, b) == s : String}, +ex: {SCon{x, SNil{}} == a : String},
  +hx: {Char.is_eq(c, x) == True{} : Bool}, +hb: {b == t : String}) -> {s == SCon{c, t} : String}:
  %Equal.sym(String, s, SCon{x, b}, Equal.trans(String, s, String.append(a, b), SCon{x, b}, Equal.sym(String, String.append(a, b), s, e), app_congr(b, a, SCon{x, SNil{}}, Equal.sym(String, SCon{x, SNil{}}, a, ex)))) : {_ == SCon{c, t} : String}
  %char_eq(c, x, hx) : {SCon{_, b} == SCon{c, t} : String}
  cons_eq(c, b, t, hb)

def csE(+k: ABNF.Book, lit: String, +s: String, +h: {ABNF.check.era(k, ABNF.string.case_sensitive(lit), s) == True{} : Bool}) -> {s == lit : String}:
  match lit:
    case SNil{}:
      emptyE(k, s, tt.sym(ABNF.check.era(k, ABNF.string.case_sensitive(SNil{}), s), ABNF.check.era(k, ABNF.empty, s), ABNF.string.case_sensitive.nil(k, s), h))
    case SCon{+c, +t}:
      seqE2({s == SCon{c, t} : String}, k, ABNF.char(c), ABNF.string.case_sensitive(t), s, tt.sym(ABNF.check.era(k, ABNF.string.case_sensitive(SCon{c, t}), s), ABNF.check.era(k, ABNF.seq([ABNF.char(c), ABNF.string.case_sensitive(t)]), s), ABNF.string.case_sensitive.con(k, s, c, t), h), +a => +b => +e => +ha => +hb =>
        one({s == SCon{c, t} : String}, k, ABNF.char(c), a, ha, ABNF.char.nil(k, c), x => y => z => ABNF.char.many(k, c, x, y, z), +x => +ex => +hx =>
          csE.go(c, t, x, a, b, s, e, ex, tt.sym(ABNF.check.era(k, ABNF.char(c), SCon{x, SNil{}}), Char.is_eq(c, x), ABNF.char.one(k, c, x), hx), csE(k, t, b, hb))))

def csI(+k: ABNF.Book, lit: String) -> {ABNF.check.era(k, ABNF.string.case_sensitive(lit), lit) == True{} : Bool}:
  match lit:
    case SNil{}:
      tt(ABNF.check.era(k, ABNF.string.case_sensitive(SNil{}), SNil{}), ABNF.check.era(k, ABNF.empty, SNil{}), ABNF.string.case_sensitive.nil(k, SNil{}), ABNF.empty.nil(k))
    case SCon{+c, +t}:
      tt(ABNF.check.era(k, ABNF.string.case_sensitive(SCon{c, t}), SCon{c, t}), ABNF.check.era(k, ABNF.seq([ABNF.char(c), ABNF.string.case_sensitive(t)]), SCon{c, t}), ABNF.string.case_sensitive.con(k, SCon{c, t}, c, t),
        seqI2(k, ABNF.char(c), ABNF.string.case_sensitive(t), SCon{c, SNil{}}, t, tt(ABNF.check.era(k, ABNF.char(c), SCon{c, SNil{}}), Char.is_eq(c, c), ABNF.char.one(k, c, c), char_refl(c)), csI(k, t)))

# Single characters
# =================

def charM.go(+gl: GL, +hg: {gl == GRAMMAR : GL}, +ch: Char, -s: String, +x: Char, +ex: {SCon{x, SNil{}} == s : String}, +hx: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{x, SNil{}}) == True{} : Bool}) -> {s == SCon{ch, SNil{}} : String}:
  %Equal.sym(String, s, SCon{x, SNil{}}, Equal.sym(String, SCon{x, SNil{}}, s, ex)) : {_ == SCon{ch, SNil{}} : String}
  %char_eq(ch, x, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.char(ch), SCon{x, SNil{}}), Char.is_eq(ch, x), ABNF.char.one(ABNF.full(toList(gl)), ch, x), hx)) : {SCon{_, SNil{}} == SCon{ch, SNil{}} : String}
  {==}

# A rule that is one character matches exactly that character.
def charM(+gl: GL, +hg: {gl == GRAMMAR : GL}, +N: String, +ch: Char, +s: String, +e: {gsel(GRAMMAR, N) == [ABNF.char(ch)] : List<ABNF.Rule>}, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref(N), s) == True{} : Bool}) -> {s == SCon{ch, SNil{}} : String}:
  one({s == SCon{ch, SNil{}} : String}, ABNF.full(toList(gl)), ABNF.char(ch), s, MBe(gl, hg, N, ABNF.char(ch), s, e, h), ABNF.char.nil(ABNF.full(toList(gl)), ch), x => y => z => ABNF.char.many(ABNF.full(toList(gl)), ch, x, y, z), +x => +ex => +hx => charM.go(gl, hg, ch, s, x, ex, hx))

def unesc1(+k: ABNF.Book, +c: Char) -> {ABNF.check.era(k, ABNF.alt([ABNF.range(Chr{32}, Chr{33}), ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})]), SCon{c, SNil{}}) == isunesc(c) : Bool}:
  alt2(k, ABNF.range(Chr{32}, Chr{33}), [ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})], SCon{c, SNil{}}, inR(Chr{32}, Chr{33}, c), Bool.or(inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{})), rg1(k, Chr{32}, Chr{33}, c),
    alt2(k, ABNF.range(Chr{35}, Chr{91}), [ABNF.range(Chr{93}, Chr{1114111})], SCon{c, SNil{}}, inR(Chr{35}, Chr{91}, c), Bool.or(inR(Chr{93}, Chr{1114111}, c), False{}), rg1(k, Chr{35}, Chr{91}, c),
      alt2(k, ABNF.range(Chr{93}, Chr{1114111}), [], SCon{c, SNil{}}, inR(Chr{93}, Chr{1114111}, c), False{}, rg1(k, Chr{93}, Chr{1114111}, c), ABNF.alt.nil(k, SCon{c, SNil{}}))))

def unesc0(+k: ABNF.Book) -> {ABNF.check.era(k, ABNF.alt([ABNF.range(Chr{32}, Chr{33}), ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})]), SNil{}) == False{} : Bool}:
  alt2F(k, ABNF.range(Chr{32}, Chr{33}), [ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})], SNil{}, rg0(k, Chr{32}, Chr{33}),
    alt2F(k, ABNF.range(Chr{35}, Chr{91}), [ABNF.range(Chr{93}, Chr{1114111})], SNil{}, rg0(k, Chr{35}, Chr{91}),
      alt2F(k, ABNF.range(Chr{93}, Chr{1114111}), [], SNil{}, rg0(k, Chr{93}, Chr{1114111}), ABNF.alt.nil(k, SNil{}))))

def unesc2(+k: ABNF.Book, +a: Char, +b: Char, +t: String) -> {ABNF.check.era(k, ABNF.alt([ABNF.range(Chr{32}, Chr{33}), ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})]), SCon{a, SCon{b, t}}) == False{} : Bool}:
  alt2F(k, ABNF.range(Chr{32}, Chr{33}), [ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})], SCon{a, SCon{b, t}}, rg2(k, Chr{32}, Chr{33}, a, b, t),
    alt2F(k, ABNF.range(Chr{35}, Chr{91}), [ABNF.range(Chr{93}, Chr{1114111})], SCon{a, SCon{b, t}}, rg2(k, Chr{35}, Chr{91}, a, b, t),
      alt2F(k, ABNF.range(Chr{93}, Chr{1114111}), [], SCon{a, SCon{b, t}}, rg2(k, Chr{93}, Chr{1114111}, a, b, t), ABNF.alt.nil(k, SCon{a, SCon{b, t}}))))

# An unescaped character is not a backslash.
def unesc_bs(+c: Char, +h: {isunesc(c) == True{} : Bool}) -> {Char.is_eq(c, '\\') == False{} : Bool}:
  bcase({Char.is_eq(c, '\\') == False{} : Bool}, Char.is_eq(c, '\\'),
    +k => Empty.absurd({Char.is_eq(c, '\\') == False{} : Bool}, false_ne_true(Equal.trans(Bool, False{}, isunesc(c), True{}, Equal.cong(Char, Bool, z => isunesc(z), '\\', c, Equal.sym(Char, c, '\\', char_eq(c, '\\', k))), h))),
    +k => k)

def unescM(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +u: String, +h: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("unescaped"), u) == True{} : Bool}, f: @c: Char -> {SCon{c, SNil{}} == u : String} -> {isunesc(c) == True{} : Bool} -> C) -> C:
  one(C, ABNF.full(toList(gl)), ABNF.alt([ABNF.range(Chr{32}, Chr{33}), ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})]), u, MBe(gl, hg, "unescaped", ABNF.alt([ABNF.range(Chr{32}, Chr{33}), ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})]), u, {==}, h), unesc0(ABNF.full(toList(gl))), x => y => z => unesc2(ABNF.full(toList(gl)), x, y, z), +c => +ec => +hc => f(c, ec, tt.sym(ABNF.check.era(ABNF.full(toList(gl)), ABNF.alt([ABNF.range(Chr{32}, Chr{33}), ABNF.range(Chr{35}, Chr{91}), ABNF.range(Chr{93}, Chr{1114111})]), SCon{c, SNil{}}), isunesc(c), unesc1(ABNF.full(toList(gl)), c), hc)))

# Comparisons
# ===========

def cmp_out(c1: Cmp, c2: Cmp, +h: {Bool.or(Cmp.is_lt(c1), Cmp.is_gt(c2)) == True{} : Bool}) -> {Bool.and(Cmp.is_ge(c1), Cmp.is_le(c2)) == False{} : Bool}:
  match c1 c2:
    case LT{} c2:
      {==}
    case EQ{} LT{}:
      Empty.absurd({True{} == False{} : Bool}, false_ne_true(h))
    case EQ{} EQ{}:
      Empty.absurd({True{} == False{} : Bool}, false_ne_true(h))
    case EQ{} GT{}:
      {==}
    case GT{} LT{}:
      Empty.absurd({True{} == False{} : Bool}, false_ne_true(h))
    case GT{} EQ{}:
      Empty.absurd({True{} == False{} : Bool}, false_ne_true(h))
    case GT{} GT{}:
      {==}

# Lookup and decoding laws
# ========================

def dec_unesc(+c: Char, -t: String, +h: {isunesc(c) == True{} : Bool}) -> {dec(SCon{c, t}, DN{}, None{}) == SCon{c, dec(t, DN{}, None{})} : String}:
  selF(String, Char.is_eq(c, '\\'), u => dec(t, DE{}, None{}), u => emit(None{}, SCon{c, dec(t, DN{}, None{})}), unesc_bs(c, h))

def decU(+c: Char, -u: String, -t: String, +ec: {SCon{c, SNil{}} == u : String}, +hc: {isunesc(c) == True{} : Bool}) -> {dec(String.append(u, t), DN{}, None{}) == String.append(u, dec(t, DN{}, None{})) : String}:
  %ec : {dec(String.append(_, t), DN{}, None{}) == String.append(_, dec(t, DN{}, None{})) : String}
  dec_unesc(c, t, hc)

def unescMM(+gl: GL, +hg: {gl == GRAMMAR : GL}, -C: Type, +u: String, +h: {ABNF.matches.era(toList(gl), "unescaped", u) == True{} : Bool}, f: @c: Char -> {SCon{c, SNil{}} == u : String} -> {isunesc(c) == True{} : Bool} -> C) -> C:
  unescM(gl, hg, C, u, mt(gl, hg, "unescaped", u, h), f)

def fpreT(+v: U32, +h: {hi(v) == True{} : Bool}) -> {fpre(v) == SNil{} : String}:
  selT(String, hi(v), u => SNil{}, u => SCon{Chr{v}, SNil{}}, h)

def fpreF(+v: U32, +h: {hi(v) == False{} : Bool}) -> {fpre(v) == SCon{Chr{v}, SNil{}} : String}:
  selF(String, hi(v), u => SNil{}, u => SCon{Chr{v}, SNil{}}, h)

def fnpT(+v: U32, +h: {hi(v) == True{} : Bool}) -> {fnp(v) == Some{v} : Maybe<&2, U32>}:
  selT(Maybe<&2, U32>, hi(v), u => Some{v}, u => None{}, h)

def fnpF(+v: U32, +h: {hi(v) == False{} : Bool}) -> {fnp(v) == None{} : Maybe<&2, U32>}:
  selF(Maybe<&2, U32>, hi(v), u => Some{v}, u => None{}, h)

# After \uXXXX, dec writes pre and keeps np pending.
def decX(+a: Char, +b: Char, +c: Char, +d: Char, -t: String, +p: Maybe<&2, U32>, +hx: {F.ishexS(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}) == True{} : Bool})
  -> {dec(SCon{'\\', SCon{'u', SCon{a, SCon{b, SCon{c, SCon{d, t}}}}}}, DN{}, p) == String.append(pre(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), p), dec(t, DN{}, np(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), p))) : String}:
  selT(String, F.ishexS(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}), u => String.append(pre(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), p), dec(t, DN{}, np(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), p))), u => emit(p, SCon{'\\', SCon{'u', String.append(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, dec(t, DN{}, None{}))}}), hx)

def escM(+gl: GL, +hg: {gl == GRAMMAR : GL}, +e: String, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("escape"), e) == True{} : Bool}) -> {SCon{'\\', SNil{}} == e : String}:
  Equal.sym(String, e, SCon{'\\', SNil{}}, charM(gl, hg, "escape", '\\', e, {==}, he))

def escMM(+gl: GL, +hg: {gl == GRAMMAR : GL}, +e: String, +he: {ABNF.matches.era(toList(gl), "escape", e) == True{} : Bool}) -> {SCon{'\\', SNil{}} == e : String}:
  escM(gl, hg, e, mt(gl, hg, "escape", e, he))

def decu.go(+a: Char, +b: Char, +c: Char, +d: Char, -t: String, +hx: {F.ishexS(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}) == True{} : Bool}, +hs: {hi(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)) == False{} : Bool})
  -> {dec(SCon{'\\', SCon{'u', SCon{a, SCon{b, SCon{c, SCon{d, t}}}}}}, DN{}, None{}) == SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, dec(t, DN{}, None{})} : String}:
  %Equal.sym(String, dec(SCon{'\\', SCon{'u', SCon{a, SCon{b, SCon{c, SCon{d, t}}}}}}, DN{}, None{}), String.append(pre(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), None{}), dec(t, DN{}, np(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), None{}))), decX(a, b, c, d, t, None{}, hx)) : {_ == SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, dec(t, DN{}, None{})} : String}
  %Equal.sym(String, fpre(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)), SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, SNil{}}, fpreF(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), hs)) : {String.append(_, dec(t, DN{}, fnp(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)))) == SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, dec(t, DN{}, None{})} : String}
  %Equal.sym(Maybe<&2, U32>, fnp(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)), None{}, fnpF(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0), hs)) : {String.append(SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, SNil{}}, dec(t, DN{}, _)) == SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, dec(t, DN{}, None{})} : String}
  {==}

def decu(+gl: GL, +hg: {gl == GRAMMAR : GL}, +e: String, +a: Char, +b: Char, +c: Char, +d: Char, -t: String, +he: {ABNF.check.era(ABNF.full(toList(gl)), ABNF.ref("escape"), e) == True{} : Bool}, +hx: {F.ishexS(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}) == True{} : Bool}, +hs: {hi(hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)) == False{} : Bool})
  -> {dec(String.append(e, String.append("u", String.append(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, t))), DN{}, None{}) == SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, dec(t, DN{}, None{})} : String}:
  %escM(gl, hg, e, he) : {dec(String.append(_, String.append("u", String.append(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, t))), DN{}, None{}) == SCon{Chr{hexv(SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}, 0)}, dec(t, DN{}, None{})} : String}
  decu.go(a, b, c, d, t, hx, hs)

def decu2(+gl: GL, +hg: {gl == GRAMMAR : GL}, +e: String, -x: String, -t: String, +a: Char, +b: Char, +c: Char, +d: Char, +ex: {SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}} == x : String}, +he: {ABNF.matches.era(toList(gl), "escape", e) == True{} : Bool},
  +hx: {F.ishexS(x) == True{} : Bool}, +hs: {Bool.or(U32.is_lt(hexv(x, 0), 55296), U32.is_gt(hexv(x, 0), 56319)) == True{} : Bool})
