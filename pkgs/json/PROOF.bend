def eMA(+g: Nat, s: String, xV: @w: String -> EXT(MV{}, pv(g, MV{}, w), w, g), xA: @w: String -> EXT(MA{}, pv(g, MA{}, w), w, g)) -> EXT(MA{}, pv(1n+g, MA{}, s), s, 1n+g):
