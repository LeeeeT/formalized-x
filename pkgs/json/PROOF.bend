# Numbers
# =======

# NS(m, s, R): if the scan m of s succeeds, it split s, and its text matches R.
def NS(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, s: String, R: ABNF.Rule) -> Type:
  match m:
    case None{}:
      Unit
    case Some{p}:
      {String.append(spa(p), spt(p)) == s : String} & {ABNF.check.era(ABNF.full(toList(gl)), R, spa(p)) == True{} : Bool}

def NSmap(+gl: GL, +hg: {gl == GRAMMAR : GL}, +c: Char, m: Maybe<&2, SP>, -t: String, -R2: ABNF.Rule, -R: ABNF.Rule, ns: NS(gl, hg, m, t, R2), f: @a: String -> {ABNF.check.era(ABNF.full(toList(gl)), R2, a) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), R, SCon{c, a}) == True{} : Bool})
  -> NS(gl, hg, prepM(c, m), SCon{c, t}, R):
  match m:
    case None{}:
      Unit{}
    case Some{SP{+part_a, +part_t}}:
      (e, h) = ns
      (cons_eq(c, String.append(spa(SP{part_a, part_t}), spt(SP{part_a, part_t})), t, e), chkTr(ABNF.full(toList(gl)), R, SCon{c, spa(SP{part_a, part_t})}, spa(SP{SCon{c, spa(SP{part_a, part_t})}, spt(SP{part_a, part_t})}), {==}, f(spa(SP{part_a, part_t}), h)))

def NSw(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, -s: String, -R2: ABNF.Rule, -R: ABNF.Rule, ns: NS(gl, hg, m, s, R2), f: @a: String -> {ABNF.check.era(ABNF.full(toList(gl)), R2, a) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), R, a) == True{} : Bool})
  -> NS(gl, hg, m, s, R):
  match m:
    case None{}:
      Unit{}
    case Some{+p}:
      (e, h) = ns
      (e, f(spa(p), h))

def NSapp(+gl: GL, +hg: {gl == GRAMMAR : GL}, +d: String, m: Maybe<&2, SP>, -r: String, -s: String, -R2: ABNF.Rule, -R: ABNF.Rule, ns: NS(gl, hg, m, r, R2), +e: {String.append(d, r) == s : String},
  f: @a: String -> {ABNF.check.era(ABNF.full(toList(gl)), R2, a) == True{} : Bool} -> {ABNF.check.era(ABNF.full(toList(gl)), R, String.append(d, a)) == True{} : Bool}) -> NS(gl, hg, appM(d, m), s, R):
  match m:
    case None{}:
      Unit{}
    case Some{SP{+part_a, +part_t}}:
      (e2, h) = ns
      (Equal.trans(String, String.append(String.append(d, spa(SP{part_a, part_t})), spt(SP{part_a, part_t})), String.append(d, r), s,
        Equal.trans(String, String.append(String.append(d, spa(SP{part_a, part_t})), spt(SP{part_a, part_t})), String.append(d, String.append(spa(SP{part_a, part_t}), spt(SP{part_a, part_t}))), String.append(d, r), app3(d, spa(SP{part_a, part_t}), spt(SP{part_a, part_t})), app_congl(d, String.append(spa(SP{part_a, part_t}), spt(SP{part_a, part_t})), r, e2)), e),
       chkTr(ABNF.full(toList(gl)), R, String.append(d, spa(SP{part_a, part_t})), spa(SP{String.append(d, spa(SP{part_a, part_t})), spt(SP{part_a, part_t})}), {==}, f(spa(SP{part_a, part_t}), h)))

def digS1.t(+c: Char, +t: String, +h: {isdig(c) == True{} : Bool}, +ih: {String.append(spa(digits(t)), spt(digits(t))) == t : String}) -> {String.append(spa(digits(SCon{c, t})), spt(digits(SCon{c, t}))) == SCon{c, t} : String}:
  %Equal.sym(SP, digits(SCon{c, t}), prepS(c, digits(t)), selT(SP, isdig(c), u => prepS(c, digits(t)), u => SP{SNil{}, SCon{c, t}}, h)) : {String.append(spa(_), spt(_)) == SCon{c, t} : String}
  cons_eq(c, String.append(spa(digits(t)), spt(digits(t))), t, ih)

def digS1.f(+c: Char, +t: String, +h: {isdig(c) == False{} : Bool}) -> {String.append(spa(digits(SCon{c, t})), spt(digits(SCon{c, t}))) == SCon{c, t} : String}:
  %Equal.sym(SP, digits(SCon{c, t}), SP{SNil{}, SCon{c, t}}, selF(SP, isdig(c), u => prepS(c, digits(t)), u => SP{SNil{}, SCon{c, t}}, h)) : {String.append(spa(_), spt(_)) == SCon{c, t} : String}
  {==}

def digS1(s: String) -> {String.append(spa(digits(s)), spt(digits(s))) == s : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
