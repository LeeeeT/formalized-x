  %Equal.sym(Bool, Char.is_eq('E', c), False{}, m9) : {F.ishexG(False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, _, Char.is_eq('f', c), Char.is_eq('F', c)) == False{} : Bool}
