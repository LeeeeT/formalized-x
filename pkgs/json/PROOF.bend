  {==}

def numvPS(+gl: GL, +hg: {gl == GRAMMAR : GL}, m: Maybe<&2, SP>, -s: String, ns: NS(gl, hg, m, s, ABNF.seq([ABNF.opt(ABNF.ref("minus")), ABNF.ref("int"), ABNF.opt(ABNF.ref("frac")), ABNF.opt(ABNF.ref("exp"))]))) -> PSR(gl, hg, ABNF.ref("value"), numv(m), s):
