# After a backslash.
def F.ss.de.b(+p: Maybe<&2, U32>, +c: Char, +t2: String, +acc: String, -d: F.K, ih: F.IHS(t2), +k: {issimple(c) == False{} : Bool}, b: Bool, +e: {Char.is_eq('u', c) == b : Bool})
