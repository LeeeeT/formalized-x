# The value of one hexadecimal digit: four bits, the rest False.
def DVT(c: Char) -> Type:
  &b0: Bool -> &b1: Bool -> &b2: Bool -> &b3: Bool -> {hexd(c) == U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, Word.zero(28n)}}}}} : U32}

def f4(A: U32, B: U32, C: U32, D: U32) -> U32:
  U32.add(U32.mul(U32.add(U32.mul(U32.add(U32.mul(A, 16), B), 16), C), 16), D)

def f4cong(-A: U32, -A2: U32, -B: U32, -B2: U32, -C: U32, -C2: U32, -D: U32, -D2: U32, +ea: {A == A2 : U32}, +eb: {B == B2 : U32}, +ec: {C == C2 : U32}, +ed: {D == D2 : U32}) -> {f4(A, B, C, D) == f4(A2, B2, C2, D2) : U32}:
  %ea : {f4(A, B, C, D) == f4(_, B2, C2, D2) : U32}
  %eb : {f4(A, B, C, D) == f4(A, _, C2, D2) : U32}
  %ec : {f4(A, B, C, D) == f4(A, B, _, D2) : U32}
  %ed : {f4(A, B, C, D) == f4(A, B, C, _) : U32}
  {==}

# A U32 whose bits from 16 on are False.
def H4(v: U32) -> Type:
  &h0: Bool -> &h1: Bool -> &h2: Bool -> &h3: Bool -> &h4: Bool -> &h5: Bool -> &h6: Bool -> &h7: Bool -> &h8: Bool -> &h9: Bool -> &h10: Bool -> &h11: Bool -> &h12: Bool -> &h13: Bool -> &h14: Bool -> &h15: Bool -> {v == U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WCon{h8, WCon{h9, WCon{h10, WCon{h11, WCon{h12, WCon{h13, WCon{h14, WCon{h15, Word.zero(16n)}}}}}}}}}}}}}}}}} : U32}

def X4(a: Char, b: Char, c: Char, d: Char) -> String:
  SCon{a, SCon{b, SCon{c, SCon{d, SNil{}}}}}

def F.dvL0(+c: Char, +k: {Char.is_eq('0', c) == True{} : Bool}) -> DVT(c):
  %char_eq('0', c, k) : DVT(_)
  (False{}, False{}, False{}, False{}, {==})

def F.dvL1(+c: Char, +k: {Char.is_eq('1', c) == True{} : Bool}) -> DVT(c):
  %char_eq('1', c, k) : DVT(_)
  (True{}, False{}, False{}, False{}, {==})

def F.dvL2(+c: Char, +k: {Char.is_eq('2', c) == True{} : Bool}) -> DVT(c):
  %char_eq('2', c, k) : DVT(_)
  (False{}, True{}, False{}, False{}, {==})

def F.dvL3(+c: Char, +k: {Char.is_eq('3', c) == True{} : Bool}) -> DVT(c):
  %char_eq('3', c, k) : DVT(_)
  (True{}, True{}, False{}, False{}, {==})

def F.dvL4(+c: Char, +k: {Char.is_eq('4', c) == True{} : Bool}) -> DVT(c):
  %char_eq('4', c, k) : DVT(_)
  (False{}, False{}, True{}, False{}, {==})

def F.dvL5(+c: Char, +k: {Char.is_eq('5', c) == True{} : Bool}) -> DVT(c):
  %char_eq('5', c, k) : DVT(_)
