# vs(s, st): s scans from st to its end, as the inside of a string.
def vs(s: String, st: SS) -> Bool:
  match s:
    case SNil{}:
      match st:
        case SN{}:
          True{}
        case SE{}:
          False{}
        case SH{n}:
          False{}
    case SCon{+c, +t}:
      match st:
        case SN{}:
          sel(Bool, Char.is_eq('"', c), u => False{}, u => sel(Bool, Char.is_eq('\\', c), u => vs(t, SE{}), u => sel(Bool, isunesc(c), u => vs(t, SN{}), u => False{})))
        case SE{}:
          sel(Bool, issimple(c), u => vs(t, SN{}), u => sel(Bool, Char.is_eq('u', c), u => vs(t, SH{3n}), u => False{}))
        case SH{+n}:
          sel(Bool, ishex(c), u => vs(t, hnext(n)), u => False{})

def hT(-A: Type, b: Bool, -x: Unit -> A, -y: Unit -> A, -S: A, +e: {b == True{} : Bool}, +h: {sel(A, b, x, y) == S : A}) -> {x(Unit{}) == S : A}:
  Equal.trans(A, x(Unit{}), sel(A, b, x, y), S, Equal.sym(A, sel(A, b, x, y), x(Unit{}), selT(A, b, x, y, e)), h)

def hF(-A: Type, b: Bool, -x: Unit -> A, -y: Unit -> A, -S: A, +e: {b == False{} : Bool}, +h: {sel(A, b, x, y) == S : A}) -> {y(Unit{}) == S : A}:
  Equal.trans(A, y(Unit{}), sel(A, b, x, y), S, Equal.sym(A, sel(A, b, x, y), y(Unit{}), selF(A, b, x, y, e)), h)

def gT(-A: Type, b: Bool, -x: Unit -> A, -y: Unit -> A, -S: A, +e: {b == True{} : Bool}, +g: {x(Unit{}) == S : A}) -> {sel(A, b, x, y) == S : A}:
  Equal.trans(A, sel(A, b, x, y), x(Unit{}), S, selT(A, b, x, y, e), g)

def gF(-A: Type, b: Bool, -x: Unit -> A, -y: Unit -> A, -S: A, +e: {b == False{} : Bool}, +g: {y(Unit{}) == S : A}) -> {sel(A, b, x, y) == S : A}:
  Equal.trans(A, sel(A, b, x, y), y(Unit{}), S, selF(A, b, x, y, e), g)

def fstNE(m: Maybe<&2, SP>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{p}:
      match p:
        case SP{a, x}:
          match a:
            case SNil{}:
              False{}
            case SCon{c, r}:
              True{}

def tlM(m: Maybe<&2, SP>) -> Maybe<&2, SP>:
  match m:
    case None{}:
      None{}
    case Some{p}:
      match p:
        case SP{a, x}:
          Some{SP{str_tl(a), x}}

def fstBad(-R: String, -c: Char, -t: String, -W: String, +h: {Some{SP{SNil{}, String.append(t, SCon{'"', W})}} == Some{SP{SCon{c, t}, W}} : Maybe<&2, SP>}) -> Empty:
  false_ne_true(Equal.cong(Maybe<&2, SP>, Bool, fstNE, Some{SP{SNil{}, String.append(t, SCon{'"', W})}}, Some{SP{SCon{c, t}, W}}, h))

def prepMne(+c: Char, m: Maybe<&2, SP>, -W: String, +h: {prepM(c, m) == Some{SP{SNil{}, W}} : Maybe<&2, SP>}) -> Empty:
  match m:
    case None{}:
      none_ne_some(&2, SP, SP{SNil{}, W}, h)
    case Some{p}:
      match p:
        case SP{a, x}:
          false_ne_true(Equal.sym(Bool, True{}, False{}, Equal.cong(Maybe<&2, SP>, Bool, fstNE, Some{SP{SCon{c, a}, x}}, Some{SP{SNil{}, W}}, h)))

def prepMInv(+c: Char, m: Maybe<&2, SP>, -a: String, -W: String, +h: {prepM(c, m) == Some{SP{SCon{c, a}, W}} : Maybe<&2, SP>}) -> {m == Some{SP{a, W}} : Maybe<&2, SP>}:
  match m:
    case None{}:
      Empty.absurd({None{} == Some{SP{a, W}} : Maybe<&2, SP>}, none_ne_some(&2, SP, SP{SCon{c, a}, W}, h))
    case Some{p}:
      match p:
        case SP{a2, x2}:
