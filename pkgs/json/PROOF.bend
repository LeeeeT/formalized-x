def exZi(+k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.empty, s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.rep.exactly(0n, r), s) == True{} : Bool}:
  tt(ABNF.check.era(k, ABNF.rep.exactly(0n, r), s), ABNF.check.era(k, ABNF.empty, s), ABNF.rep.exactly.zero(k, r, s), h)

def exZe(+k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.rep.exactly(0n, r), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.empty, s) == True{} : Bool}:
  tt.sym(ABNF.check.era(k, ABNF.rep.exactly(0n, r), s), ABNF.check.era(k, ABNF.empty, s), ABNF.rep.exactly.zero(k, r, s), h)

def exSi(+k: ABNF.Book, +n: Nat, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.seq([r, ABNF.rep.exactly(n, r)]), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.rep.exactly(1n+n, r), s) == True{} : Bool}:
  tt(ABNF.check.era(k, ABNF.rep.exactly(1n+n, r), s), ABNF.check.era(k, ABNF.seq([r, ABNF.rep.exactly(n, r)]), s), ABNF.rep.exactly.succ(k, r, s, n), h)

def exSe(+k: ABNF.Book, +n: Nat, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.rep.exactly(1n+n, r), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.seq([r, ABNF.rep.exactly(n, r)]), s) == True{} : Bool}:
  tt.sym(ABNF.check.era(k, ABNF.rep.exactly(1n+n, r), s), ABNF.check.era(k, ABNF.seq([r, ABNF.rep.exactly(n, r)]), s), ABNF.rep.exactly.succ(k, r, s, n), h)

def starNil(+k: ABNF.Book, +r: ABNF.Rule) -> {ABNF.check.era(k, ABNF.rep.any(r), SNil{}) == True{} : Bool}:
  ABNF.rep.any.intro(k, 0n, r, SNil{}, exZi(k, r, SNil{}, ABNF.empty.nil(k)))

def starCons.go(+k: ABNF.Book, +r: ABNF.Rule, +a: String, +b: String, +ha: {ABNF.check.era(k, r, a) == True{} : Bool}, p: &m: Nat -> {ABNF.check.era(k, ABNF.rep.exactly(m, r), b) == True{} : Bool})
  -> {ABNF.check.era(k, ABNF.rep.any(r), String.append(a, b)) == True{} : Bool}:
  (+m, hm) = p
  ABNF.rep.any.intro(k, 1n+m, r, String.append(a, b), exSi(k, m, r, String.append(a, b), seqI2(k, r, ABNF.rep.exactly(m, r), a, b, ha, hm)))

def starCons(+k: ABNF.Book, +r: ABNF.Rule, +a: String, +b: String, +ha: {ABNF.check.era(k, r, a) == True{} : Bool}, +hb: {ABNF.check.era(k, ABNF.rep.any(r), b) == True{} : Bool})
  -> {ABNF.check.era(k, ABNF.rep.any(r), String.append(a, b)) == True{} : Bool}:
