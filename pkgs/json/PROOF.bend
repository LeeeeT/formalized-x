def le1(m: Nat) -> {(1n <= 1n+m : Nat) == True{} : Bool}:
  match m:
    case 0n:
      {==}
    case 1n+p:
      {==}

def atl1I.go(+k: ABNF.Book, +r: ABNF.Rule, +a: String, +b: String, -s: String, +e: {String.append(a, b) == s : String}, +ha: {ABNF.check.era(k, r, a) == True{} : Bool}, p: &m: Nat -> {ABNF.check.era(k, ABNF.rep.exactly(m, r), b) == True{} : Bool})
  -> {ABNF.check.era(k, ABNF.rep.at_least(1n, r), s) == True{} : Bool}:
  (+m, hm) = p
  chkTr(k, ABNF.rep.at_least(1n, r), String.append(a, b), s, e, ABNF.rep.at_least.intro(k, 1n, 1n+m, le1(m), r, String.append(a, b), exSi(k, m, r, String.append(a, b), seqI2(k, r, ABNF.rep.exactly(m, r), a, b, ha, hm))))

# One or more repetitions are one, then any number.
def atl1I(+k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.seq([r, ABNF.rep.any(r)]), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.rep.at_least(1n, r), s) == True{} : Bool}:
  seqE2({ABNF.check.era(k, ABNF.rep.at_least(1n, r), s) == True{} : Bool}, k, r, ABNF.rep.any(r), s, h, +a => +b => +e => +ha => +hb => atl1I.go(k, r, a, b, s, e, ha, ABNF.rep.any.elim(k, r, b, hb)))

def atl1E.m(+k: ABNF.Book, +r: ABNF.Rule, +s: String, m: Nat, +hle: {(1n <= m : Nat) == True{} : Bool}, +hm: {ABNF.check.era(k, ABNF.rep.exactly(m, r), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.seq([r, ABNF.rep.any(r)]), s) == True{} : Bool}:
  match m:
    case 0n:
      Empty.absurd({ABNF.check.era(k, ABNF.seq([r, ABNF.rep.any(r)]), s) == True{} : Bool}, false_ne_true(hle))
    case 1n+ +m1:
      seqE2({ABNF.check.era(k, ABNF.seq([r, ABNF.rep.any(r)]), s) == True{} : Bool}, k, r, ABNF.rep.exactly(m1, r), s, exSe(k, m1, r, s, hm), +a => +b => +e => +ha => +hb =>
        chkTr(k, ABNF.seq([r, ABNF.rep.any(r)]), String.append(a, b), s, e, seqI2(k, r, ABNF.rep.any(r), a, b, ha, ABNF.rep.any.intro(k, m1, r, b, hb))))

def atl1E.go(+k: ABNF.Book, +r: ABNF.Rule, +s: String, p: &m: Nat -> {(1n <= m : Nat) == True{} : Bool} & {ABNF.check.era(k, ABNF.rep.exactly(m, r), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.seq([r, ABNF.rep.any(r)]), s) == True{} : Bool}:
  (m, hle, hm) = p
  atl1E.m(k, r, s, m, hle, hm)

def atl1E(+k: ABNF.Book, +r: ABNF.Rule, +s: String, +h: {ABNF.check.era(k, ABNF.rep.at_least(1n, r), s) == True{} : Bool}) -> {ABNF.check.era(k, ABNF.seq([r, ABNF.rep.any(r)]), s) == True{} : Bool}:
